DEF FOTITO()

; INICIALIZACION CAMARA
 INPICKER_Handler.DataToSend.command=0
 INPICKER_Handler.DataToSend.GraspConfirmation=0
 WAIT FOR (INPICKER_Handler.DataReceived.state==0)

; Camara siempre 2
 INPICKER_Handler.DataToSend.CameraID=0

; contendor igual al numero de bandeja
 INPICKER_Handler.DataToSend.ContainerID=12
 INPICKER_Handler.DataToSend.partid=0
 INPICKER_Handler.DataToSend.GraspConfirmation=0
 WAIT SEC 0.2

; DISPARO FOTO
 INPICKER_Handler.DataToSend.command=1  

; ESPERA FOTO REALIZADA
 WAIT FOR (INPICKER_Handler.DataReceived.state==30) OR (INPICKER_Handler.DataReceived.state==-1)
wait sec 2
IF (INPICKER_handler.datareceived.state==-1 ) OR (INPICKER_Handler.DataReceived.ObjectsGraspable<=0) THEN
   
   ;*********************************
   ;FALLO FOTO -1, NO VE EL OBJETO
   WAIT FOR FALSE
   ;*********************************
   
ENDIF

IF (INPICKER_Handler.DataReceived.state==30) THEN

   IF FALSE THEN
      FRAME_MASTER=INPICKER_Handler.DataReceived.PartsToGrasp0.Position
   ENDIF

   FRAMEAUX=INPICKER_Handler.DataReceived.PartsToGrasp0.Position

   WAIT FOR ((ABS((FRAME_MASTER.X)-(FRAMEAUX.X)))<10) ;LIMITE EN X DENTRO DE RANGO
   WAIT FOR ((ABS((FRAME_MASTER.Y)-(FRAMEAUX.y)))<10) ;LIMITE EN Y DENTRO DE RANGO
   WAIT FOR ((ABS((FRAME_MASTER.Z)-(FRAMEAUX.z)))<10) ;LIMITE EN Z DENTRO DE RANGO
   WAIT FOR ((ABS((FRAME_MASTER.A)-(FRAMEAUX.a)))<10) ;LIMITE EN A DENTRO DE RANGO
   WAIT FOR ((ABS((FRAME_MASTER.B)-(FRAMEAUX.b)))<10) ;LIMITE EN B DENTRO DE RANGO
   WAIT FOR ((ABS((FRAME_MASTER.C)-(FRAMEAUX.c)))<10) ;LIMITE EN C DENTRO DE RANGO

ENDIF




END


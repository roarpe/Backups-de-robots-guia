&ACCESS RV1
&REL 16
&COMMENT CERRAR BANDEJAS PLC
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\Program\MAFELEC
DEF Rack_Verde_Cerrar_PLC( )
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
;FOLD SPOTTECH INI
USERSPOT(#INIT)
;ENDFOLD (SPOTTECH INI)
;FOLD GRIPPERTECH INI
USER_GRP(0,DUMMY,DUMMY,GDEFAULT)
;ENDFOLD (GRIPPERTECH INI)
  ;FOLD USER INI
INTERRUPT DECL 82 WHEN I_121R1S501 DO STOP_PUSH ()
INTERRUPT DECL 92 WHEN I_121R1S502 DO STOP_PUSH ()

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)
;################################################
; PROYECTO: MAFELEC PLANTA DE BATERIAS
; ROBOT: 121_R1
; PROGRAMA: CERRAR BANDEJAS EN RACK VERDE
; CREADO POR: Alejandro Company(zaisor robotics)
; FECHA: 23-NOVIEMBRE-2022
; MODIFICADO POR:
; FECHA MODIFICACION: 05-ENERO-2023
;################################################

; POSICION DE ESPERA ENTRADA RACK 1
;FOLD PTP POS_ESPERA_AREA1 Vel=100 % H Tool[9]:T_Gripper1_Vacio Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:POS_ESPERA_AREA1, 3:, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FPOS_ESPERA_AREA1
BAS(#PTP_PARAMS,100)
PTP XPOS_ESPERA_AREA1 
;ENDFOLD
;ESPERA AREA 1
WAIT FOR I_ARDY_1
O_AREL_1=FALSE

WAIT FOR I_121R1S1000==FALSE

;FOLD PTP P_CERRAR10 CONT Vel=100 % H Tool[1]:T_PUSH1 Base[1]:Rack_Verde;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P_CERRAR10, 3:C_DIS, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP_CERRAR10
BAS(#PTP_PARAMS,100)
PTP XP_CERRAR10 C_DIS
;ENDFOLD

INI_BUCLE:
;FOLD PTP P10 Vel=100 % H Tool[1]:T_PUSH1 Base[1]:Rack_Verde;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P10, 3:, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP10
BAS(#PTP_PARAMS,100)
PTP XP10 
;ENDFOLD

RV_Bandeja_Nr=0
O_TYPE_RQ=TRUE
WAIT FOR (I_TYPE_INFO > 10) AND (I_TYPE_INFO < 16)
RV_Bandeja_Nr=I_TYPE_INFO

Rack_Verde_Cerrar_D ()

END
DEF STOP_PUSH()
INTERRUPT OFF 82
INTERRUPT OFF 92

BRAKE
WAIT SEC 0
PTP $POS_ACT
LIN $POS_INT
$OV_PRO=OLD_OVPRO

;RESUME

END
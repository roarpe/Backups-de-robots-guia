&ACCESS RVP
&REL 223
&COMMENT COGER ST121 RACK AZUL
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\Program\MAFELEC
DEF chequeo_paleta( )
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
;FOLD SPOTTECH INI
USERSPOT(#INIT)
;ENDFOLD (SPOTTECH INI)
;FOLD GRIPPERTECH INI
USER_GRP(0,DUMMY,DUMMY,GDEFAULT)
;ENDFOLD (GRIPPERTECH INI)
;FOLD USER INI
INTERRUPT DECL 26 WHEN I_121R1S102 OR I_121R1S202 DO PARO_RAPIDO ()
INTERRUPT DECL 27 WHEN I_121R1S302 OR I_121R1S402 DO PARO_RAPIDO ()

    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)
;################################################
; PROYECTO: PLANTA DE BATERIAS
; ROBOT: 121_R1 TERMINATOR
; PROGRAMA: Chequeo_paletas EN ST121
; PALETA MASTER NUMERO 20
; CREADO POR: Borja Carrion
; FECHA: 13-JULIO-2024
;################################################

Empujador(1,"R",FALSE)
Empujador(2,"R",FALSE)

;FOLD PTP HOME Vel=100 % DEFAULT;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HOME, 3:, 5:100, 7:DEFAULT
$BWDSTART=FALSE
PDAT_ACT=PDEFAULT
FDAT_ACT=FHOME
BAS(#PTP_PARAMS,100)
$H_POS=XHOME
PTP XHOME 
;ENDFOLD
; FOLD ESPERA CONFIRMACION ENTRADA INSPECCION
WAIT FOR I_ST121_INSPECCION
; ENDFOLD

;FOLD PTP POS_ESPERA_ST121 Vel=100 % H Tool[9]:T_Gripper1_Vacio Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:POS_ESPERA_ST121, 3:, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FPOS_ESPERA_ST121
BAS(#PTP_PARAMS,100)
PTP XPOS_ESPERA_ST121 
;ENDFOLD

; FOLD ESPERA CONFIRMACION ENTRADA INSPECCION
WAIT FOR I_ST121_INSPECCION
; ENDFOLD

; FOLD CONTROL DE ELEMENTOS MECANICOS EN REPOSO
;CONTROL DE AUSENCIA DE PIEZA EN GRIPPER
IF I_121R1S1000 THEN
HALT
ENDIF

;CONTROL APERTURA GRIPPER

IF (I_121R1S131B==FALSE) OR (I_121R1S132B==FALSE) OR (I_121R1S133B==FALSE) OR (I_121R1S134B==FALSE) THEN
Pines("R")
ENDIF

Empujador(1,"R",TRUE)
Empujador(2,"R",TRUE)
; ENDFOLD

;FOLD PTP P10 CONT Vel=100 % M Tool[9]:T_Gripper1_Vacio Base[3]:ST121;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P10, 3:C_DIS, 5:100, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=FP10
BAS(#PTP_PARAMS,100)
PTP XP10 C_DIS
;ENDFOLD



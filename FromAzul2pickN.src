&ACCESS RVO
&REL 17
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF FromAzul2pickN( )
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
;FOLD SPOTTECH INI
USERSPOT(#INIT)
;ENDFOLD (SPOTTECH INI)
;FOLD GRIPPERTECH INI
USER_GRP(0,DUMMY,DUMMY,GDEFAULT)
;ENDFOLD (GRIPPERTECH INI)
  ;FOLD USER INI
    ;Make your modifications here
INTERRUPT DECL 26 WHEN I_121R1S102 OR I_121R1S202 DO PARO_RAPIDO ()
INTERRUPT DECL 27 WHEN I_121R1S302 OR I_121R1S402 DO PARO_RAPIDO ()
  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

$out[17]=false
;FOLD PTP P1 Vel=20 % PDAT1 Tool[1]:T_PUSH1 Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P1, 3:, 5:20, 7:PDAT1
$BWDSTART=FALSE
PDAT_ACT=PPDAT1
FDAT_ACT=FP1
BAS(#PTP_PARAMS,20)
PTP XP1 
;ENDFOLD
;FOLD PTP P2 Vel=20 % PDAT2 Tool[1]:T_PUSH1 Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P2, 3:, 5:20, 7:PDAT2
$BWDSTART=FALSE
PDAT_ACT=PPDAT2
FDAT_ACT=FP2
BAS(#PTP_PARAMS,20)
PTP XP2 
;ENDFOLD

; FOLD ACTIVA VIGILANCIA SOBREPASO
INTERRUPT ON 26
INTERRUPT ON 27
;ENDFOLD

;FOLD LIN P4 Vel=0.1 m/s CPDAT1 Tool[1]:T_PUSH1 Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P4, 3:, 5:0.1, 7:CPDAT1
$BWDSTART=FALSE
LDAT_ACT=LCPDAT1
FDAT_ACT=FP4
BAS(#CP_PARAMS,0.1)
LIN XP4 
;ENDFOLD

PINES("R")



;FOLD LIN P5 Vel=0.1 m/s CPDAT2 Tool[1]:T_PUSH1 Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P5, 3:, 5:0.1, 7:CPDAT2
$BWDSTART=FALSE
LDAT_ACT=LCPDAT2
FDAT_ACT=FP5
BAS(#CP_PARAMS,0.1)
LIN XP5 
;ENDFOLD

;CONTROL DE AUSENCIA DE PIEZA EN GRIPPER
;IF (I_SIMULACION==FALSE) THEN
IF I_121R1S1000 THEN
HALT
ENDIF
;ENDIF

; FOLD FIN VIGILANCIA SOBREPASO
INTERRUPT OFF 26
INTERRUPT OFF 27
;ENDFOLD


;FOLD PTP P6 Vel=20 % PDAT3 Tool[1]:T_PUSH1 Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P6, 3:, 5:20, 7:PDAT3
$BWDSTART=FALSE
PDAT_ACT=PPDAT3
FDAT_ACT=FP6
BAS(#PTP_PARAMS,20)
PTP XP6 
;ENDFOLD
;FOLD PTP P7 Vel=20 % PDAT4 Tool[1]:T_PUSH1 Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P7, 3:, 5:20, 7:PDAT4
$BWDSTART=FALSE
PDAT_ACT=PPDAT4
FDAT_ACT=FP7
BAS(#PTP_PARAMS,20)
PTP XP7 
;ENDFOLD


;FOLD PTP HOME  Vel= 100 % DEFAULT;%{PE}%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HOME, 3:, 5:100, 7:DEFAULT
$BWDSTART = FALSE
PDAT_ACT=PDEFAULT
FDAT_ACT=FHOME
BAS (#PTP_PARAMS,100 )
$H_POS=XHOME
PTP  XHOME
;ENDFOLD

;SETA DE BOMBEROS PULADA RESETAR PROGRAMA
WAIT FOR FALSE
WAIT FOR FALSE
WAIT FOR FALSE
;SETA DE BOMBEROS PULADA RESETAR PROGRAMA



END

DEF PARO_RAPIDO ()
BRAKE F
END


&ACCESS RVO1
&REL 3149
&COMMENT DEJAR BAT EN RACK AZUL
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\Program\MAFELEC
DEF Rack_Azul_Dejar( )
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
;FOLD SPOTTECH INI
USERSPOT(#INIT)
;ENDFOLD (SPOTTECH INI)
;FOLD GRIPPERTECH INI
USER_GRP(0,DUMMY,DUMMY,GDEFAULT)
;ENDFOLD (GRIPPERTECH INI)
;FOLD USER INI
INTERRUPT DECL 26 WHEN I_121R1S102 OR I_121R1S202 DO PARO_RAPIDO ()
INTERRUPT DECL 27 WHEN I_121R1S302 OR I_121R1S402 DO PARO_RAPIDO ()
    ;Make your modifications here
O_TYPE_INFO=0
SELECT_T1=FALSE

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)
;################################################
; PROYECTO: MAFELEC PLANTA DE BATERIAS
; ROBOT: 121_R1
; PROGRAMA: DESCARGA DE BATERIA EN RACK AZUL
; CREADO POR: Mike Tyson(zaisor robotics)
; FECHA: 23-NOVIEMBRE-2022
; MODIFICADO POR:
; FECHA MODIFICACION: 17-ENERO-2023
;################################################

; FOLD CARGA VALORES DE POSICION
IF FRAME_POS.A < 180.0 THEN
FRAME_POS.A = FRAME_POS.A + 360
ENDIF
IF FRAME_POS.B < 180.0 THEN
FRAME_POS.B = FRAME_POS.B + 360
ENDIF
IF FRAME_POS.C < 180.0 THEN
FRAME_POS.C = FRAME_POS.C + 360
ENDIF

IF FRAME_POS.A > 180.0 THEN
FRAME_POS.A = FRAME_POS.A - 360
ENDIF
IF FRAME_POS.B > 180.0 THEN
FRAME_POS.B = FRAME_POS.B - 360
ENDIF
IF FRAME_POS.C > 180.0 THEN
FRAME_POS.C = FRAME_POS.C - 360
ENDIF

XP_DEJAR_AZUL=FRAME_POS
XP_DEJAR_AZUL.z=FRAME_POS.z+3
XP_DROP_1=XP_DEJAR_AZUL
XP_DROP_2=XP_DEJAR_AZUL
XP_DROP_3=XP_DEJAR_AZUL
XP_DROP_4=XP_DEJAR_AZUL
XP_DROP_5=XP_DEJAR_AZUL

XP_DROP_1.z=XP_DROP_1.z + 80
XP_DROP_2.z=XP_DROP_2.z + 80
XP_DROP_3.z=XP_DROP_3.z + 80
XP_DROP_4.z=XP_DROP_4.z + 80
XP_DROP_5.z=XP_DROP_5.z + 80
;ENDFOLD

;FOLD PTP POS_ESPERA_RACK_AZUL Vel=100 % H Tool[11]:T_Gripper1_Carga Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:POS_ESPERA_RACK_AZUL, 3:, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FPOS_ESPERA_RACK_AZUL
BAS(#PTP_PARAMS,100)
PTP XPOS_ESPERA_RACK_AZUL 
;ENDFOLD

;ESPERA AREA 2
WAIT FOR I_ARDY_2
O_AREL_2=FALSE

Empujador(1,"R",TRUE)
Empujador(2,"R",TRUE)

;FOLD PTP P20 CONT Vel=100 % M Tool[11]:T_Gripper1_Carga Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P20, 3:C_DIS, 5:100, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=FP20
BAS(#PTP_PARAMS,100)
PTP XP20 C_DIS
;ENDFOLD

;FOLD PTP P30 CONT Vel=100 % M Tool[11]:T_Gripper1_Carga Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P30, 3:C_DIS, 5:100, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=FP30
BAS(#PTP_PARAMS,100)
PTP XP30 C_DIS
;ENDFOLD
;FOLD PTP P40 CONT Vel=100 % M Tool[11]:T_Gripper1_Carga Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P40, 3:C_DIS, 5:100, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=FP40
BAS(#PTP_PARAMS,100)
PTP XP40 C_DIS
;ENDFOLD
;FOLD PTP P50 CONT Vel=100 % M Tool[11]:T_Gripper1_Carga Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P50, 3:C_DIS, 5:100, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=FP50
BAS(#PTP_PARAMS,100)
PTP XP50 C_DIS
;ENDFOLD
;FOLD PTP P60 CONT Vel=100 % L Tool[11]:T_Gripper1_Carga Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P60, 3:C_DIS, 5:100, 7:L
$BWDSTART=FALSE
PDAT_ACT=PL
FDAT_ACT=FP60
BAS(#PTP_PARAMS,100)
PTP XP60 C_DIS
;ENDFOLD

; POSICION DE ESPERA A DEJAR BATERIA EN RACK AZUL
;FOLD PTP P_Espera_Dejar_Rack_A Vel=50 % L Tool[11]:T_Gripper1_Carga Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P_Espera_Dejar_Rack_A, 3:, 5:50, 7:L
$BWDSTART=FALSE
PDAT_ACT=PL
FDAT_ACT=FP_Espera_Dejar_Rack_A
BAS(#PTP_PARAMS,50)
PTP XP_Espera_Dejar_Rack_A 
;ENDFOLD

; FOLD ACTIVA VIGILANCIA SOBREPASO
;INTERRUPT ON 26
;INTERRUPT ON 27
;ENDFOLD

;CONTROL DE AUSENCIA DE PIEZA EN GRIPPER
IF (I_SIMULACION==FALSE) THEN
IF NOT I_121R1S1000 THEN
HALT
ENDIF
ENDIF

;FOLD CONTROL APERTURA GRIPPER
IF (I_121R1S131A==FALSE) OR (I_121R1S132A==FALSE) OR (I_121R1S133A==FALSE) OR (I_121R1S134A==FALSE) THEN
HALT
ENDIF
;ENDFOLD

IF PGNO==21 THEN
O_TYPE_RQ=TRUE
WAIT FOR (I_TYPE_INFO>20) AND (I_TYPE_INFO<26)
RA_Bandeja_Nr=I_TYPE_INFO
O_TYPE_RQ=FALSE
ENDIF

WAIT FOR (RA_Bandeja_Nr>20) AND (RA_Bandeja_Nr<26)

SWITCH RA_Bandeja_Nr ; 


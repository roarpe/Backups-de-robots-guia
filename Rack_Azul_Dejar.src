LIN XP_aDescarga5_10 C_DIS C_DIS
;ENDFOLD
;FOLD LIN P_aDescarga5_20 CONT Vel=0.5 m/s L Tool[11]:T_Gripper1_Carga Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P_aDescarga5_20, 3:C_DIS C_DIS, 5:0.5, 7:L
$BWDSTART=FALSE
LDAT_ACT=LL
FDAT_ACT=FP_aDescarga5_20
BAS(#CP_PARAMS,0.5)
LIN XP_aDescarga5_20 C_DIS C_DIS
;ENDFOLD

IF (O_INPICKER_OK==TRUE) AND (O_INPICKER_NOK==FALSE) AND (O_LIMITS_OK==TRUE) AND (O_LIMITS_NOK==FALSE) THEN

; #### MOVIMIENTOS A DESCARGA CONTROLADOS POR ####
; #### LA CAMARA DE VISION                    ####                 

;FOLD LIN P_DROP_5 Vel=0.3 m/s L Tool[11]:T_Gripper1_Carga Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P_DROP_5, 3:, 5:0.3, 7:L
$BWDSTART=FALSE
LDAT_ACT=LL
FDAT_ACT=FP_DROP_5
BAS(#CP_PARAMS,0.3)
LIN XP_DROP_5 
;ENDFOLD
;FOLD LIN P_DEJAR_AZUL Vel=0.1 m/s L Tool[11]:T_Gripper1_Carga Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P_DEJAR_AZUL, 3:, 5:0.1, 7:L
$BWDSTART=FALSE
LDAT_ACT=LL
FDAT_ACT=FP_DEJAR_AZUL
BAS(#CP_PARAMS,0.1)
LIN XP_DEJAR_AZUL 
;ENDFOLD

ELSE
; #### MOVIMIENTOS A DESCARGA CONTROLADOS POR ####
; #### EL OPERARIO                            ####                 
;FOLD ESPERA LLAVE SELECTORA EN MODO T1
WAIT FOR $T1
SELECT_T1=TRUE
;ENDFOLD
;FOLD LIN P_aDescarga5_30 CONT Vel=0.2 m/s L Tool[11]:T_Gripper1_Carga Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P_aDescarga5_30, 3:C_DIS C_DIS, 5:0.2, 7:L
$BWDSTART=FALSE
LDAT_ACT=LL
FDAT_ACT=FP_aDescarga5_30
BAS(#CP_PARAMS,0.2)
LIN XP_aDescarga5_30 C_DIS C_DIS
;ENDFOLD

;POSICION DE DESCARGA 5
;CUIDADO CON EL LINEAL NO EJECUTARLO HASTA EL FINAL 
;POSIBILIDAD DE COLISION
;EN ESTE PUNTO LLEVAR EL ROBOT HASTA LA DESCARGA DE BANDEJA
;UNA VEZ TENEMOS EL ROBOT YA EN LA POSICION DE DEJADA TENEMOS
;QUE ACTIVAR LAS SALIDAS DE LAS CLAMPAS PARA DEJAR LA BATERIA
;SALIDA 246 O_121R1Y13A PINES BLOQUEO ADELANTE ESTARA EN 1 PONERLA A 0
;SEGUIDAMENTE LA SALIDA 245 O_121R1Y13B PINES BLOQUEO ATRAS ESTARA A 0 PONERLA A 1
;AL ABRIR LOS PINES DE LAS CLAMPAS EL SIGUIENTE PASO ES SELECCIONAR LA LINEA 
;ENDIF Y CONTINUAR PROGRAMA
;FOLD LIN Rack_Azul_Pos5 Vel=0.2 m/s L Tool[11]:T_Gripper1_Carga Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:Rack_Azul_Pos5, 3:, 5:0.2, 7:L
$BWDSTART=FALSE
LDAT_ACT=LL
FDAT_ACT=FRack_Azul_Pos5
BAS(#CP_PARAMS,0.2)
LIN XRack_Azul_Pos5 
;ENDFOLD
ENDIF

DEFAULT

HALT
HALT
; #### CODIGO DE DESCARGA ERRONEO ####
HALT
BRAKE
ENDSWITCH

; FOLD MOVIMIENTOS DE SALIDA RACK AZUL
INI_DROP:
GIRO_A_P=FALSE
GIRO_A_N=FALSE
GIRO_B_P=FALSE
GIRO_B_N=FALSE
GIRO_C_P=FALSE
GIRO_C_N=FALSE
PTP $POS_ACT

IF (I_SIMULACION==FALSE) THEN

Repite=0

WHILE (I_121R1S102==TRUE) OR (I_121R1S202==TRUE) OR (I_121R1S302==TRUE) OR (I_121R1S402==TRUE) 

Repite=Repite+1
LIN_REL{Z +1}
WAIT SEC 0.1

IF Repite>=3 THEN
HALT
; SUPERADO NUMERO DE REPETICIONES
HALT
ENDIF

ENDWHILE

Repite=0

WHILE (I_121R1S101==FALSE) AND (I_121R1S201==FALSE) AND (I_121R1S301==FALSE) AND (I_121R1S401==FALSE) 
IF (I_121R1S102==TRUE) OR (I_121R1S202==TRUE) OR (I_121R1S302==TRUE) OR (I_121R1S402==TRUE) THEN
HALT
HALT
HALT
ENDIF
Repite=Repite+1
LIN_REL{Z -1}
WAIT SEC 0.1

IF Repite>=8 THEN
HALT
; SUPERADO NUMERO DE REPETICIONES
HALT
ENDIF

ENDWHILE

; #### CONTROL DE PRESENCIA PARA ABRIR ####
WAIT FOR (I_121R1S101==TRUE) OR (I_121R1S301==TRUE) OR (I_121R1S201==TRUE) OR (I_121R1S401==TRUE)

fin_dejar:
ENDIF

O_INPICKER_OK=FALSE
O_INPICKER_NOK=FALSE
O_LIMITS_OK=FALSE
O_LIMITS_NOK=FALSE
O_LIMIT_X=FALSE
O_LIMIT_Y=FALSE
O_LIMIT_Z=FALSE
O_LIMIT_A=FALSE
O_LIMIT_B=FALSE
O_LIMIT_C=FALSE

PTP $POS_ACT
Pines("R")

PTP $POS_ACT
WAIT FOR $EXT; CAMBIAR LA LLAVE A MODO EXT

LIN_REL{Z +80}
O_JRDY_6 = TRUE
BAS(#CP_PARAMS,1.5)

; #### CONTROL DE AUSENCIA DE BATERIA ####
WAIT FOR NOT I_121R1S1000

LIN_REL{Y -300,Z +100} C_DIS
LIN_REL{Y -400,Z +350}
; ENDFOLD
; FOLD FIN VIGILANCIA SOBREPASO
INTERRUPT OFF 26
INTERRUPT OFF 27
;ENDFOLD

;FOLD LIN P_SALIDA_RackAzul Vel=0.5 m/s M Tool[9]:T_Gripper1_Vacio Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P_SALIDA_RackAzul, 3:, 5:0.5, 7:M
$BWDSTART=FALSE
LDAT_ACT=LM
FDAT_ACT=FP_SALIDA_RackAzul
BAS(#CP_PARAMS,0.5)
LIN XP_SALIDA_RackAzul 
;ENDFOLD



Rack_Azul_Cerrar_D()

;TRABAJO REALIZADO
O_JRDY_7 = TRUE

END

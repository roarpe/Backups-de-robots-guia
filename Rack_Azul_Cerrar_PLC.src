&ACCESS RVO1
&REL 14
&COMMENT CERRAR BANDEJAS PLC
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\Program\MAFELEC
DEF Rack_Azul_Cerrar_PLC( )
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
;FOLD SPOTTECH INI
USERSPOT(#INIT)
;ENDFOLD (SPOTTECH INI)
;FOLD GRIPPERTECH INI
USER_GRP(0,DUMMY,DUMMY,GDEFAULT)
;ENDFOLD (GRIPPERTECH INI)
  ;FOLD USER INI
    ;Make your modifications here
INTERRUPT DECL 82 WHEN I_121R1S501 DO STOP_PUSH ()
INTERRUPT DECL 92 WHEN I_121R1S501 DO STOP_PUSH ()

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)
;################################################
; PROYECTO: MAFELEC PLANTA DE BATERIAS
; ROBOT: 121_R1
; PROGRAMA: CERRAR BANDEJAS EN RACK AZUL
; CREADO POR: Alejandro Company(zaisor robotics)
; FECHA: 23-NOVIEMBRE-2022
; MODIFICADO POR:
; FECHA MODIFICACION: 05-ENERO-2023
;################################################

;FOLD PTP HOME Vel=100 % PDAT1;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HOME, 3:, 5:100, 7:PDAT1
$BWDSTART=FALSE
PDAT_ACT=PPDAT1
FDAT_ACT=FHOME
BAS(#PTP_PARAMS,100)
$H_POS=XHOME
PTP XHOME 
;ENDFOLD
; POSICION DE ESPERA ENTRADA RACK 2 (AZUL)
;FOLD PTP POS_ESPERA_AREA2 Vel=50 % H Tool[9]:T_Gripper1_Vacio Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:POS_ESPERA_AREA2, 3:, 5:50, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FPOS_ESPERA_AREA2
BAS(#PTP_PARAMS,50)
PTP XPOS_ESPERA_AREA2 
;ENDFOLD
;ESPERA AREA 2
WAIT FOR I_ARDY_2
O_AREL_2=FALSE

WAIT FOR I_121R1S1000==FALSE

;FOLD PTP P_CERRAR10 CONT Vel=50 % H Tool[2]:T_PUSH2 Base[2]:Rack_Azul;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P_CERRAR10, 3:C_DIS, 5:50, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP_CERRAR10
BAS(#PTP_PARAMS,50)
PTP XP_CERRAR10 C_DIS
;ENDFOLD

INI_BUCLE:
;FOLD PTP P10 Vel=50 % H Tool[2]:T_PUSH2 Base[2]:Rack_Azul;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P10, 3:, 5:50, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP10
BAS(#PTP_PARAMS,50)
PTP XP10 
;ENDFOLD

RA_Bandeja_Nr=0
O_TYPE_RQ=TRUE
WAIT FOR (I_TYPE_INFO > 20) AND (I_TYPE_INFO < 26)
RA_Bandeja_Nr=I_TYPE_INFO

Rack_Azul_Cerrar_D ()

END
DEF STOP_PUSH()
INTERRUPT OFF 82
INTERRUPT OFF 92

BRAKE
WAIT SEC 0
PTP $POS_ACT
LIN $POS_INT
$OV_PRO=OLD_OVPRO

;RESUME

END
&ACCESS RVP1
&REL 14
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF FromVerde2pickI( )
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
;FOLD SPOTTECH INI
USERSPOT(#INIT)
;ENDFOLD (SPOTTECH INI)
;FOLD GRIPPERTECH INI
USER_GRP(0,DUMMY,DUMMY,GDEFAULT)
;ENDFOLD (GRIPPERTECH INI)
  ;FOLD USER INI
    ;Make your modifications here
INTERRUPT DECL 26 WHEN I_121R1S102 OR I_121R1S202 DO PARO_RAPIDO ()
INTERRUPT DECL 27 WHEN I_121R1S302 OR I_121R1S402 DO PARO_RAPIDO ()
  ;ENDFOLD (USER INI)
;ENDFOLD (INI)
$out[17]=false
;FOLD PTP WAIT_VERDE Vel=20 % PDAT1 Tool[1]:T_PUSH1 Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:WAIT_VERDE, 3:, 5:20, 7:PDAT1
$BWDSTART=FALSE
PDAT_ACT=PPDAT1
FDAT_ACT=FWAIT_VERDE
BAS(#PTP_PARAMS,20)
PTP XWAIT_VERDE 
;ENDFOLD
;FOLD PTP P10 Vel=20 % PDAT2 Tool[1]:T_PUSH1 Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P10, 3:, 5:20, 7:PDAT2
$BWDSTART=FALSE
PDAT_ACT=PPDAT2
FDAT_ACT=FP10
BAS(#PTP_PARAMS,20)
PTP XP10 
;ENDFOLD
;FOLD PTP P11 Vel=20 % PDAT3 Tool[1]:T_PUSH1 Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P11, 3:, 5:20, 7:PDAT3
$BWDSTART=FALSE
PDAT_ACT=PPDAT3
FDAT_ACT=FP11
BAS(#PTP_PARAMS,20)
PTP XP11 
;ENDFOLD

; FOLD ACTIVA VIGILANCIA SOBREPASO
INTERRUPT ON 26
INTERRUPT ON 27
;ENDFOLD

;FOLD LIN P12 Vel=0.1 m/s CPDAT1 Tool[1]:T_PUSH1 Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P12, 3:, 5:0.1, 7:CPDAT1
$BWDSTART=FALSE
LDAT_ACT=LCPDAT1
FDAT_ACT=FP12
BAS(#CP_PARAMS,0.1)
LIN XP12 
;ENDFOLD

PINES("R")


;FOLD LIN P13 Vel=0.1 m/s CPDAT2 Tool[1]:T_PUSH1 Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P13, 3:, 5:0.1, 7:CPDAT2
$BWDSTART=FALSE
LDAT_ACT=LCPDAT2
FDAT_ACT=FP13
BAS(#CP_PARAMS,0.1)
LIN XP13 
;ENDFOLD

;CONTROL DE AUSENCIA DE PIEZA EN GRIPPER
;IF (I_SIMULACION==FALSE) THEN
IF I_121R1S1000 THEN
HALT
ENDIF
;ENDIF

; FOLD FIN VIGILANCIA SOBREPASO
INTERRUPT OFF 26
INTERRUPT OFF 27
;ENDFOLD


;FOLD PTP P14 Vel=20 % PDAT5 Tool[1]:T_PUSH1 Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P14, 3:, 5:20, 7:PDAT5
$BWDSTART=FALSE
PDAT_ACT=PPDAT5
FDAT_ACT=FP14
BAS(#PTP_PARAMS,20)
PTP XP14 
;ENDFOLD
;FOLD PTP P15 Vel=20 % PDAT6 Tool[1]:T_PUSH1 Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P15, 3:, 5:20, 7:PDAT6
$BWDSTART=FALSE
PDAT_ACT=PPDAT6
FDAT_ACT=FP15
BAS(#PTP_PARAMS,20)
PTP XP15 
;ENDFOLD
;FOLD PTP HOME Vel=20 % PDAT7;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HOME, 3:, 5:20, 7:PDAT7
$BWDSTART=FALSE
PDAT_ACT=PPDAT7
FDAT_ACT=FHOME
BAS(#PTP_PARAMS,20)
$H_POS=XHOME
PTP XHOME 
;ENDFOLD

;SETA DE BOMBEROS PULADA RESETAR PROGRAMA
WAIT FOR FALSE
WAIT FOR FALSE
WAIT FOR FALSE
;SETA DE BOMBEROS PULADA RESETAR PROGRAMA



END

DEF PARO_RAPIDO ()
BRAKE F
END


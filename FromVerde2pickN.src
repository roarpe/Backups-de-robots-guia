&ACCESS RVP1
&REL 19
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF FromVerde2pickN( )
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
;FOLD SPOTTECH INI
USERSPOT(#INIT)
;ENDFOLD (SPOTTECH INI)
;FOLD GRIPPERTECH INI
USER_GRP(0,DUMMY,DUMMY,GDEFAULT)
;ENDFOLD (GRIPPERTECH INI)
  ;FOLD USER INI
    ;Make your modifications here
INTERRUPT DECL 26 WHEN I_121R1S102 OR I_121R1S202 DO PARO_RAPIDO ()
INTERRUPT DECL 27 WHEN I_121R1S302 OR I_121R1S402 DO PARO_RAPIDO ()
  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

$out[17]=false
;FOLD PTP WAIT_VERDE Vel=20 % PDAT1 Tool[1]:T_PUSH1 Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:WAIT_VERDE, 3:, 5:20, 7:PDAT1
$BWDSTART=FALSE
PDAT_ACT=PPDAT1
FDAT_ACT=FWAIT_VERDE
BAS(#PTP_PARAMS,20)
PTP XWAIT_VERDE 
;ENDFOLD
;FOLD PTP P1 Vel=20 % PDAT2 Tool[1]:T_PUSH1 Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P1, 3:, 5:20, 7:PDAT2
$BWDSTART=FALSE
PDAT_ACT=PPDAT2
FDAT_ACT=FP1
BAS(#PTP_PARAMS,20)
PTP XP1 
;ENDFOLD
;FOLD LIN P2 Vel=0.1 m/s CPDAT1 Tool[1]:T_PUSH1 Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P2, 3:, 5:0.1, 7:CPDAT1
$BWDSTART=FALSE
LDAT_ACT=LCPDAT1
FDAT_ACT=FP2
BAS(#CP_PARAMS,0.1)
LIN XP2 
;ENDFOLD

; FOLD ACTIVA VIGILANCIA SOBREPASO
INTERRUPT ON 26
INTERRUPT ON 27
;ENDFOLD

;FOLD LIN P3_dejada Vel=0.1 m/s CPDAT3 Tool[1]:T_PUSH1 Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P3_dejada, 3:, 5:0.1, 7:CPDAT3
$BWDSTART=FALSE
LDAT_ACT=LCPDAT3
FDAT_ACT=FP3_dejada
BAS(#CP_PARAMS,0.1)
LIN XP3_dejada 
;ENDFOLD


PINES("R")


;FOLD LIN P4 Vel=0.1 m/s CPDAT2 Tool[1]:T_PUSH1 Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P4, 3:, 5:0.1, 7:CPDAT2
$BWDSTART=FALSE
LDAT_ACT=LCPDAT2
FDAT_ACT=FP4
BAS(#CP_PARAMS,0.1)
LIN XP4 
;ENDFOLD

;CONTROL DE AUSENCIA DE PIEZA EN GRIPPER
;IF (I_SIMULACION==FALSE) THEN
IF I_121R1S1000 THEN
HALT
ENDIF
;ENDIF

; FOLD FIN VIGILANCIA SOBREPASO
INTERRUPT OFF 26
INTERRUPT OFF 27
;ENDFOLD


;FOLD PTP P5 Vel=20 % PDAT5 Tool[1]:T_PUSH1 Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P5, 3:, 5:20, 7:PDAT5
$BWDSTART=FALSE
PDAT_ACT=PPDAT5
FDAT_ACT=FP5
BAS(#PTP_PARAMS,20)
PTP XP5 
;ENDFOLD


;FOLD PTP P6 Vel=20 % PDAT6 Tool[1]:T_PUSH1 Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P6, 3:, 5:20, 7:PDAT6
$BWDSTART=FALSE
PDAT_ACT=PPDAT6
FDAT_ACT=FP6
BAS(#PTP_PARAMS,20)
PTP XP6 
;ENDFOLD
;FOLD PTP HOME Vel=20 % PDAT7;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HOME, 3:, 5:20, 7:PDAT7
$BWDSTART=FALSE
PDAT_ACT=PPDAT7
FDAT_ACT=FHOME
BAS(#PTP_PARAMS,20)
$H_POS=XHOME
PTP XHOME 
;ENDFOLD

;SETA DE BOMBEROS PULADA RESETAR PROGRAMA
WAIT FOR FALSE
WAIT FOR FALSE
WAIT FOR FALSE
;SETA DE BOMBEROS PULADA RESETAR PROGRAMA



END

DEF PARO_RAPIDO ()
BRAKE F
END


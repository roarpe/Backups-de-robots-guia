PDAT_ACT=PPDAT17
FDAT_ACT=FP2
BAS(#PTP_PARAMS,100)
PTP XP2 C_DIS
;ENDFOLD
;FOLD PTP p45 CONT Vel=100 % PDAT15 Tool[5] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p45, 3:C_DIS, 5:100, 7:PDAT15

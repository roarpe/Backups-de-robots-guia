&ACCESS RVP
&REL 175
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\Program\Sevice Programs
DEF Gripper_check( )
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
;FOLD SPOTTECH INI
USERSPOT(#INIT)
;ENDFOLD (SPOTTECH INI)
;FOLD GRIPPERTECH INI
USER_GRP(0,DUMMY,DUMMY,GDEFAULT)
;ENDFOLD (GRIPPERTECH INI)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

;FOLD PTP HOME  Vel= 100 % DEFAULT;%{PE}%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HOME, 3:, 5:100, 7:DEFAULT
$BWDSTART = FALSE
PDAT_ACT=PDEFAULT
FDAT_ACT=FHOME
BAS (#PTP_PARAMS,100 )
$H_POS=XHOME
PTP  XHOME
;ENDFOLD

;FOLD PTP P85 Vel=100 % H Tool[5] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P85, 3:, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP85
BAS(#PTP_PARAMS,100)
PTP XP85 
;ENDFOLD
;FOLD PTP P50 Vel=100 % H Tool[5] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P50, 3:, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP50
BAS(#PTP_PARAMS,100)
PTP XP50 
;ENDFOLD

;FOLD WAIT FOR ( IN 246 'Grps: bat reposo' ) CONT;%{PE}%R 8.3.48 %MKUKATPBASIS %CEXT_WAIT_FOR %VEXT_WAIT_FOR,%P 2:, 4:, 5:$IN, 6:246, 7:Grps: bat reposo, 9:CONTINUE
CONTINUE
WAIT FOR  ( $IN[246] ) 
;ENDFOLD
;FOLD WAIT FOR ( IN 248 'Grps: bat reposo' ) CONT;%{PE}%R 8.3.48 %MKUKATPBASIS %CEXT_WAIT_FOR %VEXT_WAIT_FOR,%P 2:, 4:, 5:$IN, 6:248, 7:Grps: bat reposo, 9:CONTINUE
CONTINUE
WAIT FOR  ( $IN[248] ) 
;ENDFOLD

;FOLD LIN P52 Vel=0.1 m/s M Tool[5] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P52, 3:, 5:0.1, 7:M
$BWDSTART=FALSE
LDAT_ACT=LM
FDAT_ACT=FP52
BAS(#CP_PARAMS,0.1)
LIN XP52 
;ENDFOLD

;Pos Galga
;FOLD LIN P60 Vel=0.01 m/s L Tool[5] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P60, 3:, 5:0.01, 7:L
$BWDSTART=FALSE
LDAT_ACT=LL
FDAT_ACT=FP60
BAS(#CP_PARAMS,0.01)
LIN XP60 
;ENDFOLD
HALT

;Cierra pinchos
;FOLD OUT 243 'cil bat reposo' State=FALSE ;%{PE}%R 8.3.48,%MKUKATPBASIS,%COUT,%VOUTX,%P 2:243, 3:cil bat reposo, 5:FALSE, 6:
$OUT[243]=FALSE
;ENDFOLD
;FOLD OUT 244 'cil bat activo' State=TRUE ;%{PE}%R 8.3.48,%MKUKATPBASIS,%COUT,%VOUTX,%P 2:244, 3:cil bat activo, 5:TRUE, 6:
$OUT[244]=TRUE
;ENDFOLD
;FOLD WAIT FOR ( IN 245 'Grps: bat activo' );%{PE}%R 8.3.48 %MKUKATPBASIS %CEXT_WAIT_FOR %VEXT_WAIT_FOR,%P 2:, 4:, 5:$IN, 6:245, 7:Grps: bat activo, 9:
WAIT FOR  ( $IN[245] ) 
;ENDFOLD
;FOLD WAIT FOR ( IN 247 'Grps: baterias activo' );%{PE}%R 8.3.48 %MKUKATPBASIS %CEXT_WAIT_FOR %VEXT_WAIT_FOR,%P 2:, 4:, 5:$IN, 6:247, 7:Grps: baterias activo, 9:
WAIT FOR  ( $IN[247] ) 
;ENDFOLD
HALT

;aBRE pinchos
;FOLD OUT 244 'cil bat activo' State=FALSE ;%{PE}%R 8.3.48,%MKUKATPBASIS,%COUT,%VOUTX,%P 2:244, 3:cil bat activo, 5:FALSE, 6:
$OUT[244]=FALSE
;ENDFOLD
;FOLD OUT 243 'cil bat reposo' State=TRUE ;%{PE}%R 8.3.48,%MKUKATPBASIS,%COUT,%VOUTX,%P 2:243, 3:cil bat reposo, 5:TRUE, 6:
$OUT[243]=TRUE
;ENDFOLD
;FOLD WAIT FOR ( IN 246 'Grps: bat reposo' AND IN 248 'Grps: bat reposo' );%{PE}%R 8.3.48 %MKUKATPBASIS %CEXT_WAIT_FOR %VEXT_WAIT_FOR,%P 2:, 4:, 5:$IN, 6:246, 7:Grps: bat reposo, 8:AND, 9:, 10:$IN, 11:248, 12:Grps: bat reposo, 14:
WAIT FOR  ( $IN[246] AND $IN[248] ) 
;ENDFOLD
;FOLD WAIT Time=1 sec;%{PE}%R 8.3.48,%MKUKATPBASIS,%CWAIT,%VWAIT,%P 3:1
WAIT SEC 1
;ENDFOLD

;Retirada
;FOLD LIN P55 CONT Vel=2 m/s M Tool[5] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P55, 3:C_DIS C_DIS, 5:2, 7:M
$BWDSTART=FALSE
LDAT_ACT=LM
FDAT_ACT=FP55
BAS(#CP_PARAMS,2)
LIN XP55 C_DIS C_DIS
;ENDFOLD
;FOLD PTP P54 Vel=100 % H Tool[5] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P54, 3:, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP54
BAS(#PTP_PARAMS,100)
PTP XP54 
;ENDFOLD
;FOLD PTP P53 Vel=100 % H Tool[5] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P53, 3:, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP53
BAS(#PTP_PARAMS,100)
PTP XP53 
;ENDFOLD
HALT

;FOLD PTP HOME  Vel= 100 % DEFAULT;%{PE}%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HOME, 3:, 5:100, 7:DEFAULT
$BWDSTART = FALSE
PDAT_ACT=PDEFAULT
FDAT_ACT=FHOME
BAS (#PTP_PARAMS,100 )
$H_POS=XHOME
PTP  XHOME
;ENDFOLD
END

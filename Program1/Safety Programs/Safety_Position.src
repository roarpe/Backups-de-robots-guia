&ACCESS RVP8
&REL 86
&COMMENT Safety Position
&PARAM DISKPATH = KRC:\R1\Program\Safety Programs
DEF SAFETY_POSITION(DIRECTION :IN,AREA_NR :IN,TYPE_NR :IN )
;FOLD INI
  INT DIRECTION
  INT AREA_NR
  INT TYPE_NR
  decl KrlMsg_T msg
  decl KrlMsgPar_T par[3]
  decl KrlMsgOpt_T opt
  INT nHandle
  
  IF (DIRECTION>2) OR (DIRECTION<1) THEN
    REPEAT
      msg = {modul[] "Safety Position", nr 1, msg_txt[] "Direction Number Not Valid"}

			opt = {vl_stop true, clear_p_reset true, clear_p_SAW false, log_to_DB false}

			nHandle = Set_KrlMsg(#notify, msg, par[], opt)
      HALT
    UNTIL (DIRECTION<3) AND (DIRECTION>0)
  ENDIF
  IF (AREA_NR>8) OR (AREA_NR<1) THEN
    REPEAT
      msg = {modul[] "Safety Position", nr 2, msg_txt[] "Area Number Not Valid"}

			opt = {vl_stop true, clear_p_reset true, clear_p_SAW false, log_to_DB false}

			nHandle = Set_KrlMsg(#notify, msg, par[], opt)
      HALT
    UNTIL (AREA_NR<9) AND (AREA_NR>0)
  ENDIF
  IF (TYPE_NR>8) OR (TYPE_NR<1) THEN
    REPEAT
  	  msg = {modul[] "Safety Position", nr 1, msg_txt[] "Type Number Not Valid"}

			opt = {vl_stop true, clear_p_reset true, clear_p_SAW false, log_to_DB false}

			nHandle = Set_KrlMsg(#notify, msg, par[], opt)
      HALT
    UNTIL (TYPE_NR<9) AND (TYPE_NR>0)
  ENDIF
  ;ENDFOLD

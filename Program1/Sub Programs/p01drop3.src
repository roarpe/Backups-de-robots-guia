&ACCESS RVO1
&REL 35
&COMMENT drop carton
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\Program\Sub Programs
DEF P01drop3( )
;FOLD INI
  ;FOLD BASISTECH INI

    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
;ENDFOLD (INI)
;================================================
; MODEL    : XXXX
; IE GROUP : XX
; STATION  : XXX
; ROBOT    : RX
; FUNCTION : pick Part in StXX
;================================================

;wait point

;FOLD PTP P3 CONT Vel=100 % PDAT8 Tool[5] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P3, 3:C_DIS, 5:100, 7:PDAT8
$BWDSTART=FALSE
PDAT_ACT=PPDAT8
FDAT_ACT=FP3
BAS(#PTP_PARAMS,100)
PTP XP3 C_DIS
;ENDFOLD

SWITCH POS_CARTON

CASE 11
RACK11()

CASE 12
RACK12()

CASE 13
RACK13()

CASE 14
RACK14()

CASE 21
RACK21()

CASE 22
RACK22()

CASE 23
RACK23()

CASE 24
RACK24()

ENDSWITCH

;FOLD SYN OUT 241 'CIL ventosas BWD' State=TRUE at START Delay=0 ms;%{PE}%R 8.3.48,%MKUKATPBASIS,%COUT,%VSYNOUT,%P 2:241, 3:CIL ventosas BWD, 5:TRUE, 7:0, 9:0, 12:0
TRIGGER WHEN DISTANCE=0 DELAY=0 DO $OUT[241]=TRUE
;ENDFOLD
;FOLD SYN OUT 242 'CIL Ventosas FWD' State=FALSE at START Delay=0 ms;%{PE}%R 8.3.48,%MKUKATPBASIS,%COUT,%VSYNOUT,%P 2:242, 3:CIL Ventosas FWD, 5:FALSE, 7:0, 9:0, 12:0
TRIGGER WHEN DISTANCE=0 DELAY=0 DO $OUT[242]=FALSE
;ENDFOLD

end
DEF RACK11()


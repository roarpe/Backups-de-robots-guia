&ACCESS RVO1
&REL 186
&COMMENT drop carton
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\Program\Sub Programs
DEF P01drop2( )
;FOLD INI
  ;FOLD BASISTECH INI

    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
;ENDFOLD (INI)
;================================================
; MODEL    : XXXX
; IE GROUP : XX
; STATION  : XXX
; ROBOT    : RX
; FUNCTION : pick Part in StXX
;================================================

;wait point

;FOLD PTP P3 CONT Vel=100 % PDAT8 Tool[5] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P3, 3:C_DIS, 5:100, 7:PDAT8
$BWDSTART=FALSE
PDAT_ACT=PPDAT8
FDAT_ACT=FP3
BAS(#PTP_PARAMS,100)
PTP XP3 C_DIS
;ENDFOLD

SWITCH POS_CARTON

CASE 1
CARTPOS1()

CASE 2
CARTPOS2()

CASE 3
CARTPOS3()

CASE 4
CARTPOS4()

CASE 4
bombero ()

ENDSWITCH

;FOLD Fordtech.Area_Rel Area Release: 4 ;%{PE}%MKUKATPUSER

Area_Rel (4)

;ENDFOLD
END

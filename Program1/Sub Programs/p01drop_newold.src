&ACCESS RVO1
&COMMENT Drop Part
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\Program\Sub Programs
DEF p01drop_newold( )
;FOLD INI
  ;FOLD BASISTECH INI

    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
;ENDFOLD (INI)
;================================================
; MODEL    : XXXX
; IE GROUP : XX
; STATION  : XXX
; ROBOT    : RX
; FUNCTION : Drop Part in StXX
;================================================
$TIMER[7]=0
$TIMER_STOP[7]=FALSE

waitarea:
QR_NOK=FALSE

;Wait For Area / Goto Safety / Return To Home
;FOLD PTP P2Waitdrop Vel=100 % PDAT2 Tool[8] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P2Waitdrop, 3:, 5:100, 7:PDAT2
$BWDSTART=FALSE
PDAT_ACT=PPDAT2
FDAT_ACT=FP2Waitdrop
BAS(#PTP_PARAMS,100)
PTP XP2Waitdrop 
;ENDFOLD

WAIT FOR ($IN[54]==TRUE) OR ($IN[1]==TRUE)

IF $in[54]==TRUE THEN 
   bomberos_2 ( )               ; PICK In Station XX
ENDIF


;IF FALSE THEN

;Para de contar TC hasta que recibe typinfo para dejar (paleta indexada, tipo...)
$TIMER_STOP[7]=TRUE

;FOLD TYPE INFO
   
O_TYPE_REQ=FALSE
WAIT FOR I_TYPE_INFO==0
O_TYPE_REQ=TRUE
WAIT FOR ((I_TYPE_INFO>100) AND (I_TYPE_INFO<201) or ($IN[54]==TRUE))
IF $in[54]==TRUE THEN 
   bomberos_2 ( )               ; PICK In Station XX
ENDIF
O_TYPE_INFO=I_TYPE_INFO

;ENDFOLD

;ENDIF

$TIMER_STOP[7]=FALSE

SWITCH i_TYPE_INFO ;coldplate grande o peq

CASE 111
$TIMER_STOP[7]=TRUE
INDICE_DROP=1

   O_TYPE_REQ=FALSE   
;FOLD Fordtech.Area_Req Area Request: 3, Safety Position: 0, Return To Home: 0 ;%{PE}
Area_Req (3,0,0)
IF I_RETHP AND (0 <> 0) AND ($IN_HOME == TRUE) THEN
  GOTO PEXIT
ENDIF
;ENDFOLD
   $TIMER_STOP[7]=FALSE
   DropPOS1() ;POSICION 1 COLDPLATE GRANDE 


CASE 112
$TIMER_STOP[7]=TRUE
INDICE_DROP=2

   O_TYPE_REQ=FALSE
;FOLD Fordtech.Area_Req Area Request: 3, Safety Position: 0, Return To Home: 0 ;%{PE}
Area_Req (3,0,0)
IF I_RETHP AND (0 <> 0) AND ($IN_HOME == TRUE) THEN
  GOTO PEXIT
ENDIF
;ENDFOLD
   $TIMER_STOP[7]=FALSE
   DropPOS2() ;POSICION 2 COLDPLATE GRANDE
   
CASE 113
$TIMER_STOP[7]=TRUE
INDICE_DROP=3

   O_TYPE_REQ=FALSE
;FOLD Fordtech.Area_Req Area Request: 3, Safety Position: 0, Return To Home: 0 ;%{PE}
Area_Req (3,0,0)
IF I_RETHP AND (0 <> 0) AND ($IN_HOME == TRUE) THEN
  GOTO PEXIT
ENDIF
;ENDFOLD
   $TIMER_STOP[7]=FALSE
   DropPOS3() ;POSICION 3 COLDPLATE GRANDE

CASE 150
bomberos_2 ()



CASE 121
$TIMER_STOP[7]=TRUE
INDICE_DROP=4

   O_TYPE_REQ=FALSE
;FOLD Fordtech.Area_Req Area Request: 3, Safety Position: 0, Return To Home: 0 ;%{PE}
Area_Req (3,0,0)
IF I_RETHP AND (0 <> 0) AND ($IN_HOME == TRUE) THEN
  GOTO PEXIT
ENDIF
;ENDFOLD
   $TIMER_STOP[7]=FALSE
   DropPOS1();POSICION 1 COLDPLATE PEQUEÑO 

CASE 200
$TIMER_STOP[7]=TRUE
INDICE_DROP=4

   O_TYPE_REQ=FALSE
   P01DROP2_2();POSICION 1 COLDPLATE PEQUEÑO 

DEFAULT
   
WAIT FOR FALSE   
   
ENDSWITCH

;fold QR NOK
IF (QR_NOK==TRUE) THEN

GOTO waitarea
ENDIF

;ENDFOLD


;FOLD PROVISIONAL PARA PRUEBAS
IF M2_TYPE_INFO<13 THEN  
M2_TYPE_INFO=M2_TYPE_INFO+1    
ENDIF

;ENDFOLD

PEXIT:

;FOLD Guarda_TC Dejada

;Guarda TC dejada
$TIMER_STOP[7]=TRUE
TC_DROP[INDICE_DROP]=$TIMER[7]

IF (INDICE_DROP < 4) THEN ;CUANDO DEJA ARRAYS EN COLD PLATES GRANDES
   IF (INDICE_RACK == 1)THEN
      TC_CP_BIG[INDICE_DROP]=TC_DROP[INDICE_DROP]+TC_PICK_RACK1[INDICE_PICK]
   ELSE
      TC_CP_BIG[INDICE_DROP]=TC_DROP[INDICE_DROP]+TC_PICK_RACK2[INDICE_PICK]
   ENDIF
   IF (INDICE_DROP == 3) THEN ;Cuando rellena el tercer colplate acumula en array de CP big
      TC_ARRAY_CPB[INDICE_ARRAYS_CPB]=TC_CP_BIG[1]+TC_CP_BIG[2]+TC_CP_BIG[3]
      INDICE_ARRAYS_CPB=INDICE_ARRAYS_CPB+1
      IF (INDICE_ARRAYS_CPB > 18) THEN
         INDICE_ARRAYS_CPB=1
         ;Actualiza el tiempo de ciclo medio por bateria
         ;Toma el tiempo de ciclo medio por batería como la media de procesar 2 racks
         ;64 arrays y 4 cartones, eso vienen a ser unas 7 baterías y me sobra 1 array
         TC_MEDIO_CARTONES=((((TC_CARTON[1]+TC_CARTON[2]+TC_CARTON[3]+TC_CARTON[4])/1000)*63)/64)
         TC_MEDIO_BATERIA=((TC_ARRAY_CPB[1]+TC_ARRAY_CPB[2]+TC_ARRAY_CPB[3]+TC_ARRAY_CPB[4]+TC_ARRAY_CPB[5]+TC_ARRAY_CPB[6]+TC_ARRAY_CPB[7]+TC_ARRAY_CPB[8]+TC_ARRAY_CPB[9]+TC_ARRAY_CPB[10]+TC_ARRAY_CPB[11]+TC_ARRAY_CPB[12]+TC_ARRAY_CPB[13]+TC_ARRAY_CPB[14]+TC_ARRAY_CPB[15]+TC_ARRAY_CPB[16]+TC_ARRAY_CPB[17]+TC_ARRAY_CPB[18]+TC_CP_SMALL[1]+TC_CP_SMALL[2]+TC_CP_SMALL[3]+TC_CP_SMALL[4]+TC_CP_SMALL[5]+TC_CP_SMALL[6]+TC_CP_SMALL[7]+TC_CP_SMALL[8]+TC_CP_SMALL[9])/1000)
         TC_MEDIO_BATERIA=((TC_MEDIO_BATERIA+TC_MEDIO_CARTONES)/9)
      ENDIF
   ENDIF
      ENDIF
         
IF (INDICE_DROP == 4) THEN ;CUANDO DEJA ARRAYS EN COLD PLATE PEQUEÑOS
   IF (INDICE_RACK == 1)THEN
      TC_CP_SMALL[INDICE_ARRAYS_CPS]=TC_DROP[4]+TC_PICK_RACK1[INDICE_PICK]
   ELSE
      TC_CP_SMALL[INDICE_ARRAYS_CPS]=TC_DROP[4]+TC_PICK_RACK2[INDICE_PICK]
   ENDIF   
   INDICE_ARRAYS_CPS=INDICE_ARRAYS_CPS+1 
   IF (INDICE_ARRAYS_CPS > 9) THEN
      INDICE_ARRAYS_CPS=1
   ENDIF
ENDIF

;ENDFOLD

END
DEF       DropPOS1()



;FOLD PTP P11 CONT Vel=100 % PDAT29 Tool[8] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P11, 3:C_DIS, 5:100, 7:PDAT29
$BWDSTART=FALSE

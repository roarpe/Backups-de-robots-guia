;FOLD WAIT FOR NOT ( IN 258 'F carrera superior S201' );%{PE}%R 8.3.48,%MKUKATPBASIS,%CEXT_WAIT_FOR,%VEXT_WAIT_FOR,%P 2:NOT, 4:, 5:$IN, 6:258, 7:F carrera superior S201, 9:

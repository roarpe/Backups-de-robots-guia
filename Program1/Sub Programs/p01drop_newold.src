;FOLD LIN preDROPpoint_1 Vel=2 m/s CPDAT4 Tool[5] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:preDROPpoint_1, 3:, 5:2, 7:CPDAT4

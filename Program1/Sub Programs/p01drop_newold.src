Job_Ready (3) 
;ENDFOLD


;FOLD PTP P1 CONT Vel=100 % PDAT8 Tool[5] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P1, 3:C_DIS, 5:100, 7:PDAT8

&ACCESS RVO1
&REL 4238
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\Program\Sub Programs
DEF panpick2( )
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here

$ACT_BASE=0
$ACT_TOOL=0
INPICKER_Handler.DataToSend.command=0  
 wait for (INPICKER_Handler.DataReceived.state==0)
;CILS_INIT()
REINTENTO=FALSE
  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

xp03=$POS_ACT
PUNTOFOTO:
;POS FOTO 1
;FOLD PTP P03 CONT Vel=100 % PDAT1 Tool[0] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P03, 3:C_DIS, 5:100, 7:PDAT1
$BWDSTART=FALSE
PDAT_ACT=PPDAT1
FDAT_ACT=FP03
BAS(#PTP_PARAMS,100)
PTP XP03 C_DIS
;ENDFOLD
INICIOFOTO:


;fold espera foto

 INPICKER_Handler.DataToSend.partid=0
 INPICKER_Handler.DataToSend.command=1  
 wait for (INPICKER_Handler.DataReceived.state==30) or (INPICKER_Handler.dataReceived.state==-1)
 wait sec 0.5
 if (INPICKER_handler.datareceived.state==-1 )  THEN

INPICKER_Handler.DataToSend.command=0  
 wait for (INPICKER_Handler.DataReceived.state==0)
goto iniciofoto
endif
;ENDFOLD
;EVALUA foto

IF (INPICKER_Handler.DataReceived.ObjectsGraspable>0)THEN

;FOLD CARGA FRAMEXP01
;FOTO OK
FRAMEAUX={X 0,Y 0,Z 0,A 0,B 0,C 0}
FRAMEAUX=INPICKER_Handler.DataReceived.PartsToGrasp0.Position
XP01.x=(FRAMEAUX.x/10)
XP01.y=(FRAMEAUX.y/10)
XP01.z=(FRAMEAUX.z/10)
XP01.a=FRAMEAUX.a/10
XP01.b=FRAMEAUX.b/10
XP01.c=FRAMEAUX.c/10
;ENDFOLD

;FOLD CARGA FRAME XP02
FRAMEAUX={X 0,Y 0,Z 0,A 0,B 0,C 0}
FRAMEAUX=INPICKER_Handler.DataReceived.PartsToGrasp0.PreGrasp0
XP02.x=(FRAMEAUX.x/10)
XP02.y=(FRAMEAUX.y/10)
XP02.z=(FRAMEAUX.z/10)
XP02.a=FRAMEAUX.a/10
XP02.b=FRAMEAUX.b/10
XP02.c=FRAMEAUX.c/10
;ENDFOLD

;FOLD Fordtech.Tool_Req Tool Request: 2 ;%{PE}%MKUKATPUSER

Tool_Req (2)

;ENDFOLD
;FOLD Fordtech.Wait_Tool_Ready Wait Tool Ready: 2 ;%{PE}%MKUKATPUSER

Wait_Tool_Ready (2)

;ENDFOLD

ELSE

IF (REINTENTO==FALSE) THEN
REINTENTO=TRUE
INPICKER_Handler.DataToSend.command=0  
 wait for (INPICKER_Handler.DataReceived.state==0)
GOTO INICIOFOTO
ENDIF


;FOTO NOK
;FOLD Fordtech.Tool_Req Tool Request: 1 ;%{PE}%MKUKATPUSER

Tool_Req (1)

;ENDFOLD
;FOLD Fordtech.Wait_Tool_Ready Wait Tool Ready: 1 ;%{PE}%MKUKATPUSER

Wait_Tool_Ready (1)

;ENDFOLD

BACKJUMP=TRUE
GOTO PEXIT

ENDIF

;Baja vel si array cerca del vallado
IF (posbat==11) THEN
;FOLD PTP P11 CONT Vel=100 % M2 Tool[5] Base[11];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P11, 3:C_DIS, 5:100, 7:M2
$BWDSTART=FALSE
PDAT_ACT=PM2
FDAT_ACT=FP11
BAS(#PTP_PARAMS,100)
PTP XP11 C_DIS
;ENDFOLD
ACT_OV=$OV_PRO
$OV_PRO=10
ENDIF

IF (posbat==12) THEN
;FOLD PTP P0 CONT Vel=80 % M3 Tool[5] Base[11];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P0, 3:C_DIS, 5:80, 7:M3
$BWDSTART=FALSE
PDAT_ACT=PM3
FDAT_ACT=FP0
BAS(#PTP_PARAMS,80)
PTP XP0 C_DIS
;ENDFOLD
ACT_OV=$OV_PRO
$OV_PRO=10
ENDIF

;FOLD PTP P02 CONT Vel=100 % PDAT2 Tool[5] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P02, 3:C_DIS, 5:100, 7:PDAT2
$BWDSTART=FALSE
PDAT_ACT=PPDAT2
FDAT_ACT=FP02
BAS(#PTP_PARAMS,100)
PTP XP02 C_DIS
;ENDFOLD

;FOLD LIN P01 Vel=1 m/s CPDAT3 Tool[5] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P01, 3:, 5:1, 7:CPDAT3
$BWDSTART=FALSE
LDAT_ACT=LCPDAT3
FDAT_ACT=FP01
BAS(#CP_PARAMS,1)
LIN XP01 
;ENDFOLD
;halt

;Cierra cilindros
CIL_BAT_ACTIVO()

;Revisa sensores y si falta alguno abre y cierra la garra 1 vez
IF NOT (($IN[243] AND $IN[244] AND $IN[245] AND $IN[247])) THEN
  $OUT[243]=TRUE
  $OUT[244]=FALSE
  WAIT SEC 0.5
  $OUT[243]=FALSE
  $OUT[244]=TRUE
ENDIF

;Mueve arriba 50mm
lin_rel {z 50}

;Revisa sensores de cilindros cerrados
;FOLD WAIT FOR ( IN 245 'CIL array closed S302B' ) CONT;%{PE}%R 8.3.48,%MKUKATPBASIS,%CEXT_WAIT_FOR,%VEXT_WAIT_FOR,%P 2:, 4:, 5:$IN, 6:245, 7:CIL array closed S302B, 9:CONTINUE
CONTINUE
WAIT FOR  ( $IN[245] ) 
;ENDFOLD
;FOLD WAIT FOR ( IN 247 'CIL array closed S301B' ) CONT;%{PE}%R 8.3.48,%MKUKATPBASIS,%CEXT_WAIT_FOR,%VEXT_WAIT_FOR,%P 2:, 4:, 5:$IN, 6:247, 7:CIL array closed S301B, 9:CONTINUE
CONTINUE
WAIT FOR  ( $IN[247] ) 
;ENDFOLD

PART_CHECK()

;FOLD WAIT FOR ( IN 257 'F carrera superior S202' );%{PE}%R 8.3.48,%MKUKATPBASIS,%CEXT_WAIT_FOR,%VEXT_WAIT_FOR,%P 2:, 4:, 5:$IN, 6:257, 7:F carrera superior S202, 9:
WAIT FOR  ( $IN[257] ) 
;ENDFOLD
;FOLD WAIT FOR ( IN 258 'F carrera superior S201' );%{PE}%R 8.3.48,%MKUKATPBASIS,%CEXT_WAIT_FOR,%VEXT_WAIT_FOR,%P 2:, 4:, 5:$IN, 6:258, 7:F carrera superior S201, 9:
WAIT FOR  ( $IN[258] ) 
;ENDFOLD


INPICKER_Handler.DataToSend.command=0  

IF REINT_COGIDA==TRUE THEN
LIN_REL {Z -40}
wait sec 1
CIL_BAT_REPOSO()
PART_CHECK_OFF()
wait sec 1
LIN_REL {Z 100}
 wait for (INPICKER_Handler.DataReceived.state==0)
GOTO PUNTOFOTO
ENDIF

;Fold guardamos posicion para carton
IF (POSBAT==12) THEN   
   IF ($POS_ACT.x>420) AND ($POS_ACT.x<630) THEN   
      BASE_DATA[15].x=$POS_ACT.x
   ENDIF
   IF ($POS_ACT.y>1886) AND ($POS_ACT.y<2087) THEN
      BASE_DATA[15].y=$POS_ACT.y
   ENDIF
;BASE_DATA[14].z=$POS_ACT.z
ENDIF
;ENDFOLD

;fold P04

FRAMEAUX={X 0,Y 0,Z 0,A 0,B 0,C 0}
XP04=FRAMEAUX
XP04.x=XP02.x
XP04.y=XP02.y
XP04.z=(XP02.z)+110
XP04.a=XP02.a
XP04.b=XP02.b
XP04.c=XP02.c

;ENDFOLD

;FOLD PTP p04 CONT Vel=100 % PDAT4 Tool[8] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p04, 3:C_DIS, 5:100, 7:PDAT4
$BWDSTART=FALSE
PDAT_ACT=PPDAT4
FDAT_ACT=Fp04
BAS(#PTP_PARAMS,100)
PTP Xp04 C_DIS
;ENDFOLD

;sube vel cuando se aleja del vallado
IF (posbat==11) THEN
;FOLD PTP P10 CONT Vel=100 % PDAT10 Tool[5] Base[11];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P10, 3:C_DIS, 5:100, 7:PDAT10
$BWDSTART=FALSE
PDAT_ACT=PPDAT10
FDAT_ACT=FP10
BAS(#PTP_PARAMS,100)
PTP XP10 C_DIS
;ENDFOLD
$OV_PRO=ACT_OV
ENDIF

;sube vel cuando se aleja del vallado
IF (posbat==12) THEN
;FOLD PTP P12 CONT Vel=100 % PDAT11 Tool[5] Base[11];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P12, 3:C_DIS, 5:100, 7:PDAT11
$BWDSTART=FALSE
PDAT_ACT=PPDAT11
FDAT_ACT=FP12
BAS(#PTP_PARAMS,100)
PTP XP12 C_DIS
;ENDFOLD
$OV_PRO=ACT_OV
ENDIF

;FOLD SYN OUT 42 'Job Ready 2' State=TRUE at START Delay=0 ms;%{PE}%R 8.3.48,%MKUKATPBASIS,%COUT,%VSYNOUT,%P 2:42, 3:Job Ready 2, 5:TRUE, 7:0, 9:0, 12:0
TRIGGER WHEN DISTANCE=0 DELAY=0 DO $OUT[42]=TRUE
;ENDFOLD
BAT_MONITOR=TRUE

;FOLD PTP P6 CONT Vel=80 % M2 Tool[8] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P6, 3:C_DIS, 5:80, 7:M2
$BWDSTART=FALSE
PDAT_ACT=PM2
FDAT_ACT=FP6
BAS(#PTP_PARAMS,80)
PTP XP6 C_DIS
;ENDFOLD
;FOLD SYN OUT 18 'Area Release 2' State=TRUE at START Delay=0 ms;%{PE}%R 8.3.48,%MKUKATPBASIS,%COUT,%VSYNOUT,%P 2:18, 3:Area Release 2, 5:TRUE, 7:0, 9:0, 12:0
TRIGGER WHEN DISTANCE=0 DELAY=0 DO $OUT[18]=TRUE
;ENDFOLD
;FOLD PTP P7 CONT Vel=100 % PDAT7 Tool[8] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P7, 3:C_DIS, 5:100, 7:PDAT7
$BWDSTART=FALSE
PDAT_ACT=PPDAT7
FDAT_ACT=FP7
BAS(#PTP_PARAMS,100)
PTP XP7 C_DIS
;ENDFOLD
;FOLD PTP P13 CONT Vel=100 % PDAT12 Tool[8] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P13, 3:C_DIS, 5:100, 7:PDAT12
$BWDSTART=FALSE
PDAT_ACT=PPDAT12
FDAT_ACT=FP13
BAS(#PTP_PARAMS,100)
PTP XP13 C_DIS
;ENDFOLD

;FOLD PTP P9 CONT Vel=100 % PDAT9 Tool[8] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P9, 3:C_DIS, 5:100, 7:PDAT9
$BWDSTART=FALSE
PDAT_ACT=PPDAT9
FDAT_ACT=FP9
BAS(#PTP_PARAMS,100)
PTP XP9 C_DIS
;ENDFOLD
PEXIT:
END


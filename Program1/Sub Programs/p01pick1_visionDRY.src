&ACCESS RVP
&REL 12
&COMMENT Pick Part
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\Program\Sub Programs
DEF p01pick1_visionDRY( )
;FOLD INI
  ;FOLD BASISTECH INI
BACKJUMP=FALSE
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
;ENDFOLD (INI)
;================================================
; MODEL    : XXXX
; IE GROUP : XX
; STATION  : XXX
; ROBOT    : RX 
; FUNCTION : pick Part in StXX  
;================================================
;wait point

;FOLD PTP P01waitdrop Vel=100 % PDAT1 Tool[5] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P01waitdrop, 3:, 5:100, 7:PDAT1
$BWDSTART=FALSE
PDAT_ACT=PPDAT1
FDAT_ACT=FP01waitdrop
BAS(#PTP_PARAMS,100)
PTP XP01waitdrop 
;ENDFOLD

loop
;FOLD TYPE INFO
   
IF (M_TYPE_INFO<100)THEN
POSBAT=M_TYPE_INFO
PISO=0
ENDIF
IF (M_TYPE_INFO>100) AND (M_TYPE_INFO<200)THEN
POSBAT=M_TYPE_INFO-100
PISO=1
ENDIF
IF (M_TYPE_INFO>200) AND (M_TYPE_INFO<300)THEN
POSBAT=M_TYPE_INFO-200
PISO=2
ENDIF

O_TYPE_REQ=FALSE

;ENDFOLD
;cils_init()





;FOLD ALTUA BASE
level1=PISO   
BASE_DATA[11]=BASE_DATA[13]
BASE_DATA[11].Z=BASE_DATA[11].Z+(ALTURA1*LEVEL1)
POSBAT=M_TYPE_INFO

;ENDFOLD


SWITCH POSBAT ;posicion bateria

CASE 1
   
;POS FOTO BATERIA 1   
;FOLD PTP BATPOS1 Vel=100 % PDAT2 Tool[5] Base[11];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:BATPOS1, 3:, 5:100, 7:PDAT2
$BWDSTART=FALSE
PDAT_ACT=PPDAT2
FDAT_ACT=FBATPOS1
BAS(#PTP_PARAMS,100)
PTP XBATPOS1 
;ENDFOLD
   
CASE 2

;POS FOTO BATERIA 2   
;FOLD PTP BATPOS2 Vel=100 % PDAT3 Tool[5] Base[11];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:BATPOS2, 3:, 5:100, 7:PDAT3
$BWDSTART=FALSE
PDAT_ACT=PPDAT3
FDAT_ACT=FBATPOS2
BAS(#PTP_PARAMS,100)
PTP XBATPOS2 
;ENDFOLD

CASE 3

;POS FOTO BATERIA 3
;FOLD PTP BATPOS3 Vel=100 % PDAT4 Tool[5] Base[11];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:BATPOS3, 3:, 5:100, 7:PDAT4
$BWDSTART=FALSE
PDAT_ACT=PPDAT4
FDAT_ACT=FBATPOS3
BAS(#PTP_PARAMS,100)
PTP XBATPOS3 
;ENDFOLD
 
CASE 4

;POS FOTO BATERIA 4
;FOLD PTP BATPOS4 Vel=100 % PDAT5 Tool[5] Base[11];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:BATPOS4, 3:, 5:100, 7:PDAT5
$BWDSTART=FALSE
PDAT_ACT=PPDAT5
FDAT_ACT=FBATPOS4
BAS(#PTP_PARAMS,100)
PTP XBATPOS4 
;ENDFOLD

CASE 5

;POS FOTO BATERIA 5
;FOLD PTP BATPOS5 Vel=100 % PDAT6 Tool[5] Base[11];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:BATPOS5, 3:, 5:100, 7:PDAT6
$BWDSTART=FALSE
PDAT_ACT=PPDAT6
FDAT_ACT=FBATPOS5
BAS(#PTP_PARAMS,100)
PTP XBATPOS5 
;ENDFOLD

CASE 6

;POS FOTO BATERIA 6
;FOLD PTP BATPOS6 Vel=100 % PDAT7 Tool[5] Base[11];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:BATPOS6, 3:, 5:100, 7:PDAT7
$BWDSTART=FALSE
PDAT_ACT=PPDAT7
FDAT_ACT=FBATPOS6
BAS(#PTP_PARAMS,100)
PTP XBATPOS6 
;ENDFOLD
   
CASE 7

;POS FOTO BATERIA 7
;FOLD PTP BATPOS7 Vel=100 % PDAT8 Tool[5] Base[11];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:BATPOS7, 3:, 5:100, 7:PDAT8
$BWDSTART=FALSE
PDAT_ACT=PPDAT8
FDAT_ACT=FBATPOS7
BAS(#PTP_PARAMS,100)
PTP XBATPOS7 
;ENDFOLD

CASE 8

;POS FOTO BATERIA 8
;FOLD PTP BATPOS8 Vel=100 % PDAT9 Tool[5] Base[11];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:BATPOS8, 3:, 5:100, 7:PDAT9
$BWDSTART=FALSE
PDAT_ACT=PPDAT9
FDAT_ACT=FBATPOS8
BAS(#PTP_PARAMS,100)
PTP XBATPOS8 
;ENDFOLD
   
CASE 9

;POS FOTO BATERIA 9
;FOLD PTP BATPOS9 Vel=100 % PDAT10 Tool[5] Base[11];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:BATPOS9, 3:, 5:100, 7:PDAT10
$BWDSTART=FALSE
PDAT_ACT=PPDAT10
FDAT_ACT=FBATPOS9
BAS(#PTP_PARAMS,100)
PTP XBATPOS9 
;ENDFOLD

CASE 10

;POS FOTO BATERIA 10
;FOLD PTP BATPOS10 Vel=100 % PDAT11 Tool[5] Base[11];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:BATPOS10, 3:, 5:100, 7:PDAT11
$BWDSTART=FALSE
PDAT_ACT=PPDAT11
FDAT_ACT=FBATPOS10
BAS(#PTP_PARAMS,100)
PTP XBATPOS10 
;ENDFOLD

CASE 11

;POS FOTO BATERIA 11
;FOLD PTP BATPOS11 Vel=100 % PDAT12 Tool[5] Base[11];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:BATPOS11, 3:, 5:100, 7:PDAT12
$BWDSTART=FALSE
PDAT_ACT=PPDAT12
FDAT_ACT=FBATPOS11
BAS(#PTP_PARAMS,100)
PTP XBATPOS11 
;ENDFOLD

CASE 12

;POS FOTO BATERIA 12
;FOLD PTP BATPOS12 Vel=100 % PDAT13 Tool[5] Base[11];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:BATPOS12, 3:, 5:100, 7:PDAT13
$BWDSTART=FALSE
PDAT_ACT=PPDAT13
FDAT_ACT=FBATPOS12
BAS(#PTP_PARAMS,100)
PTP XBATPOS12 
;ENDFOLD

CASE 13

;CARTON   
P01pick2_2()   
P01drop2()

GOTO PEXIT
BACKJUMP=TRUE

DEFAULT
;ESTO NO DEBERIA HABER OCURRIDO, KEEP CALM   
WAIT FOR FALSE
   
ENDSWITCH

$ACT_BASE=0
$ACT_TOOL=0

panpick_dry()

;fold provisional para pruebas
M_TYPE_INFO=M_TYPE_INFO+1
IF (M_TYPE_INFO==13) THEN
M_TYPE_INFO=1
ENDIF
;endfold


IF NOT (BACKJUMP==TRUE) THEN
;FOLD Fordtech.Job_Rdy Set Job Ready: 1   ;%{PE}
Job_Ready (1) 
;ENDFOLD
ENDIF


;Release Area 1

;FOLD SYN OUT 17 'Area Release 1' State=TRUE at START Delay=0 ms;%{PE}%R 8.3.48,%MKUKATPBASIS,%COUT,%VSYNOUT,%P 2:17, 3:Area Release 1, 5:TRUE, 7:0, 9:0, 12:0
TRIGGER WHEN DISTANCE=0 DELAY=0 DO $OUT[17]=TRUE
;ENDFOLD
;Jump Adress
PEXIT:
endloop

END
&ACCESS RVO1
&COMMENT Pick CARTON
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\Program\Sub Programs
DEF P01pick1_2_antes( )
;FOLD INI
  ;FOLD BASISTECH INI
BACKJUMP=FALSE
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
;ENDFOLD (INI)
;================================================
; MODEL    : XXXX
; IE GROUP : XX
; STATION  : XXX
; ROBOT    : RX
; FUNCTION : pick Part in StXX 
;================================================

;wait point

;FOLD PTP P01Waitdrop CONT Vel=100 % PDAT1 Tool[5] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P01Waitdrop, 3:C_DIS, 5:100, 7:PDAT1
$BWDSTART=FALSE
PDAT_ACT=PPDAT1
FDAT_ACT=FP01Waitdrop
BAS(#PTP_PARAMS,100)
PTP XP01Waitdrop C_DIS
;ENDFOLD

;FOLD SYN OUT 241 'cil ventosas reposo' State=FALSE at START Delay=0 ms;%{PE}%R 8.3.48,%MKUKATPBASIS,%COUT,%VSYNOUT,%P 2:241, 3:cil ventosas reposo, 5:FALSE, 7:0, 9:0, 12:0
TRIGGER WHEN DISTANCE=0 DELAY=0 DO $OUT[241]=FALSE
;ENDFOLD
;FOLD SYN OUT 242 'cil ventosas activo' State=TRUE at START Delay=0 ms;%{PE}%R 8.3.48,%MKUKATPBASIS,%COUT,%VSYNOUT,%P 2:242, 3:cil ventosas activo, 5:TRUE, 7:0, 9:0, 12:0
TRIGGER WHEN DISTANCE=0 DELAY=0 DO $OUT[242]=TRUE
;ENDFOLD
;FOLD Fordtech.Tool_Req Tool Request: 2 ;%{PE}%MKUKATPUSER

Tool_Req (2)

;ENDFOLD
;FOLD Fordtech.Wait_Tool_Ready Wait Tool Ready: 2 ;%{PE}%MKUKATPUSER

Wait_Tool_Ready (2)

;ENDFOLD
;Wait For Area / Goto Safety / Return To Home


;FOLD ALTUA BASE
level1=PISO   
BASE_DATA[11].Z=(ALTURA1*LEVEL1)
BASE_DATA[14].Z=(ALTURA1*LEVEL1)

;ENDFOLD

;FOLD PTP P6 CONT Vel=100 % PDAT8 Tool[5] Base[14];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P6, 3:C_DIS, 5:100, 7:PDAT8
$BWDSTART=FALSE
PDAT_ACT=PPDAT8
FDAT_ACT=FP6
BAS(#PTP_PARAMS,100)
PTP XP6 C_DIS
;ENDFOLD
CONTINUE
CIL_VENT_ACTIVO()

;FOLD TORQMON SetLimits Axis1: 15 % Axis2: 20 % Axis3: 15 % Axis4: 15 % Axis5: 15 % Axis6: 15 %;%{PE}%R 8.3.48,%MKUKATPBASIS,%CTQ_MON,%VTQ_LIMITS,%P 2:TQ_LIMITS, 4:15, 7:20, 10:15, 13:15, 16:15, 19:15
SET_TQ_VALUES (15,20,15,15,15,15)
;ENDFOLD

;FOLD LIN P5 Vel=0.5 m/s CPDAT6 Tool[5] Base[14];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P5, 3:, 5:0.5, 7:CPDAT6
$BWDSTART=FALSE
LDAT_ACT=LCPDAT6
FDAT_ACT=FP5
BAS(#CP_PARAMS,0.5)
LIN XP5 
;ENDFOLD
SUCTION_ON()

;FOLD WAIT Time=2 sec;%{PE}%R 8.3.48,%MKUKATPBASIS,%CWAIT,%VWAIT,%P 3:2
WAIT SEC 2
;ENDFOLD

;FOLD LIN p15 CONT Vel=0.15 m/s L Tool[5] Base[14];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:p15, 3:C_DIS C_DIS, 5:0.15, 7:L
$BWDSTART=FALSE
LDAT_ACT=LL
FDAT_ACT=Fp15
BAS(#CP_PARAMS,0.15)
LIN Xp15 C_DIS C_DIS
;ENDFOLD

;FOLD WAIT FOR ( IN 60 'Vacum ok' ) CONT;%{PE}%R 8.3.48,%MKUKATPBASIS,%CEXT_WAIT_FOR,%VEXT_WAIT_FOR,%P 2:, 4:, 5:$IN, 6:60, 7:Vacum ok, 9:CONTINUE
CONTINUE
WAIT FOR  ( $IN[60] ) 
;ENDFOLD

;FOLD PTP P2 CONT Vel=50 % L Tool[5] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P2, 3:C_DIS, 5:50, 7:L
$BWDSTART=FALSE
PDAT_ACT=PL
FDAT_ACT=FP2
BAS(#PTP_PARAMS,50)
PTP XP2 C_DIS
;ENDFOLD

;FOLD Fordtech.Job_Rdy Set Job Ready: 5 ;%{PE}%MKUKATPUSER

Job_Ready (5) 

;ENDFOLD

;Deja torqmon a valores nominales
SET_TQ_VALUES ( )

;FOLD PTP P4 CONT Vel=50 % L Tool[0] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P4, 3:C_DIS, 5:50, 7:L
$BWDSTART=FALSE
PDAT_ACT=PL
FDAT_ACT=FP4
BAS(#PTP_PARAMS,50)
PTP XP4 C_DIS
;ENDFOLD


;FOLD SYN OUT 17 'Area Release 1' State=TRUE at START Delay=0 ms;%{PE}%R 8.3.48,%MKUKATPBASIS,%COUT,%VSYNOUT,%P 2:17, 3:Area Release 1, 5:TRUE, 7:0, 9:0, 12:0
TRIGGER WHEN DISTANCE=0 DELAY=0 DO $OUT[17]=TRUE
;ENDFOLD

;FOLD PTP P3 CONT Vel=100 % PDAT6 Tool[0] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P3, 3:C_DIS, 5:100, 7:PDAT6
$BWDSTART=FALSE
PDAT_ACT=PPDAT6
FDAT_ACT=FP3
BAS(#PTP_PARAMS,100)
PTP XP3 C_DIS
;ENDFOLD

;FOLD TYPE INFO

O_TYPE_REQ=FALSE
WAIT FOR I_TYPE_INFO==0
O_TYPE_REQ=TRUE
WAIT FOR (I_TYPE_INFO>0)
O_TYPE_INFO=I_TYPE_INFO
POS_CARTON=I_TYPE_INFO
O_TYPE_REQ=FALSE


;ENDFOLD


;FOLD WAIT FOR ( IN 20 'Area 4 Ready' );%{PE}%R 8.3.48,%MKUKATPBASIS,%CEXT_WAIT_FOR,%VEXT_WAIT_FOR,%P 2:, 4:, 5:$IN, 6:20, 7:Area 4 Ready, 9:
WAIT FOR  ( $IN[20] ) 
;ENDFOLD
;FOLD OUT 20 'Area Release 4' State=FALSE ;%{PE}%R 8.3.48,%MKUKATPBASIS,%COUT,%VOUTX,%P 2:20, 3:Area Release 4, 5:FALSE, 6:
$OUT[20]=FALSE
;ENDFOLD

;Jump Adress
PEXIT:


END
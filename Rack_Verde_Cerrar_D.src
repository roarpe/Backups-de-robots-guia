DEF STOP_PUSH()
INTERRUPT OFF 81

IF $PRO_MOVE THEN

BRAKE

IF NOT $ON_PATH THEN
PTP $AXIS_ACT
ENDIF

ENDIF

LIN_REL{Z +50}
WAIT FOR (NOT I_121R1S501) AND (NOT I_121R1S502)

INTERRUPT ON 81
END
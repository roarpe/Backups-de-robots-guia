PDAT_ACT=PM
FDAT_ACT=FP_aFOTO2_B1
BAS(#PTP_PARAMS,50)
PTP XP_aFOTO2_B1 C_DIS
;ENDFOLD

;FOLD LIN P_FOTO2V_Bandeja1 Vel=0.5 m/s M Tool[5]:T_Camara Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P_FOTO2V_Bandeja1, 3:, 5:0.5, 7:M
$BWDSTART=FALSE
LDAT_ACT=LM
FDAT_ACT=FP_FOTO2V_Bandeja1
BAS(#CP_PARAMS,0.5)
LIN XP_FOTO2V_Bandeja1 
;ENDFOLD
;FOLD REALIZA FOTO 2 BANDEJA 1 (INFERIOR)
WAIT SEC 1.0
INPICKER_Handler.DataToSend.GraspConfirmation=1

WAIT FOR (INPICKER_Handler.DataReceived.state==30) OR (INPICKER_Handler.dataReceived.state==-1)
WAIT SEC 0.5

INPICKER_Handler.DataToSend.command=0

IF (INPICKER_handler.datareceived.state==30 ) THEN

IF (INPICKER_Handler.DataReceived.ObjectsGraspable>0) THEN

O_INPICKER_OK=TRUE
O_INPICKER_NOK=FALSE

ELSE

O_INPICKER_OK=FALSE
O_INPICKER_NOK=TRUE

ENDIF

ENDIF

IF (INPICKER_handler.datareceived.state==-1 ) OR (INPICKER_Handler.DataReceived.ObjectsGraspable<=0) THEN

O_INPICKER_OK=FALSE
O_INPICKER_NOK=TRUE

O_TYPE_RQ = FALSE
WAIT FOR I_TYPE_INFO == 0

O_TYPE_RQ = TRUE
WAIT FOR (I_TYPE_INFO >= 1) AND (I_TYPE_INFO <= 5)

SWITCH I_TYPE_INFO

CASE 2
; #### SELECCION DESDE HMI REINTENTO FOTO ####

SELECT_NEXT=FALSE
O_INPICKER_OK=FALSE
O_INPICKER_NOK=FALSE
O_TYPE_RQ = FALSE

IF (INPICKER_Handler.DataReceived.ObjectsGraspable>0)THEN
ELSE
GOTO INICIO_FOTO1
ENDIF

WAIT FOR (INPICKER_Handler.DataReceived.state==0)
GOTO INICIO_FOTO1

CASE 3
; #### SELECCION DESDE HMI CONT SIN CORRECCION ####

SELECT_NEXT=FALSE
O_TYPE_RQ = FALSE

CASE 4
; #### SELECCION DESDE HMI CERRAR BANDEJA ####
; #### E IR A SIGUIENTE NIVEL             ####

SELECT_NEXT=TRUE
O_INPICKER_OK=FALSE
O_INPICKER_NOK=FALSE
O_TYPE_RQ = FALSE

DEFAULT
ENDSWITCH

ENDIF

;ENDFOLD
;FOLD ACTUALIZA BASE DE DESCARGA
FRAMEAUX={X 0,Y 0,Z 0,A 0,B 0,C 0}
FRAME_POS={X 0,Y 0,Z 0,A 0,B 0,C 0}

FRAMEAUX=INPICKER_Handler.DataReceived.PartsToGrasp0.Position
FRAME_POS.x=(FRAMEAUX.x/10)
FRAME_POS.y=(FRAMEAUX.y/10)
FRAME_POS.z=(FRAMEAUX.z/10)
FRAME_POS.a=(FRAMEAUX.a/10)
FRAME_POS.b=(FRAMEAUX.b/10)
FRAME_POS.c=(FRAMEAUX.c/10)

IF FRAME_POS.A < 180.0 THEN
FRAME_POS.A = FRAME_POS.A + 360
ENDIF
IF FRAME_POS.B < 180.0 THEN
FRAME_POS.B = FRAME_POS.B + 360
ENDIF
IF FRAME_POS.A > 180.0 THEN
FRAME_POS.A = FRAME_POS.A - 360
ENDIF
IF FRAME_POS.B > 180.0 THEN
FRAME_POS.B = FRAME_POS.B - 360
ENDIF

FRAME_POS.C = FRAME_POS.C - 360

;ENDFOLD
;FOLD CONTROL LIMITES DE VISION
CTRL_limites()
;ENDFOLD
;FOLD DECISION RESULTADOS EVALUACION BANDEJA 1
   
IF (O_INPICKER_OK==FALSE) AND (O_INPICKER_NOK==TRUE) THEN
SELECT_NEXT=FALSE
O_TYPE_RQ = FALSE   
GOTO FIN_FOTO1
ENDIF

      
IF (O_LIMITS_OK==FALSE) AND (O_LIMITS_NOK==TRUE) THEN

O_TYPE_RQ = FALSE
WAIT FOR I_TYPE_INFO == 0

O_TYPE_RQ = TRUE
WAIT FOR (I_TYPE_INFO >= 1) AND (I_TYPE_INFO <= 5)

SWITCH I_TYPE_INFO

CASE 2
; #### SELECCION DESDE HMI REINTENTO FOTO ####

SELECT_NEXT=FALSE
O_TYPE_RQ = FALSE
O_LIMITS_OK = FALSE
O_LIMITS_NOK = FALSE
O_LIMIT_X = FALSE
O_LIMIT_Y = FALSE
O_LIMIT_Z = FALSE
O_LIMIT_A = FALSE
O_LIMIT_B = FALSE
O_LIMIT_C = FALSE

GOTO INICIO_FOTO1

CASE 3
; #### SELECCION DESDE HMI CONT SIN CORRECCION ####

SELECT_NEXT=FALSE
O_TYPE_RQ = FALSE

CASE 4
; #### SELECCION DESDE HMI CERRAR BANDEJA ####
; #### E IR A SIGUIENTE NIVEL             ####

SELECT_NEXT=TRUE
O_TYPE_RQ = FALSE
O_LIMITS_OK = FALSE
O_LIMITS_NOK = FALSE
O_LIMIT_X = FALSE
O_LIMIT_Y = FALSE
O_LIMIT_Z = FALSE
O_LIMIT_A = FALSE
O_LIMIT_B = FALSE
O_LIMIT_C = FALSE

DEFAULT

HALT
HALT
HALT
ENDSWITCH

ENDIF

NO_TYPE_LBL:
;ENDFOLD
FIN_FOTO1:

CASE 22

&ACCESS RVO1
&REL 136
&COMMENT FOTOS EN RACK AZUL
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\Program\MAFELEC
DEF Rack_Azul_Inpicker( )
;FOLD DECLARACION_INPICKER
DECL EKI_STATUS Ret
DECL INT InPickerStateValue
;ENDFOLD
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here
O_LIMITS_OK=FALSE
O_LIMITS_NOK=FALSE
O_LIMIT_X=FALSE
O_LIMIT_Y=FALSE
O_LIMIT_Z=FALSE
O_LIMIT_A=FALSE
O_LIMIT_B=FALSE
O_LIMIT_C=FALSE
LIM_X=FALSE
LIM_Y=FALSE
LIM_Z=FALSE
LIM_A=FALSE
LIM_B=FALSE
LIM_C=FALSE
O_TYPE_INFO=0

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

;################################################
; PROYECTO: MAFELEC PLANTA DE BATERIAS
; ROBOT: 121_R1
; PROGRAMA: FOTO PARA CORRECCIONES EN RACK AZUL
; CREADO POR: Alejandro Company(zaisor robotics)
; FECHA: 23-NOVIEMBRE-2022
; MODIFICADO POR:
; FECHA MODIFICACION: 07-ENERO-2023
;################################################

;FOLD INICIALIZACION PUERTOS DE KRL
Ret = EKI_INIT("XML_Kuka_InPicker_1")
Ret = EKI_INIT("XML_Kuka_InPicker_2")

Ret = EKI_OPEN("XML_Kuka_InPicker_1")
Ret = EKI_OPEN("XML_Kuka_InPicker_2")

 INPICKER_Handler.DataToSend.command=0
;WAIT FOR (INPICKER_Handler.ConnectionStatus==TRUE)
;IF (INPICKER_Handler.ConnectionStatus==TRUE) THEN
;ELSE
;ENDIF

;ENDFOLD

Empujador(1,"R",FALSE)
Empujador(2,"R",FALSE)

; POSICION DE ESPERA ENTRADA RACK 2 
;FOLD PTP POS_ESPERA_FOTO Vel=100 % H Tool[5]:T_Camara Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:POS_ESPERA_FOTO, 3:, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FPOS_ESPERA_FOTO
BAS(#PTP_PARAMS,100)
PTP XPOS_ESPERA_FOTO 
;ENDFOLD

;ESPERA AREA 2
WAIT FOR I_ARDY_2
O_AREL_2=FALSE
RA_Bandeja_Nr=0

;FOLD PTP P10 CONT Vel=100 % M Tool[5]:T_Camara Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P10, 3:C_DIS, 5:100, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=FP10
BAS(#PTP_PARAMS,100)
PTP XP10 C_DIS
;ENDFOLD
Empujador(1,"R",TRUE)
Empujador(2,"R",TRUE)

O_TYPE_RQ=TRUE
WAIT FOR (I_TYPE_INFO >= 20) AND (I_TYPE_INFO <= 26)

RA_Bandeja_Nr=I_TYPE_INFO

SWITCH RA_Bandeja_Nr 

CASE 21
O_TYPE_INFO=RA_Bandeja_Nr
O_TYPE_RQ=FALSE
INICIO_FOTO1:
;FOLD PTP P_aFOTO1_B1 CONT Vel=50 % M Tool[5]:T_Camara Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P_aFOTO1_B1, 3:C_DIS, 5:50, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=FP_aFOTO1_B1
BAS(#PTP_PARAMS,50)
PTP XP_aFOTO1_B1 C_DIS
;ENDFOLD
;FOLD PTP P_FOTO1V_Bandeja1 Vel=50 % M Tool[5]:T_Camara Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P_FOTO1V_Bandeja1, 3:, 5:50, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=FP_FOTO1V_Bandeja1
BAS(#PTP_PARAMS,50)
PTP XP_FOTO1V_Bandeja1 
;ENDFOLD
;FOLD REALIZA FOTO 1 BANDEJA 1
WAIT SEC 1.0
Fallo_nr=0
Ini1:
O_INPICKER_OK = FALSE
O_INPICKER_NOK = FALSE
SELECT_SIN=FALSE
SELECT_U1=FALSE
SELECT_U2=FALSE
SELECT_U3=FALSE
SELECT_U4=FALSE

; INICIALIZACION CAMARA PARA BANDEJA 1
 INPICKER_Handler.DataToSend.command=0
 INPICKER_Handler.DataToSend.GraspConfirmation=0
 WAIT FOR (INPICKER_Handler.DataReceived.state==0)

; Camara siempre 2
 INPICKER_Handler.DataToSend.CameraID=2

; contendor igual al numero de bandeja
 INPICKER_Handler.DataToSend.ContainerID=6
 INPICKER_Handler.DataToSend.partid=6
 INPICKER_Handler.DataToSend.GraspConfirmation=0
 WAIT SEC 0.2

; DISPARO FOTO
 INPICKER_Handler.DataToSend.command=1  

; ESPERA FOTO REALIZADA
 WAIT FOR (INPICKER_Handler.DataReceived.state==15) OR (INPICKER_Handler.DataReceived.state==-1)

IF (INPICKER_Handler.DataReceived.state==-1) THEN

IF (Fallo_nr>=1) THEN
O_INPICKER_OK=FALSE
O_INPICKER_NOK=TRUE

O_TYPE_RQ = FALSE
WAIT FOR I_TYPE_INFO == 0

O_TYPE_RQ = TRUE
WAIT FOR (I_TYPE_INFO >= 1) AND (I_TYPE_INFO <= 5)

SWITCH I_TYPE_INFO

CASE 2
; #### SELECCION DESDE HMI REINTENTO FOTO ####

SELECT_NEXT=FALSE
O_INPICKER_OK=FALSE
O_INPICKER_NOK=FALSE
O_TYPE_RQ = FALSE
GOTO Ini1

CASE 3
; #### SELECCION DESDE HMI CONT SIN CORRECCION ####

SELECT_SIN=TRUE
O_INPICKER_OK=FALSE
O_INPICKER_NOK=TRUE
O_TYPE_RQ = FALSE
GOTO FIN_FOTO1

CASE 4
; #### SELECCION DESDE HMI CERRAR BANDEJA ####
; #### E IR A SIGUIENTE NIVEL             ####

SELECT_NEXT=TRUE
O_INPICKER_OK=FALSE
O_INPICKER_NOK=FALSE
O_TYPE_RQ = FALSE
GOTO FIN_FOTO1

DEFAULT
ENDSWITCH

ELSE

Fallo_nr=Fallo_nr+1
GOTO Ini1

ENDIF
ENDIF

Fin1:
 WAIT SEC 0.1
;ENDFOLD

;FOLD PTP P_aFOTO2_B1 CONT Vel=50 % M Tool[5]:T_Camara Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P_aFOTO2_B1, 3:C_DIS, 5:50, 7:M

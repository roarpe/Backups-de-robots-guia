;FOLD PTP P10 CONT Vel=100 % H Tool[2]:T_PUSH2 Base[1]:Rack_Verde;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P10, 3:C_DIS, 5:100, 7:H

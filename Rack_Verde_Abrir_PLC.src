&ACCESS RVO1
&REL 186
&COMMENT ABRIR BAND RACK VERDE
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\Program\MAFELEC
DEF Rack_Verde_Abrir_PLC( )
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
;FOLD SPOTTECH INI
USERSPOT(#INIT)
;ENDFOLD (SPOTTECH INI)
;FOLD GRIPPERTECH INI
USER_GRP(0,DUMMY,DUMMY,GDEFAULT)
;ENDFOLD (GRIPPERTECH INI)
  ;FOLD USER INI
    ;Make your modifications here
INTERRUPT DECL 11 WHEN I_Rack1_S1 DO Paro()
INTERRUPT DECL 12 WHEN I_Rack1_S2 DO Paro()
INTERRUPT DECL 13 WHEN I_Rack1_S3 DO Paro()
INTERRUPT DECL 14 WHEN I_Rack1_S4 DO Paro()
INTERRUPT DECL 15 WHEN I_Rack1_S5 DO Paro()
INTERRUPT DECL 81 WHEN I_121R1S501 DO STOP_PUSH ()
INTERRUPT DECL 82 WHEN I_121R1S502 DO STOP_PUSH ()

O_TYPE_INFO=0

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)
;################################################
; PROYECTO: MAFELEC PLANTA DE BATERIAS
; ROBOT: 121_R1
; PROGRAMA: APERTURA DE BANDEJAS EN RACK VERDE
; CREADO POR: Alejandro Company(zaisor robotics)
; FECHA: 23-NOVIEMBRE-2022
; MODIFICADO POR:
; FECHA MODIFICACION: 18-ENERO-2023
;################################################

Empujador(1,"R",FALSE)
Empujador(2,"A",FALSE)

INTERRUPT OFF 96
INTERRUPT OFF 97
INTERRUPT OFF 98
INTERRUPT OFF 99

; POSICION DE ESPERA ENTRADA RACK 1

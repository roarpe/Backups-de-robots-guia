DEF STOP_INT_REINT()
BRAKE
WAIT FOR FALSE
;2DO REINTENTO APERTURA FALLIDO
;ABRIR BANDEJA A MANO
;SELECCIONAR PASO AQUI Y LEER EL PTP DE LA LINEA SIGUIENTE
PTP $POS_ACT

END

$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FPOS_ESPERA_AREA1
BAS(#PTP_PARAMS,100)
PTP XPOS_ESPERA_AREA1 
;ENDFOLD

$TIMER[1]=0
$TIMER_STOP[1]=FALSE

;ESPERA AREA 1
WAIT FOR I_ARDY_1
O_AREL_1=FALSE

WAIT FOR I_121R1S1000==FALSE
;INTERRUPT ON 91
;INTERRUPT ON 81

;FOLD PTP P_ABRIR10 CONT Vel=100 % H Tool[2]:T_PUSH2 Base[1]:Rack_Verde;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P_ABRIR10, 3:C_DIS, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP_ABRIR10
BAS(#PTP_PARAMS,100)
PTP XP_ABRIR10 C_DIS
;ENDFOLD
;FOLD PTP P10 Vel=100 % H Tool[2]:T_PUSH2 Base[1]:Rack_Verde;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P10, 3:, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP10
BAS(#PTP_PARAMS,100)
PTP XP10 
;ENDFOLD

Empujador(1,"R",TRUE)
Empujador(2,"A",TRUE)

Repite:
Abrir_Bandejas ()

IF INTERRUPT_ACTV THEN
;PUNTO P120
PTP $POS_ACT
GOTO Repite
ENDIF

;FOLD PTP P10 Vel=100 % H Tool[2]:T_PUSH2 Base[1]:Rack_Verde;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P10, 3:, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP10
BAS(#PTP_PARAMS,100)
PTP XP10 
;ENDFOLD

; TRABAJO REALIZADO
O_JRDY_1=TRUE

IF FINALIZA_VERDE==FALSE THEN
O_TYPE_RQ=TRUE
WAIT FOR I_TYPE_INFO==1
ENDIF

O_TYPE_RQ=FALSE

Empujador(1,"R",FALSE)
Empujador(2,"R",FALSE)

; POSICION DE SALIDA RACK 1
;FOLD PTP POS_AREA1_LIBRE Vel=100 % H Tool[9]:T_Gripper1_Vacio Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:POS_AREA1_LIBRE, 3:, 5:100, 7:H

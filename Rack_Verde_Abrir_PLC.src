;FOLD LIN P520 CONT Vel=1 m/s M Tool[2]:T_PUSH2 Base[1]:Rack_Verde;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P520, 3:C_DIS C_DIS, 5:1, 7:M

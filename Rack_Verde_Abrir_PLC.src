DEF Paro()
INTERRUPT OFF 11
INTERRUPT OFF 12
INTERRUPT OFF 13
INTERRUPT OFF 14
INTERRUPT OFF 15

IF I_Rack1_S1 THEN
INTERRUPT_ACTV=FALSE
ELSE
INTERRUPT_ACTV=TRUE
ENDIF

BRAKE

WAIT SEC 0

PTP $POS_ACT
LIN $POS_INT

$OV_PRO=OLD_OVPRO

O_TREQ_1=TRUE
WAIT FOR I_TRDY_1
O_TREQ_1=FALSE

; TRABAJO REALIZADO
O_JRDY_1=TRUE

RESUME

END
DEF STOP_PUSH ()
INTERRUPT OFF 82
INTERRUPT OFF 81
BRAKE
PTP $POS_ACT
LIN_REL{Z -50}
WAIT SEC 0.5
WAIT FOR (NOT I_121R1S501) AND (NOT I_121R1S502)
LIN_REL{Z 50}
PTP $POS_ACT
;RESUME
END
DEF MOVS_APERTURA()
REINT_APERTURA=FALSE




IF NEW_REINT==FALSE THEN
   INTERRUPT ON 81
   INTERRUPT ON 82
ENDIF

IF NEW_REINT THEN
   INTERRUPT ON 96
   INTERRUPT ON 97
ENDIF


PTP $POS_ACT

;FOLD LIN P510 CONT Vel=0.5 m/s M Tool[2]:T_PUSH2 Base[1]:Rack_Verde;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P510, 3:C_DIS C_DIS, 5:0.5, 7:M

;FOLD PTP HOME Vel=100 % DEFAULT;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HOME, 3:, 5:100, 7:DEFAULT
$BWDSTART=FALSE
PDAT_ACT=PDEFAULT
FDAT_ACT=FHOME
BAS(#PTP_PARAMS,100)
$H_POS=XHOME
PTP XHOME 
;ENDFOLD

FINALIZA_VERDE=FALSE
SELECT_NEXT=FALSE

Rack_Verde_Inpicker ()

IF (SELECT_NEXT==FALSE) AND (FINALIZA_VERDE==FALSE) THEN

IF (I_ST121_INSPECCION==TRUE) THEN
Rack_Verde_CogerST121I ()
ELSE
Rack_Verde_CogerST121N ()
ENDIF

Rack_Verde_Dejar()
ENDIF

FINALIZA_VERDE=FALSE
SELECT_NEXT=FALSE

;FOLD PTP HOME Vel=100 % DEFAULT;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HOME, 3:, 5:100, 7:DEFAULT
$BWDSTART=FALSE
PDAT_ACT=PDEFAULT
FDAT_ACT=FHOME
BAS(#PTP_PARAMS,100)
$H_POS=XHOME
PTP XHOME 
;ENDFOLD
END

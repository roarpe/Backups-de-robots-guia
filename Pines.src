&ACCESS RVO1
&REL 5
&COMMENT GESTION MOVIMIENTOS PINES
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF Pines(accion:IN )
CHAR accion
;################################################
; PROYECTO: MAFELEC PLANTA DE BATERIAS
; ROBOT: 121_R1
; PROGRAMA: PROGRAMA DE GESTION PINES
; CREADO POR: Bob Esponja(zaisor robotics)
; FECHA: 23-NOVIEMBRE-2022
; MODIFICADO POR:
; FECHA MODIFICACION: 29-DICIEMBRE-2022
;################################################


SWITCH accion

CASE "A"
; ##################################
; ####      BLOQUEO PINES       ####
; ##################################
RETRY_PICK=0
REINTENTO:
O_121R1Y13B=FALSE
O_121R1Y13A=TRUE
O_121R1Y132B=FALSE
O_121R1Y132A=TRUE
; ##################################

$TIMER[20]=0

IF (RETRY_PICK<2) THEN
$TIMER_STOP[20]=FALSE
ENDIF

;WHILE (I_121R1S131A==FALSE) OR (I_121R1S132A==FALSE) OR (I_121R1S133A==FALSE) OR (I_121R1S134A==FALSE)

;IF (I_121R1S131A==FALSE) THEN
;WAIT FOR I_121R1S131A
;ENDIF

;IF (I_121R1S132A==FALSE) THEN
;WAIT FOR I_121R1S132A
;ENDIF

;IF (I_121R1S133A==FALSE) THEN
;WAIT FOR I_121R1S133A
;ENDIF

;IF (I_121R1S134A==FALSE) THEN
;WAIT FOR I_121R1S134A
;ENDIF

;ENDWHILE

WAIT FOR (I_121R1S131A AND I_121R1S132A AND I_121R1S133A AND I_121R1S134A) OR (($TIMER[20]>5000) AND (RETRY_PICK<2))

IF ($TIMER[20]>5000) THEN
O_121R1Y13A=FALSE
O_121R1Y13B=TRUE
O_121R1Y132A=FALSE
O_121R1Y132B=TRUE

WAIT FOR I_121R1S131B AND I_121R1S132B AND I_121R1S133B AND I_121R1S134B

RETRY_PICK=RETRY_PICK+1
SWITCH RETRY_PICK
   CASE 1
      LIN_REL {X -1,Y 0,Z 0,A 0,B 0,C 0}
      WAIT SEC 2
   CASE 2
      LIN_REL {X 2,Y 0,Z 0,A 0,B 0,C 0}
      WAIT SEC 2
ENDSWITCH      

GOTO REINTENTO
ENDIF

$TIMER[20]=0
$TIMER_STOP[20]=TRUE

WAIT FOR (I_121R1S131A AND I_121R1S132A AND I_121R1S133A AND I_121R1S134A)
RETRY_PICK=0

   CASE "R"
      
IF (I_121R1S131B AND I_121R1S132B AND I_121R1S133B AND I_121R1S134B)THEN
   GOTO OPEN_DONE
ENDIF
; ##################################
; ####      DESBLOQUEO PINES    ####
; ##################################

WAIT FOR (O_AREL_1==FALSE) OR (O_AREL_2==FALSE) OR (O_AREL_3==FALSE)


O_121R1Y13A=FALSE
O_121R1Y13B=TRUE
O_121R1Y132A=FALSE
O_121R1Y132B=TRUE

$TIMER[20]=0
$TIMER_STOP[20]=FALSE

;WHILE (I_121R1S131B==FALSE) OR (I_121R1S132B==FALSE) OR (I_121R1S133B==FALSE) OR (I_121R1S134B==FALSE)

;IF (I_121R1S131B==FALSE) THEN
;WAIT FOR I_121R1S131B
;ENDIF

;IF (I_121R1S132B==FALSE) THEN
;WAIT FOR I_121R1S132B
;ENDIF

;IF (I_121R1S133B==FALSE) THEN
;WAIT FOR I_121R1S133B
;ENDIF

;IF (I_121R1S134B==FALSE) THEN
;WAIT FOR I_121R1S134B
;ENDIF

;ENDWHILE

WAIT FOR (I_121R1S131B AND I_121R1S132B AND I_121R1S133B AND I_121R1S134B) OR ($TIMER[20]>4000)

IF ($TIMER[20]>4000) THEN
   
   LIN_REL {Z -4}
   $TIMER[20]=0
   $TIMER_STOP[20]=FALSE
   WAIT FOR (I_121R1S131B AND I_121R1S132B AND I_121R1S133B AND I_121R1S134B) OR ($TIMER[20]>4000)
   
      IF ($TIMER[20]>4000) THEN
         LIN_REL {Z +6}
         WAIT FOR (I_121R1S131B AND I_121R1S132B AND I_121R1S133B AND I_121R1S134B)         
      ENDIF
      
ENDIF

WAIT FOR (I_121R1S131B AND I_121R1S132B AND I_121R1S133B AND I_121R1S134B)         


DEFAULT

; #### SELECCION CODIGO ERRONEO ####
HALT
; ##################################
ENDSWITCH
OPEN_DONE:
END

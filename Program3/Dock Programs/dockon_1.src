&ACCESS RVP1
&REL 164
&COMMENT PICKUP GUN 1
DEF DOCKON_1( )
;================================================
; MODEL    : 
; IE GROUP : 
; STATION  : 
; ROBOT    :
; FUNCTION : DOCK ON GUN 1
;================================================
;FOLD INI
;FOLD BASISTECH INI
GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
INTERRUPT ON 3
BAS (#INITMOV,0 )
;ENDFOLD (BASISTECH INI)
;FOLD GRIPPERTECH INI
USER_GRP(0,DUMMY,DUMMY,GDEFAULT)
;ENDFOLD (GRIPPERTECH INI)
;FOLD USER INI
;Make your modifications here
;ENDFOLD (USER INI)
;ENDFOLD (INI)

PGNO1_TYPE=0

;FOLD PTP p10  Vel= 100 % H Tool[10]:Dock plate Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p10, 3:, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP10
BAS(#PTP_PARAMS,100)
PTP XP10
;ENDFOLD

;Open flap 1
;FOLD DOCKING.FLAP_OPN 1 ;%{PE}%MKUKATPUSER
DOCKING (#FLAP_OPN ,1)
;ENDFOLD

;FOLD ; Check docking station 1 ready to dock on;%{PE}%R 5.4.35,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:Check docking station 1 ready to dock on
;ENDFOLD
DOCKING (#REQ_DOCK_ON,1 )

;FOLD PTP p20 CONT Vel= 100 % H Tool[10]:Dock plate Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p20, 3:C_PTP, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP20
BAS(#PTP_PARAMS,100)
PTP XP20 C_PTP
;ENDFOLD
;FOLD PTP p30 CONT Vel= 100 % H Tool[10]:Dock plate Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p30, 3:C_PTP, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP30
BAS(#PTP_PARAMS,100)
PTP XP30 C_PTP
;ENDFOLD
;FOLD PTP p40  Vel= 100 % H Tool[10]:DOCKING PLATE Base[0];%{PE}%R 5.2.271,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p40, 3:, 5:100, 7:H
$BWDSTART = FALSE
PDAT_ACT=PH
FDAT_ACT=FP40
BAS(#PTP_PARAMS,100)
PTP XP40
;ENDFOLD
;FOLD PTP p50 CONT Vel= 100 % H Tool[10]:Dock plate Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p50, 3:C_PTP, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=Fp50
BAS(#PTP_PARAMS,100)
PTP Xp50 C_PTP
;ENDFOLD

;FOLD ; Above dock position station 1;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:Above dock position station 1
;ENDFOLD
;FOLD PTP p60  Vel= 100 % H Tool[10]:Dock plate Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p60, 3:, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=Fp60
BAS(#PTP_PARAMS,100)
PTP Xp60 
;ENDFOLD

;FOLD ; In Dock position Station 1;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:In Dock position Station 1
;ENDFOLD
;FOLD LIN p70  Vel= 0.2 m/s H Tool[10]:Dock plate Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:p70, 3:, 5:0.2, 7:H
$BWDSTART=FALSE
LDAT_ACT=LH
FDAT_ACT=Fp70
BAS(#CP_PARAMS,0.2)
LIN Xp70 
;ENDFOLD

;FOLD ; Lock Docking plate;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:Lock Docking plate
;ENDFOLD
DOCKING (#TOOL_LOCK,1 )

;FOLD ; Out Docking station 1;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:Out Docking station 1
;ENDFOLD
;FOLD LIN p81 H RETR CLS Gun= 1 Pair= FIRST Tool[1]:Gun 1 Base[0];%{PE}%R 6.0.16,%MKUKATPSPOT,%CRETR,%VLIN,%P 1:LIN, 2:p81, 3:, 5:2, 7:H, 9:#CLO, 11:1, 13:#FIRST
$BWDSTART=FALSE
LDAT_ACT=LH
FDAT_ACT=Fp81
BAS(#CP_PARAMS,LH.VEL)
S_ACT.GUN=1
S_ACT.PAIR=#FIRST
S_ACT.RETR=#CLO
S_READY=FALSE
TRIGGER WHEN DISTANCE=1 DELAY=0.0 DO USERSPOT(#RETR, S_ACT) PRIO=-1
LIN Xp81 
WAIT FOR S_READY
;ENDFOLD

;FOLD ; Check docking plate close and station 1 ok;%{PE}%R 5.4.35,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:Check docking plate close and station 1 ok
;ENDFOLD
DOCKING (#CHK_TOOL_ON,1 )

;FOLD PTP p90  Vel= 100 % H Tool[1]:Gun 1 Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p90, 3:, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=Fp90
BAS(#PTP_PARAMS,100)
PTP Xp90 
;ENDFOLD
;FOLD PTP p100 CONT Vel= 100 % H Tool[1]:Gun 1 Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p100, 3:C_PTP, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=Fp100
BAS(#PTP_PARAMS,100)
PTP Xp100 C_PTP
;ENDFOLD
;FOLD PTP p105 CONT Vel= 100 % H Tool[1]:Gun 1 Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p105, 3:C_PTP, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=Fp105
BAS(#PTP_PARAMS,100)
PTP Xp105 C_PTP
;ENDFOLD
;FOLD PTP p110 H RETR OPN Gun= 1 Pair= FIRST Tool[1]:Gun 1 Base[0];%{PE}%R 6.0.16,%MKUKATPSPOT,%CRETR,%VPTP,%P 1:PTP, 2:p110, 3:, 5:100, 7:H, 9:#OPN, 11:1, 13:#FIRST
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=Fp110
BAS(#PTP_PARAMS,PH.VEL)
S_ACT.GUN=1
S_ACT.PAIR=#FIRST
S_ACT.RETR=#OPN
S_READY=FALSE
TRIGGER WHEN DISTANCE=1 DELAY=0.0 DO USERSPOT(#RETR, S_ACT) PRIO=-1
PTP Xp110
WAIT FOR S_READY
;ENDFOLD

END
&ACCESS RV1
&REL 140
&COMMENT PLACE GUN 2
DEF DOCKOF_2( )
;================================================
; MODEL    :
; IE GROUP :
; STATION  :
; ROBOT    :
; FUNCTION : DOCK OFF GUN 2
;================================================
;FOLD INI
;FOLD BASISTECH INI
GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
INTERRUPT ON 3
BAS (#INITMOV,0 )
;ENDFOLD (BASISTECH INI)
;FOLD GRIPPERTECH INI
USER_GRP(0,DUMMY,DUMMY,GDEFAULT)
;ENDFOLD (GRIPPERTECH INI)
;FOLD USER INI
;Make your modifications here

;ENDFOLD (USER INI)
;ENDFOLD (INI)

;FOLD PTP p10  Vel= 100 % H Tool[2]:Gun2 Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p10, 3:, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=Fp10
BAS(#PTP_PARAMS,100)
PTP Xp10
;ENDFOLD

;Open flap 2
;FOLD DOCKING.FLAP_OPN 2 ;%{PE}%MKUKATPUSER
DOCKING (#FLAP_OPN ,2)
;ENDFOLD

;FOLD ; Check docking station 2 ready to dock off;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:Check docking station 2 ready to dock off
;ENDFOLD
DOCKING (#REQ_DOCK_OFF ,2)

;FOLD PTP P20 CONT Vel= 100 % h Tool[2]:Gun2 Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P20, 3:C_PTP, 5:100, 7:h
$BWDSTART=FALSE
PDAT_ACT=Ph
FDAT_ACT=FP20
BAS(#PTP_PARAMS,100)
PTP XP20 C_PTP
;ENDFOLD
;FOLD PTP P1 CONT Vel= 100 % H Tool[2]:Gun2 Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P1, 3:C_PTP, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP1
BAS(#PTP_PARAMS,100)
PTP XP1 C_PTP
;ENDFOLD
;FOLD PTP p30  Vel= 70 % H Tool[2]:Gun2 Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p30, 3:, 5:70, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=Fp30
BAS(#PTP_PARAMS,70)
PTP Xp30
;ENDFOLD

;FOLD ; Above dock position station 2;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:Above dock position station 2
;ENDFOLD
;FOLD PTP p40  Vel= 30 % H Tool[2]:Gun2 Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p40, 3:, 5:30, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=Fp40
BAS(#PTP_PARAMS,30)
PTP Xp40
;ENDFOLD

;FOLD ; In Dock position Station 2;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:In Dock position Station 2
;ENDFOLD
;FOLD LIN p50  Vel= 0.2 m/s H Tool[2]:Gun2 Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:p50, 3:, 5:0.2, 7:H
$BWDSTART=FALSE
LDAT_ACT=LH
FDAT_ACT=FP50
BAS(#CP_PARAMS,0.2)
LIN XP50
;ENDFOLD

;FOLD ; Unlock Docking plate;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:Unlock Docking plate
;ENDFOLD
DOCKING (#TOOL_UNLOCK ,2)

;FOLD ; Out Docking station 2;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:Out Docking station 2
;ENDFOLD
;FOLD LIN p60  Vel= 0.2 m/s H Tool[14]:GRIPPER 1 Base[0];%{PE}%R 5.2.271,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:p60, 3:, 5:0.2, 7:H
$BWDSTART = FALSE
LDAT_ACT=LH
FDAT_ACT=FP60
BAS(#CP_PARAMS,0.2)
LIN XP60
;ENDFOLD

;FOLD ; Check docking plate open and station 2 ok;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:Check docking plate open and station 2 ok
;endfold
DOCKING (#CHK_TOOL_OFF ,2)

;FOLD PTP p70 CONT Vel= 100 % H Tool[10]:Dock plate Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p70, 3:C_PTP, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=Fp70
BAS(#PTP_PARAMS,100)
PTP Xp70 C_PTP
;ENDFOLD
;FOLD PTP p80 CONT Vel= 100 % H Tool[10]:Dock plate Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p80, 3:C_PTP, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=Fp80
BAS(#PTP_PARAMS,100)
PTP Xp80 C_PTP
;ENDFOLD

;Close flap 2
;FOLD DOCKING.FLAP_CLS 2 ;%{PE}%MKUKATPUSER
DOCKING (#FLAP_CLS ,2)
;ENDFOLD
END


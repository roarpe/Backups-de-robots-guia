&ACCESS RVP1
&REL 128
&COMMENT PLACE GUN 3
DEF DOCKOF_3( )
;================================================
; MODEL    :
; IE GROUP :
; STATION  :
; ROBOT    :
; FUNCTION : DOCKING OFF GUN 3
;================================================
;FOLD INI
;FOLD BASISTECH INI
GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
INTERRUPT ON 3
BAS (#INITMOV,0 )
;ENDFOLD (BASISTECH INI)
;FOLD GRIPPERTECH INI
USER_GRP(0,DUMMY,DUMMY,GDEFAULT)
;ENDFOLD (GRIPPERTECH INI)
;FOLD USER INI
;Make your modifications here

;ENDFOLD (USER INI)
;ENDFOLD (INI)

;FOLD PTP p10  Vel= 100 % H Tool[3]:Gun 3 Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p10, 3:, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP10
BAS(#PTP_PARAMS,100)
PTP XP10
;ENDFOLD

;Open flap 3
;FOLD DOCKING.FLAP_OPN 3 ;%{PE}%MKUKATPUSER
DOCKING (#FLAP_OPN ,3)
;ENDFOLD

;FOLD ; Check docking station 3 ready to dock off;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:Check docking station 3 ready to dock off
;ENDFOLD
DOCKING (#REQ_DOCK_OFF ,3)

;FOLD PTP p20 CONT Vel= 100 % H Tool[3]:Gun 3 Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p20, 3:C_PTP, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP20
BAS(#PTP_PARAMS,100)
PTP XP20 C_PTP
;ENDFOLD
;FOLD PTP p30 CONT Vel= 100 % H Tool[3]:Gun 3 Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p30, 3:C_PTP, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP30
BAS(#PTP_PARAMS,100)
PTP XP30 C_PTP
;ENDFOLD
;FOLD PTP p40 CONT Vel= 100 % H Tool[3]:Gun 3 Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p40, 3:C_PTP, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP40
BAS(#PTP_PARAMS,100)
PTP XP40 C_PTP
;ENDFOLD

;FOLD ; Above dock position station 3;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:Above dock position station 3
;ENDFOLD
;FOLD PTP p50  Vel= 100 % H Tool[3]:Gun 3 Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p50, 3:, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP50
BAS(#PTP_PARAMS,100)
PTP XP50
;ENDFOLD

;FOLD ; In Dock position Station 3;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:In Dock position Station 3
;ENDFOLD
;FOLD LIN p60  Vel= 0.2 m/s H Tool[3]:Gun 3 Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:p60, 3:, 5:0.2, 7:H
$BWDSTART=FALSE
LDAT_ACT=LH
FDAT_ACT=FP60
BAS(#CP_PARAMS,0.2)
LIN XP60
;ENDFOLD

;FOLD ; Unlock Docking plate;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:Unlock Docking plate
;ENDFOLD
DOCKING (#TOOL_UNLOCK ,3)

;FOLD ; Out Docking station 3;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:Out Docking station 3
;ENDFOLD
;FOLD LIN p70  Vel= 0.2 m/s H Tool[10]:Dock plate Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:p70, 3:, 5:0.2, 7:H
$BWDSTART=FALSE
LDAT_ACT=LH
FDAT_ACT=FP70
BAS(#CP_PARAMS,0.2)
LIN XP70
;ENDFOLD

;FOLD ; Check docking plate open and station 3 ok;%{PE}%R 5.4.35,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:Check docking plate open and station 3 ok
;ENDFOLD
DOCKING (#CHK_TOOL_OFF ,3)

;FOLD PTP p80 CONT Vel= 100 % H Tool[10]:Dock plate Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p80, 3:C_PTP, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP80
BAS(#PTP_PARAMS,100)
PTP XP80 C_PTP
;ENDFOLD
;FOLD PTP p90 CONT Vel= 100 % H Tool[10]:Dock plate Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p90, 3:C_PTP, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=Fp90
BAS(#PTP_PARAMS,100)
PTP Xp90 C_PTP
;ENDFOLD
;FOLD PTP P100  Vel= 100 % H Tool[10]:Dock plate Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P100, 3:, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP100
BAS(#PTP_PARAMS,100)
PTP XP100
;ENDFOLD

;Close flap 3
;FOLD DOCKING.FLAP_CLS 3 ;%{PE}%MKUKATPUSER
DOCKING (#FLAP_CLS ,3)
;ENDFOLD

END


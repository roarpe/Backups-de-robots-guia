&ACCESS RVP1
&REL 140
&COMMENT PLACE GUN 1
DEF DOCKOF_1( )
;================================================
; MODEL    :
; IE GROUP :
; STATION  :
; ROBOT    :
; FUNCTION : DOCK OFF GUN 1
;================================================
;FOLD INI
;FOLD BASISTECH INI
GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
INTERRUPT ON 3
BAS (#INITMOV,0 )
;ENDFOLD (BASISTECH INI)
;FOLD GRIPPERTECH INI
USER_GRP(0,DUMMY,DUMMY,GDEFAULT)
;ENDFOLD (GRIPPERTECH INI)
;FOLD USER INI
;Make your modifications here

;ENDFOLD (USER INI)
;ENDFOLD (INI)

PGNO1_TYPE=0

;FOLD PTP p10 H RETR CLS Gun= 1 Pair= FIRST Tool[1]:Gun 1 Base[0];%{PE}%R 6.0.16,%MKUKATPSPOT,%CRETR,%VPTP,%P 1:PTP, 2:p10, 3:, 5:100, 7:H, 9:#CLO, 11:1, 13:#FIRST
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=Fp10
BAS(#PTP_PARAMS,PH.VEL)
S_ACT.GUN=1
S_ACT.PAIR=#FIRST
S_ACT.RETR=#CLO
S_READY=FALSE
TRIGGER WHEN DISTANCE=1 DELAY=0.0 DO USERSPOT(#RETR, S_ACT) PRIO=-1
PTP Xp10
WAIT FOR S_READY
;ENDFOLD

;Open flap 1
;FOLD DOCKING.FLAP_OPN 1 ;%{PE}%MKUKATPUSER
DOCKING (#FLAP_OPN ,1)
;ENDFOLD

;FOLD ; Check docking station 1 ready to dock off;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:Check docking station 1 ready to dock off
;ENDFOLD
DOCKING (#REQ_DOCK_OFF,1)

;FOLD PTP p20 CONT Vel= 100 % H Tool[1]:Gun 1 Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p20, 3:C_PTP, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=Fp20
BAS(#PTP_PARAMS,100)
PTP Xp20 C_PTP
;ENDFOLD
;FOLD PTP p30 CONT Vel= 100 % H Tool[1]:Gun 1 Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p30, 3:C_PTP, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=Fp30
BAS(#PTP_PARAMS,100)
PTP Xp30 C_PTP
;ENDFOLD

;FOLD ; Above dock position station 1;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:Above dock position station 1
;ENDFOLD
;FOLD PTP p40  Vel= 100 % H Tool[1]:Gun 1 Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p40, 3:, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=Fp40
BAS(#PTP_PARAMS,100)
PTP Xp40
;ENDFOLD
;FOLD LIN p50  Vel= 0.2 m/s H Tool[1]:Gun 1 Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:p50, 3:, 5:0.2, 7:H
$BWDSTART=FALSE
LDAT_ACT=LH
FDAT_ACT=Fp50
BAS(#CP_PARAMS,0.2)
LIN Xp50
;ENDFOLD

;FOLD ; In Dock position Station 1;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:In Dock position Station 1
;ENDFOLD
;FOLD LIN p60  Vel= 0.2 m/s H Tool[1]:Gun 1 Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:p60, 3:, 5:0.2, 7:H
$BWDSTART=FALSE
LDAT_ACT=LH
FDAT_ACT=Fp60
BAS(#CP_PARAMS,0.2)
LIN Xp60
;ENDFOLD

;FOLD ; Unlock Docking plate;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:Unlock Docking plate
;ENDFOLD
DOCKING (#TOOL_UNLOCK,1)

;FOLD ; Out Docking station 1;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:Out Docking station 1
;ENDFOLD
;FOLD LIN p70  Vel= 0.2 m/s H Tool[10]:Dock plate Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:p70, 3:, 5:0.2, 7:H
$BWDSTART=FALSE
LDAT_ACT=LH
FDAT_ACT=Fp70
BAS(#CP_PARAMS,0.2)
LIN Xp70
;ENDFOLD

;FOLD ; Check docking plate open and station 1 ok;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:Check docking plate open and station 1 ok
;ENDFOLD
DOCKING (#CHK_TOOL_OFF,1)

;FOLD PTP p80 CONT Vel= 100 % H Tool[10]:Dock plate Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p80, 3:C_PTP, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=Fp80
BAS(#PTP_PARAMS,100)
PTP Xp80 C_PTP
;ENDFOLD
;FOLD PTP p90 CONT Vel= 100 % H Tool[10]:Dock plate Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p90, 3:C_PTP, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=Fp90
BAS(#PTP_PARAMS,100)
PTP Xp90 C_PTP
;ENDFOLD
;FOLD PTP P100 CONT Vel= 100 % H Tool[10]:Dock plate Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P100, 3:C_PTP, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP100
BAS(#PTP_PARAMS,100)
PTP XP100 C_PTP
;ENDFOLD
;FOLD PTP P110 CONT Vel= 100 % H Tool[10]:Dock plate Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P110, 3:C_PTP, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP110
BAS(#PTP_PARAMS,100)
PTP XP110 C_PTP
;ENDFOLD
;FOLD PTP P120  Vel= 100 % H Tool[10]:Dock plate Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P120, 3:, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP120
BAS(#PTP_PARAMS,100)
PTP XP120
;ENDFOLD

;Close flap 1
;FOLD DOCKING.FLAP_CLS 1 ;%{PE}%MKUKATPUSER
DOCKING (#FLAP_CLS ,1)
;ENDFOLD
END


&ACCESS RV1
&REL 138
&COMMENT PICKUP GUN 3
DEF DOCKON_3( )
;================================================
; MODEL    : 
; IE GROUP : 
; STATION  : 
; ROBOT    :
; FUNCTION : DOCK ON GUN 3
;================================================
;FOLD INI
;FOLD BASISTECH INI
GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
INTERRUPT ON 3
BAS (#INITMOV,0 )
;ENDFOLD (BASISTECH INI)
;FOLD USER INI
;Make your modifications here
;ENDFOLD (USER INI)
;ENDFOLD (INI)

;FOLD PTP p10  Vel= 100 % H Tool[10]:DOCKING PLATE Base[0];%{PE}%R 5.2.271,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p10, 3:, 5:100, 7:H
$BWDSTART = FALSE
PDAT_ACT=PH
FDAT_ACT=FP10
BAS(#PTP_PARAMS,100)
PTP XP10
;ENDFOLD

;Open flap 3
;FOLD DOCKING.FLAP_OPN 3 ;%{PE}%MKUKATPUSER
DOCKING (#FLAP_OPN ,3)
;ENDFOLD

;FOLD ; Check docking station 3 ready to dock on;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:Check docking station 3 ready to dock on
;ENDFOLD
DOCKING (#REQ_DOCK_ON ,3)

;FOLD PTP p20 CONT Vel= 100 % H Tool[10]:Docking plaat Base[0];%{PE}%R 5.2.271,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p20, 3:C_PTP, 5:100, 7:H
$BWDSTART = FALSE
PDAT_ACT=PH
FDAT_ACT=FP20
BAS(#PTP_PARAMS,100)
PTP XP20 C_PTP
;ENDFOLD

;FOLD ; Above dock position station 3;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:Above dock position station 3
;ENDFOLD
;FOLD PTP p30  Vel= 100 % H Tool[10]:Docking plaat Base[0];%{PE}%R 5.2.271,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p30, 3:, 5:100, 7:H
$BWDSTART = FALSE
PDAT_ACT=PH
FDAT_ACT=FP30
BAS(#PTP_PARAMS,100)
PTP XP30
;ENDFOLD


;FOLD PTP P1  Vel= 100 % PDAT1 Tool[3]:Gun 3 Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P1, 3:, 5:100, 7:PDAT1
$BWDSTART=FALSE
PDAT_ACT=PPDAT1
FDAT_ACT=FP1
BAS(#PTP_PARAMS,100)
PTP XP1 
;ENDFOLD

;FOLD ; In Dock position Station 3;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:In Dock position Station 3
;ENDFOLD
;FOLD LIN p40  Vel= 0.2 m/s H Tool[10]:Docking plaat Base[0];%{PE}%R 5.2.271,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:p40, 3:, 5:0.2, 7:H
$BWDSTART = FALSE
LDAT_ACT=LH
FDAT_ACT=FP40
BAS(#CP_PARAMS,0.2)
LIN XP40
;ENDFOLD

;FOLD ; Lock Docking plate;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:Lock Docking plate
;ENDFOLD
DOCKING (#TOOL_LOCK,3)

;FOLD ; Out Docking station 3;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:Out Docking station 3
;ENDFOLD
;FOLD LIN p50  Vel= 0.2 m/s H Tool[3]:Gun 3 Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:p50, 3:, 5:0.2, 7:H
$BWDSTART=FALSE
LDAT_ACT=LH
FDAT_ACT=FP50
BAS(#CP_PARAMS,0.2)
LIN XP50
;ENDFOLD

;FOLD ; Check docking plate close and station 3 ok;%{PE}%R 5.4.35,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:Check docking plate close and station 3 ok
;ENDFOLD
DOCKING (#CHK_TOOL_ON,3)

;FOLD PTP p60 CONT Vel= 100 % H Tool[3]:Gun 3 Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p60, 3:C_PTP, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP60
BAS(#PTP_PARAMS,100)
PTP XP60 C_PTP
;ENDFOLD
;FOLD PTP p70 CONT Vel= 100 % H Tool[3]:Gun 3 Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p70, 3:C_PTP, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP70
BAS(#PTP_PARAMS,100)
PTP XP70 C_PTP
;ENDFOLD
;FOLD PTP p80  Vel= 100 % H Tool[3]:Gun 3 Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p80, 3:, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP80
BAS(#PTP_PARAMS,100)
PTP XP80
;ENDFOLD

END
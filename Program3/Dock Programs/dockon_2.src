&ACCESS RV1
&REL 166
&COMMENT PICKUP  GUN 2
DEF DOCKON_2( )
;================================================
; MODEL    : 
; IE GROUP : 
; STATION  : 
; ROBOT    :
; FUNCTION : DOCK ON GUN 2
;================================================
;FOLD INI
;FOLD BASISTECH INI
GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
INTERRUPT ON 3
BAS (#INITMOV,0 )
;ENDFOLD (BASISTECH INI)
;FOLD USER INI
;Make your modifications here
;ENDFOLD (USER INI)
;ENDFOLD (INI)

;FOLD PTP p10  Vel= 100 % H Tool[10]:DOCKING PLATE Base[0];%{PE}%R 5.2.271,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p10, 3:, 5:100, 7:H
$BWDSTART = FALSE
PDAT_ACT=PH
FDAT_ACT=FP10
BAS(#PTP_PARAMS,100)
PTP XP10
;ENDFOLD

;Open flap 2
;FOLD DOCKING.FLAP_OPN 2 ;%{PE}%MKUKATPUSER
DOCKING (#FLAP_OPN ,2)
;ENDFOLD

;FOLD ; Check docking station 2 ready to dock on;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:Check docking station 2 ready to dock on
;ENDFOLD
DOCKING (#REQ_DOCK_ON ,2)

;FOLD PTP p20 CONT Vel= 100 % H Tool[10]:Docking plaat Base[0];%{PE}%R 5.2.271,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p20, 3:C_PTP, 5:100, 7:H
$BWDSTART = FALSE
PDAT_ACT=PH
FDAT_ACT=FP20
BAS(#PTP_PARAMS,100)
PTP XP20 C_PTP
;ENDFOLD

;FOLD ; Above dock position station 2;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:Above dock position station 2
;ENDFOLD
;FOLD PTP p30  Vel= 100 % H Tool[10]:Dock plate Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p30, 3:, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP30
BAS(#PTP_PARAMS,100)
PTP XP30
;ENDFOLD

;FOLD ; In Dock position Station 2;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:In Dock position Station 2
;ENDFOLD
;FOLD LIN p40  Vel= 0.2 m/s H Tool[10]:Dock plate Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:p40, 3:, 5:0.2, 7:H
$BWDSTART=FALSE
LDAT_ACT=LH
FDAT_ACT=FP40
BAS(#CP_PARAMS,0.2)
LIN XP40
;ENDFOLD

;FOLD ; Lock Docking plate;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:Lock Docking plate
;ENDFOLD
DOCKING (#TOOL_LOCK ,2)

;FOLD ; Out Docking station 2;%{PE}%R 2.4.14,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:Out Docking station 2
;ENDFOLD
;FOLD LIN p50  Vel= 0.2 m/s H Tool[2]:Gun2 Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:p50, 3:, 5:0.2, 7:H
$BWDSTART=FALSE
LDAT_ACT=LH
FDAT_ACT=FP50
BAS(#CP_PARAMS,0.2)
LIN XP50
;ENDFOLD

;FOLD ; Check docking plate close and station 2 ok;%{PE}%R 5.4.35,%MKUKATPBASIS,%CCOMMENT,%VNORMAL,%P 2:Check docking plate close and station 2 ok
;ENDFOLD
DOCKING (#CHK_TOOL_ON ,2)

;FOLD PTP p60  Vel= 30 % H Tool[2]:Gun2 Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p60, 3:, 5:30, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=Fp60
BAS(#PTP_PARAMS,30)
PTP Xp60 
;ENDFOLD
;FOLD PTP p70 CONT Vel= 100 % H Tool[2]:Gun2 Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p70, 3:C_PTP, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=Fp70
BAS(#PTP_PARAMS,100)
PTP Xp70 C_PTP
;ENDFOLD
;FOLD PTP p80 CONT Vel= 100 % H Tool[2]:Gun2 Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p80, 3:C_PTP, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=Fp80
BAS(#PTP_PARAMS,100)
PTP Xp80 C_PTP
;ENDFOLD
;FOLD PTP p90  Vel= 100 % H Tool[2]:Gun2 Base[0];%{PE}%R 5.4.35,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p90, 3:, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP90
BAS(#PTP_PARAMS,100)
PTP XP90
;ENDFOLD

END
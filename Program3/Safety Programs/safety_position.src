    REPEAT
      EMPTY_MSG={MSG_T: VALID FALSE,RELEASE FALSE,TYP #NOTIFY,MODUL[] " ",KEY[] " ",PARAM_TYP #VALUE,PARAM[] " ",DLG_FORMAT[] " ",ANSWER 0}
      $MSG_T={MSG_T: VALID FALSE,RELEASE FALSE,TYP #QUIT,MODUL[] "Safety Position",KEY[] "Direction Number Not Valid",PARAM_TYP #KEY,PARAM[] " ",DLG_FORMAT[] " ",ANSWER 0}
      WAIT SEC 1.0
      $MSG_T.VALID=TRUE
      HALT
    UNTIL (DIRECTION<3) AND (DIRECTION>0)
  ENDIF
  IF (AREA_NR>8) OR (AREA_NR<1) THEN
    REPEAT
      EMPTY_MSG={MSG_T: VALID FALSE,RELEASE FALSE,TYP #NOTIFY,MODUL[] " ",KEY[] " ",PARAM_TYP #VALUE,PARAM[] " ",DLG_FORMAT[] " ",ANSWER 0}

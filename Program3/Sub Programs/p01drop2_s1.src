;FOLD PTP P96 Vel=100 % PDAT51 Tool[16]:camara_corregida Base[16]:EMS_SUP_CORREGIDA;%{PE}%R 5.6.13,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P96, 3:, 5:100, 7:PDAT51
$BWDSTART=FALSE
PDAT_ACT=PPDAT51
FDAT_ACT=FP96
BAS(#PTP_PARAMS,100)
PTP XP96 

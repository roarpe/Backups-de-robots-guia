;ACTIVAR TORQ MONITORING
;FOLD TORQMON SetLimits Axis 1: 40 % Axis 2: 35 % Axis 3: 35 % Axis 4: 35 % Axis 5: 40 % Axis 6: 40 %;%{PE}%R 5.6.13,%MKUKATPBASIS,%CTQ_MON,%VTQ_LIMITS,%P 2:TQ_LIMITS, 4:40, 7:35, 10:35, 13:35, 16:40, 19:40

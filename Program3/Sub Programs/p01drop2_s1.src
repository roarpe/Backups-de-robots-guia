$BWDSTART=FALSE
LDAT_ACT=LCPDAT24
FDAT_ACT=FP77C
BAS(#CP_PARAMS,1)
LIN XP77C 
;ENDFOLD


if not B_EMSdry then
;CIERRA CLAMPA
;clampar()
endif

;WAIT SEC 2
CERRAR_DEDOS()

if false then
;CHEQUEA CLAMPA CERRADA
endif

;FOLD WAIT Time=1 sec;%{PE}%R 5.6.13,%MKUKATPBASIS,%CWAIT,%VWAIT,%P 2:1
WAIT SEC 1
;ENDFOLD

;ESPERA RESULTADOS ACIMUT
;FOLD FORDTECH.Tool_Rel 4 ;%{PE}%MKUKATPUSER
TOOL_REL (4)
;ENDFOLD
;FOLD FORDTECH.Tool_Req 4 ;%{PE}%MKUKATPUSER
TOOL_REQ (4)
;ENDFOLD

if not B_EMSdry then
;ABRE GARRA PARA SOLTAR IP
ABRIR_CILINDRO_IP()

endif


if B_EMSdry then
;punto intermedio para liberar orejetas
endif

;MOVIMIENTO SALIDA
;FOLD LIN P78 Vel=2 m/s CPDAT16 Tool[16]:camara_corregida Base[16]:EMS_SUP_CORREGIDA;%{PE}%R 5.6.13,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P78, 3:, 5:2, 7:CPDAT16
$BWDSTART=FALSE
LDAT_ACT=LCPDAT16
FDAT_ACT=FP78
BAS(#CP_PARAMS,2)
LIN XP78 
;ENDFOLD

endif
alejandro:
if i_dry then

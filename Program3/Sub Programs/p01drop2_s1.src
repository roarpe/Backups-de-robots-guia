;FOLD LIN P77a Vel=1 m/s CPDAT21 Tool[16]:camara_corregida Base[16]:EMS_SUP_CORREGIDA;%{PE}%R 5.6.13,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P77a, 3:, 5:1, 7:CPDAT21
$BWDSTART=FALSE
LDAT_ACT=LCPDAT21
FDAT_ACT=FP77a
BAS(#CP_PARAMS,1)
LIN XP77a 
;ENDFOLD
;FOLD LIN P77 Vel=1 m/s CPDAT15 Tool[16]:camara_corregida Base[16]:EMS_SUP_CORREGIDA;%{PE}%R 5.6.13,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P77, 3:, 5:1, 7:CPDAT15
$BWDSTART=FALSE
LDAT_ACT=LCPDAT15
FDAT_ACT=FP77
BAS(#CP_PARAMS,1)
LIN XP77 

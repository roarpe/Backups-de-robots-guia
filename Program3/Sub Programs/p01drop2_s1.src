;FOLD PTP P80 Vel=100 % PDAT35 Tool[14]:camara Base[14]:ems_sup;%{PE}%R 5.6.13,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P80, 3:, 5:100, 7:PDAT35
$BWDSTART=FALSE
PDAT_ACT=PPDAT35
FDAT_ACT=FP80
BAS(#PTP_PARAMS,100)
PTP XP80 
;ENDFOLD


;FOLD WAIT Time=0.3 sec;%{PE}%R 5.6.13,%MKUKATPBASIS,%CWAIT,%VWAIT,%P 2:0.3
WAIT SEC 0.3
;ENDFOLD

;CHEQUEO SEÑALES RESETEADAS
MAFELEC_TECH (#CHECK_RESET, 11,0,0)

;PETICION PRIMERA FOTO
;FOLD FORDTECH.Tool_Rel 2 ;%{PE}%MKUKATPUSER
TOOL_REL (2)
;ENDFOLD

;PETICION RESULTADO FOTO
MAFELEC_TECH (#TYPE, 8,0,0)

;EVALUACION RESULTADO
SWITCH I_TYPE_INFO
CASE 2
o_type_req=FALSE
;FOLD FORDTECH.Tool_Req 2 ;%{PE}%MKUKATPUSER
TOOL_REQ (2)
;ENDFOLD
;wait for false
RECHAZOEMSINF()
goto home
case 3
o_type_req=FALSE
rechazo_bal()
GOTO HOME
ENDSWITCH

;APLICA CORRECCIONES A BASE
base_data[16]=base_data[14]
MAFELEC_TECH (#GET_CORR, 16,0,0)

tool_data[16]=tool_data[14]
;APLICA CORRECCION ANGULO A TOOL
MAFELEC_TECH (#GET_CORR_TOOL,16 ,0,0)

;REGISTRO CORRECCIONES
MAFELEC_TECH (#REG1, 11,0,0)

;FINALIZA PROCESO CORRECCIONES
o_type_req=false
wait for i_type_info==0
;FOLD FORDTECH.Tool_Req 2 ;%{PE}%MKUKATPUSER
TOOL_REQ (2)
;ENDFOLD

;POSICION SEGUNDA FOTO
xP74=xP80
;FOLD PTP P74 Vel=100 % PDAT33 Tool[16]:camara_corregida Base[16]:EMS_SUP_CORREGIDA;%{PE}%R 5.6.13,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P74, 3:, 5:100, 7:PDAT33
$BWDSTART=FALSE
PDAT_ACT=PPDAT33
FDAT_ACT=FP74
BAS(#PTP_PARAMS,100)
PTP XP74 
;ENDFOLD

;FOLD WAIT Time=0.3 sec;%{PE}%R 5.6.13,%MKUKATPBASIS,%CWAIT,%VWAIT,%P 2:0.3
WAIT SEC 0.3
;ENDFOLD

;PIDE SEGUNDA FOTO
;FOLD FORDTECH.Tool_Rel 6 ;%{PE}%MKUKATPUSER
TOOL_REL (6)
;ENDFOLD

;PIDE RESULTADOS SEGUNDA FOTO
MAFELEC_TECH (#TYPE,8 ,0,0)

;EVALUA RESULTADOS FOTO
SWITCH I_TYPE_INFO
CASE 1 ;FOTO OK
o_type_req=false
wait for i_type_info==0
CASE 2
o_type_req=FALSE
;FOLD FORDTECH.Tool_Req 6 ;%{PE}%MKUKATPUSER
TOOL_REQ (6)
;ENDFOLD
RECHAZOEMSINF()
goto home
case 3
o_type_req=FALSE
rechazo_bal()
GOTO HOME
ENDSWITCH

;FINALIZA PROCESO SEGUNDA FOTO
;FOLD FORDTECH.Tool_Req 6 ;%{PE}%MKUKATPUSER
TOOL_REQ (6)
;ENDFOLD


;FOLD CHEQUEO LIMITE SEGUNDO OFFSET

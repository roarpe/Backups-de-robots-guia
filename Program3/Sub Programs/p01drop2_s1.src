;FOLD LIN P99 Vel=2 m/s CPDAT19 Tool[16]:camara_corregida Base[16]:EMS_SUP_CORREGIDA;%{PE}%R 5.6.13,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P99, 3:, 5:2, 7:CPDAT19
$BWDSTART=FALSE
LDAT_ACT=LCPDAT19
FDAT_ACT=FP99
BAS(#CP_PARAMS,2)
LIN XP99 
;ENDFOLD
;ABRE CLAMPA
ABRIR_DEDOS()

;POSICION DEJADA

;FOLD LIN P98 Vel=2 m/s CPDAT18 Tool[16]:camara_corregida Base[16]:EMS_SUP_CORREGIDA;%{PE}%R 5.6.13,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P98, 3:, 5:2, 7:CPDAT18
$BWDSTART=FALSE
LDAT_ACT=LCPDAT18
FDAT_ACT=FP98
BAS(#CP_PARAMS,2)
LIN XP98 

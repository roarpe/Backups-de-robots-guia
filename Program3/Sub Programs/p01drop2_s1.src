DEF p01drop2_s1( )

;================================================
; MODELO   : BALANCINA VIEJA 
; IE GRUPO : FIP
; ESTACION : ST101
; ROBOT    : 101R1
; FUNCION  : DROP IP
;================================================

;FOLD INI
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
;FOLD SPOTTECH INI
;USERSPOT(#INIT)
;ENDFOLD (SPOTTECH INI)
;FOLD GRIPPERTECH INI
USER_GRP(0,DUMMY,DUMMY,GDEFAULT)
INTERRUPT DECL 20 WHEN $FLAG[20]==FALSE DO GRPS(#MON_ERR,20) 

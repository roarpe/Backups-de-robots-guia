;POS FINAL ANTERIOR
;FOLD LIN p77b Vel=1 m/s CPDAT22 Tool[16]:camara_corregida Base[16]:EMS_SUP_CORREGIDA;%{PE}%R 5.6.13,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:p77b, 3:, 5:1, 7:CPDAT22

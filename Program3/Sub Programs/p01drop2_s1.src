;CERRAR_DEDOS()
;ENTRAR_RODILLO()
;ABRIR_CILINDRO_IP()
;CLAMPAR_GONDOLA()
o_type_req=FALSE

;wait position

;INICIALIZACION GRIPER

;FOLD PTP P70 Vel=100 % PDAT29 Tool[13] Base[0];%{PE}%R 5.6.13,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P70, 3:, 5:100, 7:PDAT29
$BWDSTART=FALSE

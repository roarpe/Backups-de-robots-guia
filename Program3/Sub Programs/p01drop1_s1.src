MAFELEC_TECH (#CHECK_RESET, 8,0,0)

;PIDE FOTO
;FOLD FORDTECH.Tool_Rel 2 ;%{PE}%MKUKATPUSER
TOOL_REL (2)
;ENDFOLD

;PIDE CORRECCIONES
MAFELEC_TECH (#TYPE, 8,0,0)

;EVALUA CORRECCIONES
SWITCH I_TYPE_INFO
CASE 2
o_type_req=FALSE
;FOLD FORDTECH.Tool_Req 2 ;%{PE}%MKUKATPUSER
TOOL_REQ (2)
;ENDFOLD
RECAZOEMS()
goto home
case 3
o_type_req=FALSE
rechazo_bal()
GOTO HOME
ENDSWITCH

;APLICA CORRECIONES A LA BASE
base_data[16]=base_data[14]
MAFELEC_TECH (#GET_CORR, 16,0,0)

tool_data[16]=tool_data[14]
;APLICA CORRECCION ANGULO A TOOL
MAFELEC_TECH (#GET_CORR_TOOL,16 ,0,0)

;REGISTRA CORRECCIONES
MAFELEC_TECH (#REG1, 8,0,0)

;FINALIZA PROCESO CORRECCIONES
o_type_req=false
wait for i_type_info==0
;FOLD FORDTECH.Tool_Req 2 ;%{PE}%MKUKATPUSER
TOOL_REQ (2)
;ENDFOLD

;PUNTO SEGUNA FOTO
xP76=xP85
;FOLD PTP P76 Vel=100 % PDAT21 Tool[16]:camara_corregida Base[16]:EMS_SUP_CORREGIDA;%{PE}%R 5.6.13,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P76, 3:, 5:100, 7:PDAT21
$BWDSTART=FALSE

WAIT SEC 0.3
;ENDFOLD

;PETICION SEGUNDA FOTO
;FOLD FORDTECH.Tool_Rel 6 ;%{PE}%MKUKATPUSER
TOOL_REL (6)
;ENDFOLD

;PETICION RESULTADO FOTO
MAFELEC_TECH (#TYPE, 8,0,0)

;EVALUA RESULTADO
SWITCH I_TYPE_INFO
CASE 1 ;FOTO OK
o_type_req=false
wait for i_type_info==0
CASE 2
o_type_req=FALSE
;FOLD FORDTECH.Tool_Req 6 ;%{PE}%MKUKATPUSER
TOOL_REQ (6)
;ENDFOLD
;wait for false
RECAZOEMS()
GOTO HOME
case 3
o_type_req=FALSE
rechazo_bal()
goto home
ENDSWITCH

;FINALIZA PROCESO SEGUNDA FOTO
;FOLD FORDTECH.Tool_Req 6 ;%{PE}%MKUKATPUSER
TOOL_REQ (6)
;ENDFOLD

if not i_dry then


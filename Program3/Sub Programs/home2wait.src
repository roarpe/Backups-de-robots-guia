;FOLD WAIT FOR ( NOT IN 65 '201S161A dedos fuera izq' AND IN 66 '201S161B dedos dentro izq' AND NOT IN 97 '201S162A dedos fuera drch' AND IN 98 '201S162B dedos atras drch' ) CONT;%{PE}%R 5.6.13,%MKUKATPBASIS,%CEXT_WAIT_FOR,%VEXT_WAIT_FOR,%P 2:, 4:NOT, 5:$IN, 6:65, 7:201S161A dedos fuera izq, 8:AND, 9:, 10:$IN, 11:66, 12:201S161B dedos dentro izq, 13:AND, 14:NOT, 15:$IN, 16:97, 17:201S162A dedos fuera drch, 18:AND, 19:, 20:$IN, 21:98, 22:201S162B dedos atras drch, 24:CONTINUE
CONTINUE

&ACCESS RV1
&COMMENT STARTDRESS EXTERNAL GUN 1
DEF strdress1OLD( )
;================================================
; MODEL    : 
; IE GROUP : 
; STATION  : 
; ROBOT    : 
; FUNCTION : STARTDRESS EXTERNAL GUN 1
;================================================
;FOLD INI
;FOLD BASISTECH INI
GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
INTERRUPT ON 3
BAS (#INITMOV,0 )
;ENDFOLD (BASISTECH INI)
;FOLD SPOTTECH INI
USERSPOT(#INIT)
;ENDFOLD (SPOTTECH INI)
;FOLD GRIPPERTECH INI
USER_GRP(0,DUMMY,DUMMY,GDEFAULT)
;ENDFOLD (GRIPPERTECH INI)
;FOLD USER INI
;Make your modifications here
;ENDFOLD (USER INI)
;ENDFOLD (INI)

; Reset fin de vida electrodo 1
O_ENDOFLIFE1 = FALSE

pgno1_type=0

;FOLD PTP P10 H RETR OPN Gun= 1 Pair= FIRST Tool[14]:C520 LH Con/Sin Pieza Base[0];%{PE}%R 6.1.2,%MKUKATPSPOT,%CRETR,%VPTP,%P 1:PTP, 2:P10, 3:, 5:100, 7:H, 9:#OPN, 11:1, 13:#FIRST
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP10
BAS(#PTP_PARAMS,PH.VEL)
S_ACT.GUN=1
S_ACT.PAIR=#FIRST
S_ACT.RETR=#OPN
S_READY=FALSE
TRIGGER WHEN DISTANCE=1 DELAY=0.0 DO USERSPOT(#RETR, S_ACT) PRIO=-1
PTP XP10
WAIT FOR S_READY
;ENDFOLD

;FOLD TDRESS.Swing_Forward 1 ;%{PE}%MKUKATPUSER
B_TDRESS=TDRESS (#SW_FWD ,1)
;ENDFOLD

;FOLD WAIT Time=1.5 sec;%{PE}%R 5.6.13,%MKUKATPBASIS,%CWAIT,%VWAIT,%P 2:1.5
WAIT SEC 1.5
;ENDFOLD

REPEAT


;FOLD TDRESS.Select_Active_Electrode 1 ;%{PE}%MKUKATPUSER
B_TDRESS=TDRESS (#TD_SEL ,1)
;ENDFOLD

pgno1_type=0
PGNO1=61

;FOLD TDRESS.Start_Cutter_Gun 1 ;%{PE}%MKUKATPUSER
B_TDRESS=TDRESS (#TD_START ,1)
;ENDFOLD

;FOLD TDRESS.Start_Count_Rotations 1 ;%{PE}%MKUKATPUSER
B_TDRESS=TDRESS (#CNT_STRT ,1)
;ENDFOLD

;FOLD CLOSE GUN 1 (6 TIMES) AND CHECK
$ADVANCE=0

FOR I=1 TO  6
CLOSEGUN (1 )

WAIT SEC 0.7

OPENGUN (1 )
ENDFOR
$ADVANCE=3
;endfold

;FOLD TDRESS.Stop_Count_Rotations 1 ;%{PE}%MKUKATPUSER
B_TDRESS=TDRESS (#CNT_STOP ,1)
;ENDFOLD

;FOLD TDRESS.Check_Rotations_Gun 1 Amount Of Rotations , 5 ;%{PE}%MKUKATPUSER
B_TDRESS=TDRESS (#CNT_CHK ,1, 5)
;ENDFOLD

UNTIL B_TDRESS==TRUE

;OPEN ARM OF THE DRESS

;FOLD TDRESS.Swing_Backward 1 ;%{PE}%MKUKATPUSER
B_TDRESS=TDRESS (#SW_BWD ,1)
;ENDFOLD

;FOLD TDRESS.Reset_Stepper_Timer 1  Gun nr, 1 ;%{PE}%MKUKATPUSER
B_TDRESS=TDRESS (#TD_RES_STP ,1, 1)
;ENDFOLD

;FOLD PTP Best_Praktisch H SPOT Gun= 1 Pair= FIRST RETR OPN INDEX1= 60 INDEX2= 1 Tool[14]:C520 Sin Pieza Base[0];%{PE}%R 6.1.2,%MKUKATPSPOT,%CSPOT,%VPTP,%P 1:PTP, 2:Best_Praktisch, 3:, 5:100, 7:H, 10:1, 12:#FIRST, 14:#OPN, 16:60, 18:1, 20:0, 22:0, 24:0, 25:SDAT3
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FBest_Praktisch
BAS(#PTP_PARAMS,PH.VEL)
S_ACT.GUN=1
S_ACT.PAIR=#FIRST
S_ACT.RETR=#OPN
S_ACT.CLO_TM=SDEFAULT.CLO_TM
S_ACT.PGNO1=60
S_ACT.PGNO2=1
S_ACT.PRESS1=SDEFAULT.PRESS1
S_ACT.PRESS2=SDEFAULT.PRESS2
S_READY=FALSE
USERSPOT(#ADVSPOT, S_ACT)
TRIGGER WHEN DISTANCE=1 DELAY=SDEFAULT.CLO_TM DO USERSPOT(#PRESPOT, S_ACT) PRIO=-1
TRIGGER WHEN DISTANCE=1 DELAY=0.0 DO USERSPOT(#SPOT, S_ACT) PRIO=-1
PTP XBest_Praktisch
WAIT FOR S_READY
;ENDFOLD


END

;FOLD SETOUTPUT - SETS OUTPUT IF CONDITIONS ARE OK
DEF  SETOUTPUT (NR :IN,STATE :IN )
;************************************************************
;Function:  sets if to state value
;************************************************************
INT NR
BOOL STATE

IF (NR<>0) THEN
IF (NR>0) THEN
CONTINUE
$OUT[NR]=STATE
ELSE
CONTINUE
$OUT[-NR]= NOT STATE
ENDIF
ENDIF
END ;SetOutput
;ENDFOLD

;FOLD CHKINPUT - CHECKS INPUT <1 & RETURNS INPUT VALUE
DEFFCT  BOOL CHKINPUT(NR :IN,STATE :IN)
;************************************************************
;Function: checks if input nr<1 and returns input value
;************************************************************
INT NR
BOOL STATE

IF (NR<>0) THEN
IF (NR>0) THEN
RETURN  ($IN[NR]==STATE)
ELSE
RETURN  ($IN[-NR]==STATE)
ENDIF
ELSE
RETURN  (TRUE)
ENDIF
ENDFCT ; ChkInput
;ENDFOLD

;FOLD TIMEOUT - WAITS FOR CONDITION WITH TIMEOUT
DEFFCT  BOOL TIMEOUT(CONDITION :OUT,STATE :IN,MAXTIME :IN)
;************************************************************
;Function: waits for condition with timeout
;************************************************************
BOOL CONDITION
BOOL STATE
REAL MAXTIME

$TIMER[5]=-MAXTIME*1000
$TIMER_STOP[5]=FALSE
WHILE  (CONDITION<>STATE) AND  NOT ($TIMER_FLAG[5])
ENDWHILE
RETURN  ($TIMER_FLAG[5])
ENDFCT ; of TimeOut
;ENDFOLD

;FOLD CLOSEGUN - CLOSES WELDGUN BEFORE WELDING
DEF  CLOSEGUN (MYGUN :IN )
;************************************************************
;Function: closes and checks a gun
;************************************************************
INT MYGUN

SETOUTPUT (GRIPPER[MYGUN].OUT2,FALSE )
PULSE ($OUT[GRIPPER[MYGUN].OUT1],TRUE,0.2)
$TIMER[5]=-WAITTIME*1000
$TIMER_STOP[5]=FALSE
WHILE  ((CHKINPUT(GRIPPER[MYGUN].IN1,TRUE) AND CHKINPUT(GRIPPER[MYGUN].IN2,FALSE) AND CHKINPUT(GRIPPER[MYGUN].IN3,FALSE))<>TRUE) AND  NOT ($TIMER_FLAG[5])
ENDWHILE
IF ($TIMER_FLAG[5]) THEN
ERROR_DCP=TRUE
$MSG_T.RELEASE=FALSE
EMPTY_MSG={MSG_T: VALID FALSE,RELEASE FALSE,TYP #NOTIFY,MODUL[] " ",KEY[] " ",PARAM_TYP #VALUE,PARAM[] " ",DLG_FORMAT[] " ",ANSWER 0}
$MSG_T.TYP=#STATE
$MSG_T.KEY[]="Prestroke not closed        "
$MSG_T.VALID=TRUE
WAIT FOR  (($IN[GRIPPER[MYGUN].IN1]==TRUE) AND ($IN[GRIPPER[MYGUN].IN2]==FALSE) AND ($IN[GRIPPER[MYGUN].IN3]==FALSE))
$MSG_T.RELEASE=TRUE
WHILE $MSG_T.VALID
ENDWHILE
ERROR_DCP=FALSE
ENDIF

SETOUTPUT (GRIPPER[MYGUN].OUT3,TRUE )
SETOUTPUT (GRIPPER[MYGUN].OUT4,TRUE )
$TIMER[5]=-WAITTIME*1000
$TIMER_STOP[5]=FALSE
WHILE  ((CHKINPUT(GRIPPER[MYGUN].IN1,FALSE) AND CHKINPUT(GRIPPER[MYGUN].IN2,FALSE) AND CHKINPUT(GRIPPER[MYGUN].IN3,TRUE))<>TRUE) AND  NOT ($TIMER_FLAG[5])
ENDWHILE
IF ($TIMER_FLAG[5]) THEN
ERROR_DCP=TRUE
$MSG_T.RELEASE=FALSE
EMPTY_MSG={MSG_T: VALID FALSE,RELEASE FALSE,TYP #NOTIFY,MODUL[] " ",KEY[] " ",PARAM_TYP #VALUE,PARAM[] " ",DLG_FORMAT[] " ",ANSWER 0}
$MSG_T.TYP=#STATE
$MSG_T.KEY[]="Weldstroke not closed              "
$MSG_T.VALID=TRUE
WAIT FOR  (($IN[GRIPPER[MYGUN].IN1]==FALSE) AND ($IN[GRIPPER[MYGUN].IN2]==FALSE) AND ($IN[GRIPPER[MYGUN].IN3]==TRUE))
$MSG_T.RELEASE=TRUE
WHILE $MSG_T.VALID
ENDWHILE
ERROR_DCP=FALSE
ENDIF

END ;CLOSEGUN

;ENDFOLD

;FOLD OPENGUN - OPENS GUN FULLY AFTER WELDING
DEF  OPENGUN (MYGUN :IN )
;************************************************************
;Function: opens and checks a gun
;************************************************************
INT MYGUN
INT ANSWER

SETOUTPUT (GRIPPER[MYGUN].OUT3,FALSE )
SETOUTPUT (GRIPPER[MYGUN].OUT4,FALSE )
SETOUTPUT (GRIPPER[MYGUN].OUT1,FALSE )
PULSE ($OUT[GRIPPER[MYGUN].OUT2],TRUE,0.2)
$TIMER[5]=-WAITTIME*1000
$TIMER_STOP[5]=FALSE
WHILE  ((CHKINPUT(GRIPPER[MYGUN].IN1,FALSE) AND CHKINPUT(GRIPPER[MYGUN].IN2,TRUE) AND CHKINPUT(GRIPPER[MYGUN].IN3,FALSE))<>TRUE) AND  NOT ($TIMER_FLAG[5])
ENDWHILE
IF ($TIMER_FLAG[5]) THEN
ERROR_DCP=TRUE
$MSG_T.RELEASE=FALSE
EMPTY_MSG={MSG_T: VALID FALSE,RELEASE FALSE,TYP #NOTIFY,MODUL[] " ",KEY[] " ",PARAM_TYP #VALUE,PARAM[] " ",DLG_FORMAT[] " ",ANSWER 0}
$MSG_T.TYP=#STATE
$MSG_T.KEY[]="Prestroke not open                 "
$MSG_T.VALID=TRUE
WAIT FOR  (($IN[GRIPPER[MYGUN].IN1]==FALSE) AND ($IN[GRIPPER[MYGUN].IN2]==TRUE) AND ($IN[GRIPPER[MYGUN].IN3]==FALSE))
$MSG_T.RELEASE=TRUE
WHILE $MSG_T.VALID
ENDWHILE
ERROR_DCP=FALSE
ENDIF

END ;OPENGUN
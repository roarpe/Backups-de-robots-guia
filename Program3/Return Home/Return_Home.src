&ACCESS RVP13
&REL 42
&COMMENT Return to Home V3.0 Date:12/10/2010
DEF RETURN_HOME (AREA_NR :IN,RETHME_IN :IN)
;================================================
; MODELO   : C-520
; IE GRUPO : 5J
; ESTACION : 85
; ROBOT    : 85r01
; FUNCTION : Return To Home Position
;================================================
;FOLD INI
  INT AREA_NR
  INT RETHME_IN
  
  IF RETHME_IN==0 THEN
    REPEAT
      EMPTY_MSG={MSG_T: VALID FALSE,RELEASE FALSE,TYP #NOTIFY,MODUL[] " ",KEY[] " ",PARAM_TYP #VALUE,PARAM[] " ",DLG_FORMAT[] " ",ANSWER 0}
      $MSG_T={MSG_T: VALID FALSE,RELEASE FALSE,TYP #QUIT,MODUL[] "Return To Home",KEY[] "Return to waitpos path not configured !!!",PARAM_TYP #KEY,PARAM[] " ",DLG_FORMAT[] " ",ANSWER 0}
      WAIT SEC 1.0
      $MSG_T.VALID=TRUE
      HALT
    UNTIL (RETHME_IN<2) AND (RETHME_IN>0)
  ENDIF  
  
  IF (AREA_NR>8) OR (AREA_NR<1) THEN
    REPEAT
      EMPTY_MSG={MSG_T: VALID FALSE,RELEASE FALSE,TYP #NOTIFY,MODUL[] " ",KEY[] " ",PARAM_TYP #VALUE,PARAM[] " ",DLG_FORMAT[] " ",ANSWER 0}
      $MSG_T={MSG_T: VALID FALSE,RELEASE FALSE,TYP #QUIT,MODUL[] "Return To Home",KEY[] "Area Number Not Valid",PARAM_TYP #KEY,PARAM[] " ",DLG_FORMAT[] " ",ANSWER 0}
      WAIT SEC 1.0
      $MSG_T.VALID=TRUE
      HALT
    UNTIL (AREA_NR<9) AND (AREA_NR>0)
  ENDIF
  ;ENDFOLD
  
;================================================
  
SWITCH AREA_NR
      
CASE 1  ;AREA 1
    
;Teach here positions from wait area to Waitpos
;check robot movement for collision with other robots

;FOLD PTP P0 CONT Vel=15 % PDAT0 Tool[0] Base[0];%{PE}%R 5.6.13,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P0, 3:C_PTP, 5:15, 7:PDAT0
$BWDSTART=FALSE
PDAT_ACT=PPDAT0
FDAT_ACT=FP0
BAS(#PTP_PARAMS,15)
PTP XP0 C_PTP
;ENDFOLD
;FOLD PTP PP31 Vel=15 % PDAT1 Tool[1]:weld Base[0];%{PE}%R 5.6.13,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:PP31, 3:, 5:15, 7:PDAT1
$BWDSTART=FALSE
PDAT_ACT=PPDAT1
FDAT_ACT=FPP31
BAS(#PTP_PARAMS,15)
PTP XPP31 
;ENDFOLD
;FOLD PTP P1 Vel=100 % PDAT2 Tool[1]:weld Base[0];%{PE}%R 5.6.13,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P1, 3:, 5:100, 7:PDAT2
$BWDSTART=FALSE
PDAT_ACT=PPDAT2
FDAT_ACT=FP1
BAS(#PTP_PARAMS,100)
PTP XP1 
;ENDFOLD
;FOLD PTP P2 Vel=100 % PDAT3 Tool[1]:weld Base[0];%{PE}%R 5.6.13,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P2, 3:, 5:100, 7:PDAT3
$BWDSTART=FALSE
PDAT_ACT=PPDAT3
FDAT_ACT=FP2
BAS(#PTP_PARAMS,100)
PTP XP2 
;ENDFOLD
;FOLD PTP P3 Vel=100 % PDAT4 Tool[1]:weld Base[0];%{PE}%R 5.6.13,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P3, 3:, 5:100, 7:PDAT4
$BWDSTART=FALSE
PDAT_ACT=PPDAT4
FDAT_ACT=FP3
BAS(#PTP_PARAMS,100)
PTP XP3 
;ENDFOLD
;FOLD PTP P4 Vel=100 % PDAT5 Tool[1]:weld Base[0];%{PE}%R 5.6.13,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P4, 3:, 5:100, 7:PDAT5
$BWDSTART=FALSE
PDAT_ACT=PPDAT5
FDAT_ACT=FP4
BAS(#PTP_PARAMS,100)
PTP XP4 
;ENDFOLD
;Delete if movement is used 

CASE 2  ;AREA 2
    
;Teach here positions from wait area to Waitpos
;check robot movement for collision with other robots

;Delete if movement is used 
WAIT FOR FALSE

CASE 3  ;AREA 3
    
;Teach here positions from wait area to Waitpos
;check robot movement for collision with other robots

;Delete if movement is used 
WAIT FOR FALSE

CASE 4  ;AREA 4
    
;Teach here positions from wait area to Waitpos
;check robot movement for collision with other robots

;Delete if movement is used 
WAIT FOR FALSE

CASE 5  ;AREA 5
    
;Teach here positions from wait area to Waitpos
;check robot movement for collision with other robots

;Delete if movement is used 
WAIT FOR FALSE

CASE 6  ;AREA 6
    
;Teach here positions from wait area to Waitpos
;check robot movement for collision with other robots

;Delete if movement is used 
WAIT FOR FALSE

CASE 7  ;AREA 7
    
;Teach here positions from wait area to Waitpos
;check robot movement for collision with other robots

;Delete if movement is used 
WAIT FOR FALSE

CASE 8  ;AREA 8
    
;Teach here positions from wait area to Waitpos
;check robot movement for collision with other robots

;Delete if movement is used 
WAIT FOR FALSE

DEFAULT
    REPEAT
      EMPTY_MSG={MSG_T: VALID FALSE,RELEASE FALSE,TYP #NOTIFY,MODUL[] " ",KEY[] " ",PARAM_TYP #VALUE,PARAM[] " ",DLG_FORMAT[] " ",ANSWER 0}
      $MSG_T={MSG_T: VALID FALSE,RELEASE FALSE,TYP #QUIT,MODUL[] "Return To Waitpos",KEY[] "Area Number Not Valid",PARAM_TYP #KEY,PARAM[] " ",DLG_FORMAT[] " ",ANSWER 0}
      WAIT SEC 1.0
      $MSG_T.VALID=TRUE
      HALT
    UNTIL (AREA_NR<9) AND (AREA_NR>0)
ENDSWITCH
END
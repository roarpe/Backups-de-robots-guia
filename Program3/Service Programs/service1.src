;FOLD PTP p27 Vel=75 % H Tool[0] Base[0];%{PE}%R 5.6.13,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p27, 3:, 5:75, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=Fp27
BAS(#PTP_PARAMS,75)

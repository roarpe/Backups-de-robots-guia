$BWDSTART=FALSE
LDAT_ACT=LM2
FDAT_ACT=FP3
BAS(#CP_PARAMS,0.1)
LIN XP3 C_DIS C_DIS
;ENDFOLD
;FOLD LIN P4 CONT Vel=0.1 m/s M2 Tool[1]:T_PUSH1 Base[2]:Rack_Azul;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P4, 3:C_DIS C_DIS, 5:0.1, 7:M2
$BWDSTART=FALSE
LDAT_ACT=LM2
FDAT_ACT=FP4
BAS(#CP_PARAMS,0.1)
LIN XP4 C_DIS C_DIS
;ENDFOLD

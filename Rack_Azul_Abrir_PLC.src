PDAT_ACT=PH
FDAT_ACT=FP10
BAS(#PTP_PARAMS,100)
PTP XP10 C_DIS
;ENDFOLD

$TIMER_STOP[6]=TRUE
END
DEF Paro()
INTERRUPT OFF 21
INTERRUPT OFF 22
INTERRUPT OFF 23
INTERRUPT OFF 24
INTERRUPT OFF 25

IF I_Rack2_S1 THEN
INTERRUPT_ACTV=FALSE
ELSE
INTERRUPT_ACTV=TRUE
ENDIF

BRAKE

WAIT SEC 0

PTP $POS_ACT
LIN $POS_INT

$OV_PRO=OLD_OVPRO

O_TREQ_3=TRUE
WAIT FOR I_TRDY_3
O_TREQ_3=FALSE

; TRABAJO REALIZADO
O_JRDY_5=TRUE

RESUME

END
DEF STOP_PUSH ()
INTERRUPT OFF 81
INTERRUPT OFF 82
BRAKE
PTP $POS_ACT
LIN_REL{Z -50}
WAIT SEC 0.5
WAIT FOR (NOT I_121R1S501) AND (NOT I_121R1S502)
LIN_REL{Z 50}
PTP $POS_ACT
;RESUME
END
DEF MOVS_APERTURA()
REINT_APERTURA=FALSE
INTERRUPT OFF 81
INTERRUPT OFF 82
INTERRUPT ON 86
INTERRUPT ON 87


;FOLD LIN P510 CONT Vel=0.5 m/s M Tool[1]:T_PUSH1 Base[2]:Rack_Azul;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P510, 3:C_DIS C_DIS, 5:0.5, 7:M
$BWDSTART=FALSE
LDAT_ACT=LM
FDAT_ACT=FP510
BAS(#CP_PARAMS,0.5)
LIN XP510 C_DIS C_DIS
;ENDFOLD
;FOLD LIN Ini_Abrir_B5 Vel=0.5 m/s M Tool[1]:T_PUSH1 Base[2]:Rack_Azul;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:Ini_Abrir_B5, 3:, 5:0.5, 7:M
$BWDSTART=FALSE

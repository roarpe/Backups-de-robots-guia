;ENDFOLD

;FOLD PTP P10 CONT Vel=100 % H Tool[1]:T_PUSH1 Base[2]:Rack_Azul;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P10, 3:C_DIS, 5:100, 7:H

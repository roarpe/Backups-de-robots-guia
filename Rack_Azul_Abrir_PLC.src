FINALIZA_AZUL=FALSE
;FOLD ACTIVA BUSQUEDA APERTURA BANDEJA 5
INTERRUPT ON 25
OLD_OVPRO=$OV_PRO
$ADVANCE=0
;ENDFOLD
WAIT FOR I_Rack2_S5==FALSE
WAIT FOR I_RackAzul_Pin5B

$advance=2

MOVS_APERTURA()
IF REINT_APERTURA==TRUE THEN
   MOV_NEW_REINT()
ENDIF


$advance=0

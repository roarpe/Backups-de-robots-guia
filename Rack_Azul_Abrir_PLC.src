&ACCESS RVO1
&REL 29
&COMMENT ABRIR BAND RACK AZUL
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\Program\MAFELEC
DEF Rack_Azul_Abrir_PLC( )
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
;FOLD SPOTTECH INI
USERSPOT(#INIT)
;ENDFOLD (SPOTTECH INI)
;FOLD GRIPPERTECH INI
USER_GRP(0,DUMMY,DUMMY,GDEFAULT)
;ENDFOLD (GRIPPERTECH INI)
  ;FOLD USER INI
    ;Make your modifications here
INTERRUPT DECL 21 WHEN I_Rack2_S1 DO Paro()
INTERRUPT DECL 22 WHEN I_Rack2_S2 DO Paro()
INTERRUPT DECL 23 WHEN I_Rack2_S3 DO Paro()
INTERRUPT DECL 24 WHEN I_Rack2_S4 DO Paro()
INTERRUPT DECL 25 WHEN I_Rack2_S5 DO Paro()
INTERRUPT DECL 81 WHEN I_121R1S501 DO STOP_PUSH ()
INTERRUPT DECL 82 WHEN I_121R1S502 DO STOP_PUSH ()
O_TYPE_INFO=0

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)
;################################################
; PROYECTO: MAFELEC PLANTA DE BATERIAS
; ROBOT: 121_R1
; PROGRAMA: APERTURA DE BANDEJAS EN RACK AZUL
; CREADO POR: Su Majestad Felipe VI(zaisor robotics)
; FECHA: 23-NOVIEMBRE-2022
; MODIFICADO POR:
; FECHA MODIFICACION: 18-ENERO-2023
;################################################

Empujador(1,"A",FALSE)
Empujador(2,"R",FALSE)

; POSICION DE ESPERA ENTRADA RACK 2 (AZUL)
;FOLD PTP POS_ESPERA_AREA2 Vel=100 % H Tool[9]:T_Gripper1_Vacio Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:POS_ESPERA_AREA2, 3:, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FPOS_ESPERA_AREA2
BAS(#PTP_PARAMS,100)
PTP XPOS_ESPERA_AREA2 
;ENDFOLD

$TIMER[6]=0
$TIMER_STOP[6]=FALSE

;ESPERA AREA 2
WAIT FOR I_ARDY_2
O_AREL_2=FALSE

WAIT FOR I_121R1S1000==FALSE
;INTERRUPT ON 81
;INTERRUPT ON 91

;FOLD PTP P_ABRIR10 CONT Vel=100 % H Tool[9]:T_Gripper1_Vacio Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P_ABRIR10, 3:C_DIS, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP_ABRIR10
BAS(#PTP_PARAMS,100)
PTP XP_ABRIR10 C_DIS
;ENDFOLD

;FOLD PTP P10 Vel=100 % H Tool[1]:T_PUSH1 Base[2]:Rack_Azul;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P10, 3:, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP10
BAS(#PTP_PARAMS,100)
PTP XP10 
;ENDFOLD

Empujador(1,"A",TRUE)
Empujador(2,"R",TRUE)

Repite:
Abrir_Bandejas ()

IF INTERRUPT_ACTV THEN
PTP $POS_ACT
GOTO Repite
ENDIF

;FOLD PTP P10 Vel=100 % H Tool[1]:T_PUSH1 Base[2]:Rack_Azul;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P10, 3:, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP10
BAS(#PTP_PARAMS,100)
PTP XP10 
;ENDFOLD

; TRABAJO REALIZADO
O_JRDY_2=TRUE

IF FINALIZA_AZUL==FALSE THEN
O_TYPE_RQ=TRUE
WAIT FOR I_TYPE_INFO==1
ENDIF

O_TYPE_RQ=FALSE

Empujador(1,"R",FALSE)
Empujador(2,"R",FALSE)

; POSICION DE SALIDA RACK 2 (AZUL)
;FOLD PTP POS_AREA2_LIBRE Vel=100 % H Tool[9]:T_Gripper1_Vacio Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:POS_AREA2_LIBRE, 3:, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FPOS_AREA2_LIBRE
BAS(#PTP_PARAMS,100)
PTP XPOS_AREA2_LIBRE 
;ENDFOLD
O_AREL_2=TRUE
Empujador(1,"R",TRUE)
Empujador(2,"R",TRUE)

;FOLD PTP P_aHOME CONT Vel=100 % H Tool[9]:T_Gripper1_Vacio Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P_aHOME, 3:C_DIS, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FP_aHOME
BAS(#PTP_PARAMS,100)
PTP XP_aHOME C_DIS
;ENDFOLD
INTERRUPT OFF 81
INTERRUPT OFF 82

END
DEF Abrir_Bandejas ()

INI_BUCLE:
PTP $POS_ACT
INTERRUPT_ACTV=FALSE

INTERRUPT DECL 86 WHEN I_121R1S501 DO INT_6970 ()
INTERRUPT DECL 87 WHEN I_121R1S502 DO INT_6970 ()
INTERRUPT DECL 88 WHEN I_121R1S501 DO STOP_INT_REINT()
INTERRUPT DECL 89 WHEN I_121R1S502 DO STOP_INT_REINT()
INTERRUPT OFF 86
INTERRUPT OFF 87
INTERRUPT OFF 88
INTERRUPT OFF 89

IF TORQ_HAB THEN
;FOLD TORQMON SetLimits Axis1: 50 % Axis2: 50 % Axis3: 50 % Axis4: 50 % Axis5: 50 % Axis6: 50 %;%{PE}%R 8.3.48,%MKUKATPBASIS,%CTQ_MON,%VTQ_LIMITS,%P 2:TQ_LIMITS, 4:50, 7:50, 10:50, 13:50, 16:50, 19:50
SET_TQ_VALUES (50,50,50,50,50,50)
;ENDFOLD
ENDIF

O_TYPE_RQ=FALSE
WAIT FOR I_TYPE_INFO==0

O_TYPE_RQ=TRUE
WAIT FOR (I_TYPE_INFO > 0) AND (I_TYPE_INFO < 26)
RA_Bandeja_Nr=I_TYPE_INFO
O_TYPE_INFO=I_TYPE_INFO

;PETICION APERTURA BANDEJAS EN RACK 2 (AZUL)
SWITCH RA_Bandeja_Nr ; 

CASE 1
O_TYPE_RQ=FALSE
FINALIZA_AZUL=TRUE
;FOLD LIN POS_ESCAPE Vel=1 m/s H Tool[2]:T_PUSH2 Base[2]:Rack_Azul;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:POS_ESCAPE, 3:, 5:1, 7:H
$BWDSTART=FALSE

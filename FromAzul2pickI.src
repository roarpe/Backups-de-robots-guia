&ACCESS RVO
&REL 11
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF FromAzul2pickI( )
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
;FOLD SPOTTECH INI
USERSPOT(#INIT)
;ENDFOLD (SPOTTECH INI)
;FOLD GRIPPERTECH INI
USER_GRP(0,DUMMY,DUMMY,GDEFAULT)
;ENDFOLD (GRIPPERTECH INI)
  ;FOLD USER INI
    ;Make your modifications here
INTERRUPT DECL 26 WHEN I_121R1S102 OR I_121R1S202 DO PARO_RAPIDO ()
INTERRUPT DECL 27 WHEN I_121R1S302 OR I_121R1S402 DO PARO_RAPIDO ()

  ;ENDFOLD (USER INI)
  ;ENDFOLD (INI)
  
$out[17]=false  
;FOLD PTP P8 Vel=20 % PDAT5 Tool[1]:T_PUSH1 Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P8, 3:, 5:20, 7:PDAT5
$BWDSTART=FALSE
PDAT_ACT=PPDAT5
FDAT_ACT=FP8
BAS(#PTP_PARAMS,20)
PTP XP8 
;ENDFOLD
;FOLD PTP P9 Vel=20 % PDAT6 Tool[1]:T_PUSH1 Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P9, 3:, 5:20, 7:PDAT6
$BWDSTART=FALSE
PDAT_ACT=PPDAT6
FDAT_ACT=FP9
BAS(#PTP_PARAMS,20)
PTP XP9 
;ENDFOLD
;FOLD PTP P10 Vel=20 % PDAT7 Tool[1]:T_PUSH1 Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P10, 3:, 5:20, 7:PDAT7
$BWDSTART=FALSE
PDAT_ACT=PPDAT7
FDAT_ACT=FP10
BAS(#PTP_PARAMS,20)
PTP XP10 
;ENDFOLD

; FOLD ACTIVA VIGILANCIA SOBREPASO
INTERRUPT ON 26
INTERRUPT ON 27
;ENDFOLD

;FOLD LIN P11 Vel=0.1 m/s CPDAT3 Tool[1]:T_PUSH1 Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P11, 3:, 5:0.1, 7:CPDAT3
$BWDSTART=FALSE
LDAT_ACT=LCPDAT3
FDAT_ACT=FP11
BAS(#CP_PARAMS,0.1)
LIN XP11 
;ENDFOLD

PINES("R")


;FOLD LIN P12 Vel=0.1 m/s CPDAT4 Tool[1]:T_PUSH1 Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P12, 3:, 5:0.1, 7:CPDAT4
$BWDSTART=FALSE
LDAT_ACT=LCPDAT4
FDAT_ACT=FP12
BAS(#CP_PARAMS,0.1)
LIN XP12 
;ENDFOLD

;CONTROL DE AUSENCIA DE PIEZA EN GRIPPER
;IF (I_SIMULACION==FALSE) THEN
IF I_121R1S1000 THEN
HALT
ENDIF
;ENDIF

; FOLD FIN VIGILANCIA SOBREPASO
INTERRUPT OFF 26
INTERRUPT OFF 27
;ENDFOLD

;FOLD PTP P13 Vel=20 % PDAT8 Tool[1]:T_PUSH1 Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P13, 3:, 5:20, 7:PDAT8
$BWDSTART=FALSE
PDAT_ACT=PPDAT8
FDAT_ACT=FP13
BAS(#PTP_PARAMS,20)
PTP XP13 
;ENDFOLD
;FOLD PTP P14 Vel=20 % PDAT9 Tool[1]:T_PUSH1 Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P14, 3:, 5:20, 7:PDAT9
$BWDSTART=FALSE
PDAT_ACT=PPDAT9
FDAT_ACT=FP14
BAS(#PTP_PARAMS,20)
PTP XP14 
;ENDFOLD


;FOLD PTP HOME  Vel= 100 % DEFAULT;%{PE}%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HOME, 3:, 5:100, 7:DEFAULT
$BWDSTART = FALSE
PDAT_ACT=PDEFAULT
FDAT_ACT=FHOME
BAS (#PTP_PARAMS,100 )
$H_POS=XHOME
PTP  XHOME
;ENDFOLD

;SETA DE BOMBEROS PULADA RESETAR PROGRAMA
WAIT FOR FALSE
WAIT FOR FALSE
WAIT FOR FALSE
;SETA DE BOMBEROS PULADA RESETAR PROGRAMA


END

DEF PARO_RAPIDO ()
BRAKE F
END

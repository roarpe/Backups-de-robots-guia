&ACCESS RVO1
&REL 46
&COMMENT COGER ST121 RACK VERDE
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\Program\MAFELEC
DEF Rack_Verde_CogerST121I( )
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
;FOLD SPOTTECH INI
USERSPOT(#INIT)
;ENDFOLD (SPOTTECH INI)
;FOLD GRIPPERTECH INI
USER_GRP(0,DUMMY,DUMMY,GDEFAULT)
;ENDFOLD (GRIPPERTECH INI)
;FOLD USER INI
INTERRUPT DECL 26 WHEN I_121R1S102 OR I_121R1S202 DO PARO_RAPIDO ()
INTERRUPT DECL 27 WHEN I_121R1S302 OR I_121R1S402 DO PARO_RAPIDO ()
    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)
;################################################
; PROYECTO: MAFELEC PLANTA DE BATERIAS
; ROBOT: 121_R1
; PROGRAMA: CARGA DE BATERIA EN ST121
;           POSICION DE CARGA A 180 GRADOS 
;           PALETA A INSPECCION
; CREADO POR: Maestro Yoda(zaisor robotics)
; FECHA: 23-NOVIEMBRE-2022
; MODIFICADO POR:
; FECHA MODIFICACION: 13-ENERO-2023
;################################################


Empujador(1,"R",FALSE)
Empujador(2,"R",FALSE)

; FOLD ESPERA CONFIRMACION ENTRADA INSPECCION
WAIT FOR I_ST121_INSPECCION
; ENDFOLD

;FOLD PTP POS_Wait_Verde_ST121 Vel=100 % H Tool[9]:T_Gripper1_Vacio Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:POS_Wait_Verde_ST121, 3:, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FPOS_Wait_Verde_ST121
BAS(#PTP_PARAMS,100)
PTP XPOS_Wait_Verde_ST121 
;ENDFOLD

; FOLD ESPERA CONFIRMACION ENTRADA INSPECCION
WAIT FOR I_ST121_INSPECCION
; ENDFOLD

; FOLD CONTROL DE MOVIMIENTOS MECANICOS EN REPOSO
;CONTROL DE AUSENCIA DE PIEZA EN GRIPPER
IF I_121R1S1000 THEN
HALT
ENDIF

;CONTROL APERTURA GRIPPER

IF (I_121R1S131B==FALSE) OR (I_121R1S132B==FALSE) OR (I_121R1S133B==FALSE) OR (I_121R1S134B==FALSE) THEN
Pines("R")
ENDIF

Empujador(1,"R",TRUE)
Empujador(2,"R",TRUE)
; ENDFOLD

;FOLD PTP P10 CONT Vel=100 % M Tool[9]:T_Gripper1_Vacio Base[3]:ST121;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P10, 3:C_DIS, 5:100, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=FP10
BAS(#PTP_PARAMS,100)
PTP XP10 C_DIS
;ENDFOLD
;FOLD LIN P20 CONT Vel=1 m/s M Tool[9]:T_Gripper1_Vacio Base[3]:ST121;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P20, 3:C_DIS C_DIS, 5:1, 7:M
$BWDSTART=FALSE
LDAT_ACT=LM
FDAT_ACT=FP20
BAS(#CP_PARAMS,1)
LIN XP20 C_DIS C_DIS
;ENDFOLD

; FOLD ACTIVA VIGILANCIA SOBREPASO
INTERRUPT ON 26
INTERRUPT ON 27
;ENDFOLD

; POSICION DE CARGA EN ST121 INSPECCION
;FOLD LIN Coger_Verde_ST121_INSP Vel=0.05 m/s L Tool[9]:T_Gripper1_Vacio Base[3]:ST121;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:Coger_Verde_ST121_INSP, 3:, 5:0.05, 7:L
$BWDSTART=FALSE
LDAT_ACT=LL
FDAT_ACT=FCoger_Verde_ST121_INSP
BAS(#CP_PARAMS,0.05)
LIN XCoger_Verde_ST121_INSP 
;ENDFOLD

; FOLD CONTROL DE PRESENCIAS PINES

Repite=0
IF (I_121R1S102==TRUE) OR (I_121R1S202==TRUE) OR (I_121R1S302==TRUE) OR (I_121R1S402==TRUE) THEN
   
   WHILE (I_121R1S102==TRUE) OR (I_121R1S202==TRUE) OR (I_121R1S302==TRUE) OR (I_121R1S402==TRUE)
   
      IF Repite>=4 THEN
         HALT
         ; SUPERADO NUMERO DE REPETICIONES
         HALT
         WAIT FOR FALSE

      ENDIF
   
   
   
      Repite=Repite+1
      LIN_REL{Z 1}
      WAIT SEC 0.2
   
   
   ENDWHILE
ENDIF




Repite=0
WHILE (I_121R1S101==FALSE) OR (I_121R1S201==FALSE) OR (I_121R1S301==FALSE) OR (I_121R1S401==FALSE) 
IF (I_121R1S102==TRUE) OR (I_121R1S202==TRUE) OR (I_121R1S302==TRUE) OR (I_121R1S402==TRUE) THEN
HALT
HALT
HALT
ENDIF
Repite=Repite+1
LIN_REL{Z -1}
WAIT SEC 0.2

IF Repite>=5 THEN
HALT
; SUPERADO NUMERO DE REPETICIONES
HALT
ENDIF

ENDWHILE

WAIT FOR I_121R1S101 AND I_121R1S301 OR I_121R1S201 AND I_121R1S401
; ENDFOLD

Pines("A")

IF (I_SIMULACION==FALSE) THEN
WAIT FOR I_121R1S1000
ENDIF

;FIN DE TRABAJO COGER
O_JRDY_3=TRUE

; FOLD FIN VIGILANCIA SOBREPASO
INTERRUPT OFF 26
INTERRUPT OFF 27
;ENDFOLD

;FOLD TORQMON SetLimits Axis1: 50 % Axis2: 50 % Axis3: 50 % Axis4: 50 % Axis5: 50 % Axis6: 50 %;%{PE}%R 8.3.48,%MKUKATPBASIS,%CTQ_MON,%VTQ_LIMITS,%P 2:TQ_LIMITS, 4:50, 7:50, 10:50, 13:50, 16:50, 19:50
SET_TQ_VALUES (50,50,50,50,50,50)
;ENDFOLD
;FOLD LIN POS_SOBRE_ST121 Vel=0.2 m/s M Tool[11]:T_Gripper1_Carga Base[3]:ST121;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:POS_SOBRE_ST121, 3:, 5:0.2, 7:M
$BWDSTART=FALSE
LDAT_ACT=LM
FDAT_ACT=FPOS_SOBRE_ST121
BAS(#CP_PARAMS,0.2)
LIN XPOS_SOBRE_ST121 
;ENDFOLD
;FOLD TORQMON SetDefault;%{PE}%R 8.3.48,%MKUKATPBASIS,%CTQ_MON,%VTQ_DEFAULT,%P 2:TQ_DEFAULT
SET_TQ_VALUES ( )
;ENDFOLD
;FOLD PTP POS_SOBRE_ST121 Vel=50 % M Tool[11]:T_Gripper1_Carga Base[3]:ST121;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:POS_SOBRE_ST121, 3:, 5:50, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=FPOS_SOBRE_ST121
BAS(#PTP_PARAMS,50)
PTP XPOS_SOBRE_ST121 
;ENDFOLD

IF (I_SIMULACION==FALSE) THEN
WAIT FOR I_121R1S1000
ENDIF

;Revisa sensores ok antes de continuar
;FOLD WAIT FOR ( IN 253 'I_121R1_S101 PIN1 Control Pieza' );%{PE}%R 8.3.48,%MKUKATPBASIS,%CEXT_WAIT_FOR,%VEXT_WAIT_FOR,%P 2:, 4:, 5:$IN, 6:253, 7:I_121R1_S101 PIN1 Control Pieza, 9:
WAIT FOR  ( $IN[253] ) 
;ENDFOLD
;FOLD WAIT FOR ( NOT IN 254 'I_121R1_S102 PIN1 Sobrepaso' );%{PE}%R 8.3.48,%MKUKATPBASIS,%CEXT_WAIT_FOR,%VEXT_WAIT_FOR,%P 2:, 4:NOT, 5:$IN, 6:254, 7:I_121R1_S102 PIN1 Sobrepaso, 9:
WAIT FOR  (  NOT $IN[254] ) 
;ENDFOLD
;FOLD WAIT FOR ( IN 255 'I_121R1_S201 PIN2 Control Pieza' );%{PE}%R 8.3.48,%MKUKATPBASIS,%CEXT_WAIT_FOR,%VEXT_WAIT_FOR,%P 2:, 4:, 5:$IN, 6:255, 7:I_121R1_S201 PIN2 Control Pieza, 9:
WAIT FOR  ( $IN[255] ) 
;ENDFOLD
;FOLD WAIT FOR ( NOT IN 256 'I_121R1_S202 PIN2 Sobrepaso' );%{PE}%R 8.3.48,%MKUKATPBASIS,%CEXT_WAIT_FOR,%VEXT_WAIT_FOR,%P 2:, 4:NOT, 5:$IN, 6:256, 7:I_121R1_S202 PIN2 Sobrepaso, 9:
WAIT FOR  (  NOT $IN[256] ) 
;ENDFOLD
;FOLD WAIT FOR ( IN 257 'I_121R1_S301 PIN3 Control Pieza' );%{PE}%R 8.3.48,%MKUKATPBASIS,%CEXT_WAIT_FOR,%VEXT_WAIT_FOR,%P 2:, 4:, 5:$IN, 6:257, 7:I_121R1_S301 PIN3 Control Pieza, 9:
WAIT FOR  ( $IN[257] ) 
;ENDFOLD
;FOLD WAIT FOR ( NOT IN 258 'I_121R1_S302 PIN3 Sobrepaso' );%{PE}%R 8.3.48,%MKUKATPBASIS,%CEXT_WAIT_FOR,%VEXT_WAIT_FOR,%P 2:, 4:NOT, 5:$IN, 6:258, 7:I_121R1_S302 PIN3 Sobrepaso, 9:
WAIT FOR  (  NOT $IN[258] ) 
;ENDFOLD
;FOLD WAIT FOR ( IN 259 'I_121R1_S401 PIN4 Control Pieza' );%{PE}%R 8.3.48,%MKUKATPBASIS,%CEXT_WAIT_FOR,%VEXT_WAIT_FOR,%P 2:, 4:, 5:$IN, 6:259, 7:I_121R1_S401 PIN4 Control Pieza, 9:
WAIT FOR  ( $IN[259] ) 
;ENDFOLD
;FOLD WAIT FOR ( NOT IN 260 'I_121R1_S402 PIN4 Sobrepaso' );%{PE}%R 8.3.48,%MKUKATPBASIS,%CEXT_WAIT_FOR,%VEXT_WAIT_FOR,%P 2:, 4:NOT, 5:$IN, 6:260, 7:I_121R1_S402 PIN4 Sobrepaso, 9:
WAIT FOR  (  NOT $IN[260] ) 
;ENDFOLD
WAIT SEC 0.2

;FOLD PTP P30 CONT Vel=100 % L Tool[11]:T_Gripper1_Carga Base[3]:ST121;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P30, 3:C_DIS, 5:100, 7:L
$BWDSTART=FALSE
PDAT_ACT=PL
FDAT_ACT=FP30
BAS(#PTP_PARAMS,100)
PTP XP30 C_DIS
;ENDFOLD

;POSICION AREA 3 LIBRE
;FOLD PTP POS_AREA_3_LIBRE Vel=100 % L Tool[11]:T_Gripper1_Carga Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:POS_AREA_3_LIBRE, 3:, 5:100, 7:L
$BWDSTART=FALSE
PDAT_ACT=PL
FDAT_ACT=FPOS_AREA_3_LIBRE
BAS(#PTP_PARAMS,100)
PTP XPOS_AREA_3_LIBRE 
;ENDFOLD

;LIBERA AREA 3, TRANSPORTE BATERIAS
O_AREL_3=TRUE

WAIT FOR (I_ARDY_1) OR ($SR_RANGE_ACTIVE[16]==FALSE)
If ($SR_RANGE_ACTIVE[16]==FALSE) THEN
FromVerde2pickI()
ENDIF



END
DEF PARO_RAPIDO()
BRAKE F
END

;################################################

;FOLD PTP HOME  Vel= 100 % DEFAULT;%{PE}%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HOME, 3:, 5:100, 7:DEFAULT
$BWDSTART = FALSE
PDAT_ACT=PDEFAULT
FDAT_ACT=FHOME
BAS (#PTP_PARAMS,100 )
$H_POS=XHOME
PTP  XHOME
;ENDFOLD

Empujador(1,"R",TRUE)
Empujador(2,"R",TRUE)
Pines("R")

;FOLD PTP P10 CONT Vel=100 % M Tool[9]:T_Gripper1_Vacio Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P10, 3:C_DIS, 5:100, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=FP10
BAS(#PTP_PARAMS,100)
PTP XP10 C_DIS
;ENDFOLD
;FOLD PTP P20 CONT Vel=100 % M Tool[9]:T_Gripper1_Vacio Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P20, 3:C_DIS, 5:100, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=FP20
BAS(#PTP_PARAMS,100)
PTP XP20 C_DIS
;ENDFOLD
;FOLD PTP P30 CONT Vel=100 % M Tool[9]:T_Gripper1_Vacio Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P30, 3:C_DIS, 5:100, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=FP30
BAS(#PTP_PARAMS,100)
PTP XP30 C_DIS
;ENDFOLD
;FOLD PTP P40 CONT Vel=100 % M Tool[9]:T_Gripper1_Vacio Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P40, 3:C_DIS, 5:100, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=FP40
BAS(#PTP_PARAMS,100)
PTP XP40 C_DIS
;ENDFOLD

; FOLD ESPERA LLAVE EN MANUAL(T1),CONTROLAR GARRA EN GALGA
Pines("R")
WAIT FOR $T1
;ENDFOLD

;FOLD LIN POSICION_CONTROL Vel=0.1 m/s M Tool[9]:T_Gripper1_Vacio Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:POSICION_CONTROL, 3:, 5:0.1, 7:M
$BWDSTART=FALSE
LDAT_ACT=LM
FDAT_ACT=FPOSICION_CONTROL
BAS(#CP_PARAMS,0.1)
LIN XPOSICION_CONTROL 
;ENDFOLD

;Pines("A")
O_121R1Y13B=FALSE
O_121R1Y13A=TRUE
O_121R1Y132B=FALSE
O_121R1Y132A=TRUE

WAIT FOR (I_121R1S131A AND I_121R1S132A AND I_121R1S133A AND I_121R1S134A)
WAIT SEC 10
Pines("R")


;FOLD LIN P40 Vel=0.5 m/s M Tool[9]:T_Gripper1_Vacio Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P40, 3:, 5:0.5, 7:M
$BWDSTART=FALSE
LDAT_ACT=LM
FDAT_ACT=FP40
BAS(#CP_PARAMS,0.5)
LIN XP40 
;ENDFOLD

;FOLD CAMBIAR LA LLAVE A EXT Y CONTINUAR
Pines("R")
PTP $POS_ACT
WAIT FOR $EXT
Pines("R")
;ENDFOLD

;FOLD PTP P30 CONT Vel=100 % M Tool[9]:T_Gripper1_Vacio Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P30, 3:C_DIS, 5:100, 7:M

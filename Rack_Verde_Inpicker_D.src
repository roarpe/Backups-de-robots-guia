SELECT_SIN=TRUE
O_INPICKER_OK=FALSE
O_INPICKER_NOK=TRUE
O_TYPE_RQ = FALSE
GOTO FIN_FOTO2

CASE 4
; #### SELECCION DESDE HMI CERRAR BANDEJA ####
; #### E IR A SIGUIENTE NIVEL             ####

SELECT_NEXT=TRUE
O_INPICKER_OK=FALSE
O_INPICKER_NOK=FALSE
O_TYPE_RQ = FALSE
GOTO FIN_FOTO2

DEFAULT
ENDSWITCH

ELSE

Fallo_nr=Fallo_nr+1
GOTO Ini2

ENDIF
ENDIF

Fin2:
 WAIT SEC 0.1
;ENDFOLD

INICIO_POS2_B2:
;FOLD LIN P_FOTO2V_Bandeja2 Vel=0.5 m/s M Tool[5]:T_Camara Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P_FOTO2V_Bandeja2, 3:, 5:0.5, 7:M

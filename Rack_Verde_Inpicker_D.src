FRAMEAUX={X 0,Y 0,Z 0,A 0,B 0,C 0}
FRAME_POS={X 0,Y 0,Z 0,A 0,B 0,C 0}

FRAMEAUX=INPICKER_Handler.DataReceived.PartsToGrasp0.Position
FRAME_POS.x=(FRAMEAUX.x/10)
FRAME_POS.y=(FRAMEAUX.y/10)
FRAME_POS.z=(FRAMEAUX.z/10)
FRAME_POS.a=(FRAMEAUX.a/10)
FRAME_POS.b=(FRAMEAUX.b/10)
FRAME_POS.c=(FRAMEAUX.c/10)

IF FRAME_POS.A < 180.0 THEN
FRAME_POS.A = FRAME_POS.A + 360
ENDIF

IF FRAME_POS.B < 180.0 THEN
FRAME_POS.B = FRAME_POS.B + 360
ENDIF

IF FRAME_POS.A > 180.0 THEN
FRAME_POS.A = FRAME_POS.A - 360
ENDIF

IF FRAME_POS.B > 180.0 THEN
FRAME_POS.B = FRAME_POS.B - 360
ENDIF

FRAME_POS.C = FRAME_POS.C - 360

;ENDFOLD
;FOLD CONTROL LIMITES DE VISION
CTRL_limites()
;ENDFOLD
;FOLD DECISION RESULTADOS EVALUACION BANDEJA 2
IF (O_LIMITS_OK==FALSE) AND (O_LIMITS_NOK==TRUE) THEN

O_TYPE_RQ = FALSE
WAIT FOR I_TYPE_INFO == 0

O_TYPE_RQ = TRUE
WAIT FOR (I_TYPE_INFO >= 1) AND (I_TYPE_INFO <= 5)

SWITCH I_TYPE_INFO

CASE 2
; #### SELECCION DESDE HMI REINTENTO FOTO ####

SELECT_NEXT=FALSE
O_TYPE_RQ = FALSE
O_LIMITS_OK = FALSE
O_LIMITS_NOK = FALSE
O_LIMIT_X = FALSE
O_LIMIT_Y = FALSE
O_LIMIT_Z = FALSE
O_LIMIT_A = FALSE
O_LIMIT_B = FALSE
O_LIMIT_C = FALSE

GOTO INICIO_FOTO2

CASE 3
; #### SELECCION DESDE HMI CONT SIN CORRECCION ####

SELECT_NEXT=FALSE
O_TYPE_RQ = FALSE


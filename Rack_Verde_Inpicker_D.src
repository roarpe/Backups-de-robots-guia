DEF CTRL_limites ()
;################################################
; RUTINA DE CONTROL DE LIMITES DE VISION
;
;################################################

IF $T1 THEN
O_LIMITS_OK=FALSE
O_LIMITS_NOK=FALSE
O_LIMIT_X=FALSE
O_LIMIT_Y=FALSE
O_LIMIT_Z=FALSE
O_LIMIT_A=FALSE
O_LIMIT_B=FALSE
O_LIMIT_C=FALSE

LIM_X=FALSE
LIM_Y=FALSE
LIM_Z=FALSE
LIM_A=FALSE
LIM_B=FALSE
LIM_C=FALSE

ELSE

WAIT FOR $EXT
O_LIMITS_OK=FALSE
O_LIMITS_NOK=FALSE
O_LIMIT_X=FALSE
O_LIMIT_Y=FALSE
O_LIMIT_Z=FALSE
O_LIMIT_A=FALSE
O_LIMIT_B=FALSE
O_LIMIT_C=FALSE

LIM_X=FALSE
LIM_Y=FALSE
LIM_Z=FALSE
LIM_A=FALSE
LIM_B=FALSE
LIM_C=FALSE

IF (FRAME_POS.X>-1000.0) AND (FRAME_POS.X<-970.0) THEN
O_LIMIT_X=TRUE
LIM_X=TRUE
ELSE
O_LIMIT_X=FALSE
LIM_X=FALSE
ENDIF

IF (FRAME_POS.Y>-1690.0) AND (FRAME_POS.Y<-1620.0) THEN
O_LIMIT_Y=TRUE
LIM_Y=TRUE
ELSE
O_LIMIT_Y=FALSE
LIM_Y=FALSE
ENDIF

SWITCH RV_Bandeja_Nr 
CASE 11
IF (FRAME_POS.Z>150.0) AND (FRAME_POS.Z<180.0) THEN
O_LIMIT_Z=TRUE
LIM_Z=TRUE
ELSE
O_LIMIT_Z=FALSE
LIM_Z=FALSE
ENDIF
CASE 12
IF (FRAME_POS.Z>350.0) AND (FRAME_POS.Z<380.0) THEN
O_LIMIT_Z=TRUE
LIM_Z=TRUE
ELSE
O_LIMIT_Z=FALSE
LIM_Z=FALSE
ENDIF
CASE 13
IF (FRAME_POS.Z>560.0) AND (FRAME_POS.Z<585.0) THEN
O_LIMIT_Z=TRUE
LIM_Z=TRUE
ELSE
O_LIMIT_Z=FALSE
LIM_Z=FALSE
ENDIF
CASE 14
IF (FRAME_POS.Z>770.0) AND (FRAME_POS.Z<790.0) THEN
O_LIMIT_Z=TRUE
LIM_Z=TRUE
ELSE
O_LIMIT_Z=FALSE
LIM_Z=FALSE
ENDIF
CASE 15
IF (FRAME_POS.Z>970.0) AND (FRAME_POS.Z<1010.0) THEN
O_LIMIT_Z=TRUE
LIM_Z=TRUE
ELSE
O_LIMIT_Z=FALSE
LIM_Z=FALSE
ENDIF
DEFAULT
ENDSWITCH

IF (FRAME_POS.A>-91.30) AND (FRAME_POS.A<-89.50) THEN
O_LIMIT_A=TRUE
LIM_A=TRUE
ELSE
O_LIMIT_A=FALSE
LIM_A=FALSE
ENDIF

IF (FRAME_POS.B>-1.35) AND (FRAME_POS.B<0.75) THEN
O_LIMIT_B=TRUE
LIM_B=TRUE
ELSE
O_LIMIT_B=FALSE
LIM_B=FALSE
ENDIF

IF (FRAME_POS.C>-180.5) AND (FRAME_POS.C<-179.0) THEN
O_LIMIT_C=TRUE
LIM_C=TRUE
ELSE
O_LIMIT_C=FALSE
LIM_A=FALSE
ENDIF

IF (LIM_X==TRUE) AND (LIM_Y==TRUE) AND (LIM_Z==TRUE) AND (LIM_A==TRUE) AND (LIM_B==TRUE) AND (LIM_C==TRUE) THEN
O_LIMITS_OK=TRUE
O_LIMITS_NOK=FALSE
ELSE
O_LIMITS_OK=FALSE
O_LIMITS_NOK=TRUE
ENDIF

;################################################
ENDIF
END

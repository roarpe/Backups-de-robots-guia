&ACCESS RVP
&REL 1
&COMMENT FOTOS EN RACK VERDE
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\Program\MAFELEC
DEF Rack_Verde_Inpicker_D( )
;FOLD DECLARACION_INPICKER
DECL EKI_STATUS Ret
DECL INT InPickerStateValue
;ENDFOLD
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
O_LIMITS_OK=FALSE
O_LIMITS_NOK=FALSE
O_LIMIT_X=FALSE
O_LIMIT_Y=FALSE
O_LIMIT_Z=FALSE
O_LIMIT_A=FALSE
O_LIMIT_B=FALSE
O_LIMIT_C=FALSE
LIM_X=FALSE
LIM_Y=FALSE
LIM_Z=FALSE
LIM_A=FALSE
LIM_B=FALSE
LIM_C=FALSE
O_TYPE_INFO=0

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

;################################################
; PROYECTO: MAFELEC PLANTA DE BATERIAS
; ROBOT: 121_R1
; PROGRAMA: FOTO PARA CORRECCIONES EN RACK VERDE
; CREADO POR: Alejandro Company(zaisor robotics)
; FECHA: 23-NOVIEMBRE-2022
; MODIFICADO POR: 
; FECHA MODIFICACION: 13-ENERO-2023
;################################################

$TIMER[2]=0
$TIMER_STOP[2]=FALSE
;FOLD INICIALIZACION PUERTOS DE KRL
Ret = EKI_INIT("XML_Kuka_InPicker_1")
Ret = EKI_INIT("XML_Kuka_InPicker_2")

Ret = EKI_OPEN("XML_Kuka_InPicker_1")
Ret = EKI_OPEN("XML_Kuka_InPicker_2")

 INPICKER_Handler.DataToSend.command=0
;WAIT FOR (INPICKER_Handler.ConnectionStatus==TRUE)
;IF (INPICKER_Handler.ConnectionStatus==TRUE) THEN
;ELSE
;ENDIF

;ENDFOLD

Empujador(1,"R",FALSE)
Empujador(2,"R",FALSE)

; POSICION DE ESPERA ENTRADA RACK 1
;FOLD PTP POS_ESPERA_FOTO Vel=100 % H Tool[5]:T_Camara Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:POS_ESPERA_FOTO, 3:, 5:100, 7:H
$BWDSTART=FALSE
PDAT_ACT=PH
FDAT_ACT=FPOS_ESPERA_FOTO
BAS(#PTP_PARAMS,100)
PTP XPOS_ESPERA_FOTO 
;ENDFOLD

;ESPERA AREA 1
WAIT FOR I_ARDY_1
O_AREL_1=FALSE
RV_Bandeja_nr=0

Empujador(1,"R",TRUE)
Empujador(2,"R",TRUE)

;FOLD PTP P11 CONT Vel=100 % M Tool[5]:T_Camara Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P11, 3:C_DIS, 5:100, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=FP11
BAS(#PTP_PARAMS,100)
PTP XP11 C_DIS
;ENDFOLD

O_TYPE_RQ=TRUE
WAIT FOR (I_TYPE_INFO >= 10) AND (I_TYPE_INFO <= 16)

RV_Bandeja_Nr=I_TYPE_INFO

SWITCH RV_Bandeja_Nr 

CASE 11
O_TYPE_RQ=FALSE
O_TYPE_INFO=RV_Bandeja_Nr
INICIO_FOTO1:
;FOLD PTP P_FOTO1V_Bandeja1 Vel=50 % M Tool[5]:T_Camara Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P_FOTO1V_Bandeja1, 3:, 5:50, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=FP_FOTO1V_Bandeja1
BAS(#PTP_PARAMS,50)
PTP XP_FOTO1V_Bandeja1 
;ENDFOLD
;FOLD REALIZA FOTO 1 BANDEJA 1
WAIT SEC 1
Fallo_nr=0
Ini1:
O_INPICKER_OK = FALSE
O_INPICKER_NOK = FALSE
SELECT_SIN=FALSE
SELECT_U1=FALSE
SELECT_U2=FALSE
SELECT_U3=FALSE
SELECT_U4=FALSE

; INICIALIZACION CAMARA PARA BANDEJA 1
 INPICKER_Handler.DataToSend.command=0
 INPICKER_Handler.DataToSend.GraspConfirmation=0
 WAIT FOR (INPICKER_Handler.DataReceived.state==0)

; Camara siempre 2
 INPICKER_Handler.DataToSend.CameraID=2

; contendor igual al numero de bandeja
 INPICKER_Handler.DataToSend.ContainerID=1
 INPICKER_Handler.DataToSend.partid=1
 INPICKER_Handler.DataToSend.GraspConfirmation=0
 WAIT SEC 0.2

; DISPARO FOTO
 INPICKER_Handler.DataToSend.command=1  

; ESPERA FOTO REALIZADA
 WAIT FOR (INPICKER_Handler.DataReceived.state==15) OR (INPICKER_Handler.DataReceived.state==-1)

IF (INPICKER_Handler.DataReceived.state==-1) THEN

IF (Fallo_nr>=1) THEN
O_INPICKER_OK=FALSE
O_INPICKER_NOK=TRUE

O_TYPE_RQ = FALSE
WAIT FOR I_TYPE_INFO == 0

O_TYPE_RQ = TRUE
WAIT FOR (I_TYPE_INFO >= 1) AND (I_TYPE_INFO <= 5)

SWITCH I_TYPE_INFO

CASE 2
; #### SELECCION DESDE HMI REINTENTO FOTO ####

SELECT_NEXT=FALSE
O_INPICKER_OK=FALSE
O_INPICKER_NOK=FALSE
O_TYPE_RQ = FALSE
GOTO Ini1

CASE 3
; #### SELECCION DESDE HMI CONT SIN CORRECCION ####

SELECT_SIN=TRUE
O_INPICKER_OK=FALSE
O_INPICKER_NOK=TRUE
O_TYPE_RQ = FALSE
GOTO FIN_FOTO1

CASE 4
; #### SELECCION DESDE HMI CERRAR BANDEJA ####
; #### E IR A SIGUIENTE NIVEL             ####

SELECT_NEXT=TRUE
O_INPICKER_OK=FALSE
O_INPICKER_NOK=FALSE
O_TYPE_RQ = FALSE
GOTO FIN_FOTO1

DEFAULT
ENDSWITCH

ELSE

Fallo_nr=Fallo_nr+1
GOTO Ini1

ENDIF
ENDIF

Fin1:
 WAIT SEC 0.1
;ENDFOLD

INICIO_POS2_B1:
;FOLD LIN P_FOTO2V_Bandeja1 Vel=0.5 m/s M Tool[5]:T_Camara Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P_FOTO2V_Bandeja1, 3:, 5:0.5, 7:M
$BWDSTART=FALSE
LDAT_ACT=LM
FDAT_ACT=FP_FOTO2V_Bandeja1
BAS(#CP_PARAMS,0.5)
LIN XP_FOTO2V_Bandeja1 
;ENDFOLD
;FOLD REALIZA FOTO 2 BANDEJA 1 (INFERIOR)
WAIT SEC 1.0
INPICKER_Handler.DataToSend.GraspConfirmation=1

WAIT FOR (INPICKER_Handler.DataReceived.state==30) OR (INPICKER_Handler.dataReceived.state==-1)

WAIT SEC 0.5

INPICKER_Handler.DataToSend.command=0

IF (INPICKER_handler.datareceived.state==30 ) THEN

IF (INPICKER_Handler.DataReceived.ObjectsGraspable>0) THEN

O_INPICKER_OK=TRUE
O_INPICKER_NOK=FALSE

ELSE

O_INPICKER_OK=FALSE
O_INPICKER_NOK=TRUE

ENDIF

ENDIF

IF (INPICKER_handler.datareceived.state==-1 ) OR (INPICKER_Handler.DataReceived.ObjectsGraspable<=0) THEN

O_INPICKER_OK=FALSE
O_INPICKER_NOK=TRUE

O_TYPE_RQ = FALSE
WAIT FOR I_TYPE_INFO == 0

O_TYPE_RQ = TRUE
WAIT FOR (I_TYPE_INFO >= 1) AND (I_TYPE_INFO <= 5)

SWITCH I_TYPE_INFO

CASE 2
; #### SELECCION DESDE HMI REINTENTO FOTO ####

SELECT_NEXT=FALSE
O_INPICKER_OK=FALSE
O_INPICKER_NOK=FALSE
O_TYPE_RQ = FALSE

IF (INPICKER_Handler.DataReceived.ObjectsGraspable>0)THEN
ELSE
GOTO INICIO_FOTO1
ENDIF

WAIT FOR (INPICKER_Handler.DataReceived.state==0)
GOTO INICIO_FOTO1

CASE 3
; #### SELECCION DESDE HMI CONT SIN CORRECCION ####

SELECT_NEXT=FALSE
O_TYPE_RQ = FALSE

CASE 4
; #### SELECCION DESDE HMI CERRAR BANDEJA ####
; #### E IR A SIGUIENTE NIVEL             ####

SELECT_NEXT=TRUE
O_INPICKER_OK=FALSE
O_INPICKER_NOK=FALSE
O_TYPE_RQ = FALSE

DEFAULT
ENDSWITCH

ENDIF
 INPICKER_Handler.DataToSend.command=0

;ENDFOLD
;FOLD ACTUALIZA BASE DE DESCARGA
FRAMEAUX={X 0,Y 0,Z 0,A 0,B 0,C 0}
FRAME_POS={X 0,Y 0,Z 0,A 0,B 0,C 0}

FRAMEAUX=INPICKER_Handler.DataReceived.PartsToGrasp0.Position
FRAME_POS.x=(FRAMEAUX.x/10)
FRAME_POS.y=(FRAMEAUX.y/10)
FRAME_POS.z=(FRAMEAUX.z/10)
FRAME_POS.a=(FRAMEAUX.a/10)
FRAME_POS.b=(FRAMEAUX.b/10)
FRAME_POS.c=(FRAMEAUX.c/10)

IF FRAME_POS.A < 180.0 THEN
FRAME_POS.A = FRAME_POS.A + 360
ENDIF
IF FRAME_POS.B < 180.0 THEN
FRAME_POS.B = FRAME_POS.B + 360
ENDIF
IF FRAME_POS.A > 180.0 THEN
FRAME_POS.A = FRAME_POS.A - 360
ENDIF
IF FRAME_POS.B > 180.0 THEN
FRAME_POS.B = FRAME_POS.B - 360
ENDIF

FRAME_POS.C = FRAME_POS.C - 360

;ENDFOLD
;FOLD CONTROL LIMITES DE VISION
CTRL_limites()
;ENDFOLD
;FOLD DECISION RESULTADOS EVALUACION BANDEJA 1
IF (O_LIMITS_OK==FALSE) AND (O_LIMITS_NOK==TRUE) THEN

O_TYPE_RQ = FALSE
WAIT FOR I_TYPE_INFO == 0

O_TYPE_RQ = TRUE
WAIT FOR (I_TYPE_INFO >= 1) AND (I_TYPE_INFO <= 5)

SWITCH I_TYPE_INFO

CASE 2
; #### SELECCION DESDE HMI REINTENTO FOTO ####

SELECT_NEXT=FALSE
O_TYPE_RQ = FALSE
O_LIMITS_OK = FALSE
O_LIMITS_NOK = FALSE
O_LIMIT_X = FALSE
O_LIMIT_Y = FALSE
O_LIMIT_Z = FALSE
O_LIMIT_A = FALSE
O_LIMIT_B = FALSE
O_LIMIT_C = FALSE

GOTO INICIO_FOTO1

CASE 3
; #### SELECCION DESDE HMI CONT SIN CORRECCION ####

SELECT_NEXT=FALSE
O_TYPE_RQ = FALSE

CASE 4
; #### SELECCION DESDE HMI CERRAR BANDEJA ####
; #### E IR A SIGUIENTE NIVEL             ####

SELECT_NEXT=TRUE
O_TYPE_RQ = FALSE
O_LIMITS_OK = FALSE
O_LIMITS_NOK = FALSE
O_LIMIT_X = FALSE
O_LIMIT_Y = FALSE
O_LIMIT_Z = FALSE
O_LIMIT_A = FALSE
O_LIMIT_B = FALSE
O_LIMIT_C = FALSE

DEFAULT

HALT
HALT
HALT
ENDSWITCH

ENDIF
;ENDFOLD
FIN_FOTO1:

CASE 12
O_TYPE_RQ=FALSE
O_TYPE_INFO=RV_Bandeja_Nr
INICIO_FOTO2:
;FOLD PTP P_FOTO1V_Bandeja2 Vel=50 % M Tool[5]:T_Camara Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P_FOTO1V_Bandeja2, 3:, 5:50, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=FP_FOTO1V_Bandeja2
BAS(#PTP_PARAMS,50)
PTP XP_FOTO1V_Bandeja2 
;ENDFOLD
;FOLD REALIZA FOTO 1 BANDEJA 2
WAIT SEC 1
Fallo_nr=0
Ini2:
O_INPICKER_OK = FALSE
O_INPICKER_NOK = FALSE
SELECT_SIN=FALSE
SELECT_U1=FALSE
SELECT_U2=FALSE
SELECT_U3=FALSE
SELECT_U4=FALSE

; INICIALIZACION CAMARA PARA BANDEJA 2
 INPICKER_Handler.DataToSend.command=0
 INPICKER_Handler.DataToSend.GraspConfirmation=0
 WAIT FOR (INPICKER_Handler.DataReceived.state==0)

; Camara siempre 2
 INPICKER_Handler.DataToSend.CameraID=2

; contendor igual al numero de bandeja
 INPICKER_Handler.DataToSend.ContainerID=2
 INPICKER_Handler.DataToSend.partid=2
 INPICKER_Handler.DataToSend.GraspConfirmation=0
 WAIT SEC 0.2

; DISPARO FOTO
 INPICKER_Handler.DataToSend.command=1  

; ESPERA FOTO REALIZADA
 WAIT FOR (INPICKER_Handler.DataReceived.state==15) OR (INPICKER_Handler.DataReceived.state==-1)

IF (INPICKER_Handler.DataReceived.state==-1) THEN

IF (Fallo_nr>=1) THEN
O_INPICKER_OK=FALSE
O_INPICKER_NOK=TRUE

O_TYPE_RQ = FALSE
WAIT FOR I_TYPE_INFO == 0

O_TYPE_RQ = TRUE
WAIT FOR (I_TYPE_INFO >= 1) AND (I_TYPE_INFO <= 5)

SWITCH I_TYPE_INFO

CASE 2
; #### SELECCION DESDE HMI REINTENTO FOTO ####

SELECT_NEXT=FALSE
O_INPICKER_OK=FALSE
O_INPICKER_NOK=FALSE
O_TYPE_RQ = FALSE
GOTO Ini2

CASE 3

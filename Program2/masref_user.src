;FOLD Teach path back for reference group 1
;ENDFOLD
;FOLD PTP P1 Vel=100 % PDAT4 Tool[0] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P1, 3:, 5:100, 7:PDAT4

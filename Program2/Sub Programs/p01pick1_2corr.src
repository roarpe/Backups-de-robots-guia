&ACCESS RVO1
&REL 46
&COMMENT Pick carton
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\Program\Sub Programs
DEF P01pick1_2corr( )
;FOLD INI
  ;FOLD BASISTECH INI
BACKJUMP=FALSE
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
;ENDFOLD (INI)
;================================================
; MODEL    : XXXX
; IE GROUP : XX
; STATION  : XXX
; ROBOT    : RX
; FUNCTION : pick Part in StXX 
;================================================

;wait point

;FOLD PTP P01Waitdrop Vel=100 % PDAT1 Tool[5] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P01Waitdrop, 3:, 5:100, 7:PDAT1
$BWDSTART=FALSE
PDAT_ACT=PPDAT1
FDAT_ACT=FP01Waitdrop
BAS(#PTP_PARAMS,100)
PTP XP01Waitdrop 
;ENDFOLD

;FOLD SYN OUT 241 'cil ventosas reposo' State=FALSE at START Delay=0 ms;%{PE}%R 8.3.48,%MKUKATPBASIS,%COUT,%VSYNOUT,%P 2:241, 3:cil ventosas reposo, 5:FALSE, 7:0, 9:0, 12:0
TRIGGER WHEN DISTANCE=0 DELAY=0 DO $OUT[241]=FALSE
;ENDFOLD
;FOLD SYN OUT 242 'cil ventosas activo' State=TRUE at START Delay=0 ms;%{PE}%R 8.3.48,%MKUKATPBASIS,%COUT,%VSYNOUT,%P 2:242, 3:cil ventosas activo, 5:TRUE, 7:0, 9:0, 12:0
TRIGGER WHEN DISTANCE=0 DELAY=0 DO $OUT[242]=TRUE
;ENDFOLD


;FOLD Fordtech.Tool_Req Tool Request: 2 ;%{PE}%MKUKATPUSER

Tool_Req (2)

;ENDFOLD
;FOLD Fordtech.Wait_Tool_Ready Wait Tool Ready: 2 ;%{PE}%MKUKATPUSER

Wait_Tool_Ready (2)

;ENDFOLD

;FOLD ALTUA BASE
level1=PISO   
;BASE_DATA[11]=BASE_DATA[13]
BASE_DATA[14].Z=(ALTURA1*LEVEL1)

;ENDFOLD

;FOLD PTP P8 CONT Vel=100 % M Tool[5]:Gripper_empty Base[14];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P8, 3:C_DIS, 5:100, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=FP8
BAS(#PTP_PARAMS,100)
PTP XP8 C_DIS
;ENDFOLD

;FOLD TORQMON SetLimits Axis1: 10 % Axis2: 30 % Axis3: 20 % Axis4: 10 % Axis5: 10 % Axis6: 10 %;%{PE}%R 8.3.48,%MKUKATPBASIS,%CTQ_MON,%VTQ_LIMITS,%P 2:TQ_LIMITS, 4:10, 7:30, 10:20, 13:10, 16:10, 19:10
SET_TQ_VALUES (10,30,20,10,10,10)
;ENDFOLD

;FOLD PTP p02 CONT Vel=100 % M Tool[5]:Gripper_empty Base[14];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:p02, 3:C_DIS, 5:100, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=Fp02
BAS(#PTP_PARAMS,100)
PTP Xp02 C_DIS
;ENDFOLD
CONTINUE
CIL_VENT_ACTIVO()

;FOLD LIN p01 Vel=1 m/s M Tool[5]:Gripper_empty Base[14];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:p01, 3:, 5:1, 7:M
$BWDSTART=FALSE
LDAT_ACT=LM
FDAT_ACT=Fp01
BAS(#CP_PARAMS,1)
LIN Xp01 
;ENDFOLD
SUCTION_ON()
;FOLD WAIT Time=2 sec;%{PE}%R 8.3.48,%MKUKATPBASIS,%CWAIT,%VWAIT,%P 3:2
WAIT SEC 2
;ENDFOLD

;FOLD LIN P1 CONT Vel=0.5 m/s L Tool[5]:Gripper_empty Base[14];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P1, 3:C_DIS C_DIS, 5:0.5, 7:L
$BWDSTART=FALSE
LDAT_ACT=LL
FDAT_ACT=FP1
BAS(#CP_PARAMS,0.5)
LIN XP1 C_DIS C_DIS
;ENDFOLD

;FOLD WAIT FOR ( IN 60 'vacio ok' ) CONT;%{PE}%R 8.3.48,%MKUKATPBASIS,%CEXT_WAIT_FOR,%VEXT_WAIT_FOR,%P 2:, 4:, 5:$IN, 6:60, 7:vacio ok, 9:CONTINUE
CONTINUE
WAIT FOR  ( $IN[60] ) 
;ENDFOLD

;FOLD SYN OUT 45 'Job Ready 5' State=TRUE at START Delay=0 ms;%{PE}%R 8.3.48,%MKUKATPBASIS,%COUT,%VSYNOUT,%P 2:45, 3:Job Ready 5, 5:TRUE, 7:0, 9:0, 12:0
TRIGGER WHEN DISTANCE=0 DELAY=0 DO $OUT[45]=TRUE
;ENDFOLD

;FOLD PTP P5 CONT Vel=50 % L Tool[5]:Gripper_empty Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P5, 3:C_DIS, 5:50, 7:L
$BWDSTART=FALSE
PDAT_ACT=PL
FDAT_ACT=FP5
BAS(#PTP_PARAMS,50)
PTP XP5 C_DIS
;ENDFOLD

;FOLD TORQMON SetDefault;%{PE}%R 8.3.48,%MKUKATPBASIS,%CTQ_MON,%VTQ_DEFAULT,%P 2:TQ_DEFAULT
SET_TQ_VALUES ( )
;ENDFOLD

;FOLD SYN OUT 17 'Area Release 1' State=TRUE at START Delay=0 ms;%{PE}%R 8.3.48,%MKUKATPBASIS,%COUT,%VSYNOUT,%P 2:17, 3:Area Release 1, 5:TRUE, 7:0, 9:0, 12:0
TRIGGER WHEN DISTANCE=0 DELAY=0 DO $OUT[17]=TRUE
;ENDFOLD

;FOLD PTP P6 CONT Vel=50 % L Tool[5]:Gripper_empty Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P6, 3:C_DIS, 5:50, 7:L
$BWDSTART=FALSE
PDAT_ACT=PL
FDAT_ACT=FP6
BAS(#PTP_PARAMS,50)
PTP XP6 C_DIS
;ENDFOLD
;FOLD PTP P3 Vel=50 % L Tool[5]:Gripper_empty Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P3, 3:, 5:50, 7:L
$BWDSTART=FALSE
PDAT_ACT=PL
FDAT_ACT=FP3
BAS(#PTP_PARAMS,50)
PTP XP3 
;ENDFOLD

;FOLD TYPE INFO

O_TYPE_REQ=FALSE
WAIT FOR I_TYPE_INFO==0
O_TYPE_REQ=TRUE
WAIT FOR (I_TYPE_INFO>0)
POS_CARTON=I_TYPE_INFO
O_TYPE_INFO=I_TYPE_INFO
O_TYPE_REQ=FALSE

;ENDFOLD

;FOLD Fordtech.Area_Req Area Request: 4, Safety Position: 0, Return To Home: 0;%{PE}%MKUKATPUSER

Area_Req (4,0,0)
IF I_RETHP AND (0 <> 0) AND ($IN_HOME == TRUE) THEN
  GOTO PEXIT
ENDIF

;ENDFOLD

;Jump Adress
PEXIT:


END
&ACCESS RVP1
&COMMENT Drop Part
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\Program\Sub Programs
DEF p01drop_1711( )
;FOLD INI
  ;FOLD BASISTECH INI

    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
;ENDFOLD (INI)
;================================================
; MODEL    : XXXX
; IE GROUP : XX
; STATION  : XXX
; ROBOT    : RX
; FUNCTION : Drop Part in StXX
;================================================
$TIMER[7]=0
$TIMER_STOP[7]=FALSE

waitarea:
QR_NOK=FALSE

;Wait For Area / Goto Safety / Return To Home

;FOLD PTP P13 Vel=100 % PDAT28 Tool[1] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P13, 3:, 5:100, 7:PDAT28
$BWDSTART=FALSE
PDAT_ACT=PPDAT28
FDAT_ACT=FP13
BAS(#PTP_PARAMS,100)
PTP XP13 
;ENDFOLD
;IF FALSE THEN


WAIT FOR ($IN[54]==TRUE) OR ($IN[1]==TRUE)

IF $in[54]==TRUE THEN 
   bomberos_2 ( )               ; PICK In Station XX
   ENDIF


;Para de contar TC hasta que recibe typinfo para dejar (paleta indexada, tipo...)
$TIMER_STOP[7]=TRUE

;FOLD TYPE INFO
   
WAIT FOR ($IN[54]==TRUE) OR ($IN[1]==TRUE)
IF $in[54]==TRUE THEN 
   bomberos_2 ( )               ; PICK In Station XX
   ENDIF
O_TYPE_REQ=FALSE
WAIT FOR I_TYPE_INFO==0
O_TYPE_REQ=TRUE
WAIT FOR ((I_TYPE_INFO>100) AND (I_TYPE_INFO<201) or ($IN[54]==TRUE))
IF $in[54]==TRUE THEN 
   bomberos_2 ( )               ; PICK In Station XX
   ENDIF
O_TYPE_INFO=I_TYPE_INFO
;ENDFOLD
;ENDIF

$TIMER_STOP[7]=FALSE

SWITCH i_TYPE_INFO ;coldplate grande o peq


CASE 111
   INDICE_DROP=1 ;Variable calculo TC
   O_TYPE_REQ=FALSE   
   DropPOS1() ;POSICION 1 COLDPLATE GRANDE 

CASE 112
   INDICE_DROP=2  ;Variable calculo TC
   O_TYPE_REQ=FALSE
   DropPOS2() ;POSICION 2 COLDPLATE GRANDE
   
CASE 113
   INDICE_DROP=3
   O_TYPE_REQ=FALSE
   DropPOS3() ;POSICION 3 COLDPLATE GRANDE

CASE 121
   INDICE_DROP=4
   O_TYPE_REQ=FALSE
   DropPOS1();POSICION 1 COLDPLATE PEQUEÑO 

CASE 200
   INDICE_DROP=4
   O_TYPE_REQ=FALSE
   P01DROP2_2();POSICION 1 COLDPLATE PEQUEÑO 

CASE 155
   O_TYPE_REQ=FALSE
   bomberos_2() ;POSICION 1 COLDPLATE GRANDE 
DEFAULT
   
WAIT FOR FALSE   
   
ENDSWITCH

;fold QR NOK
IF (QR_NOK==TRUE) THEN

GOTO waitarea
ENDIF

;ENDFOLD


;FOLD PROVISIONAL PARA PRUEBAS
IF M2_TYPE_INFO<13 THEN  
M2_TYPE_INFO=M2_TYPE_INFO+1    
ENDIF

;ENDFOLD

PEXIT:

;FOLD Guarda_TC Dejada

;Guarda TC dejada
$TIMER_STOP[7]=TRUE
TC_DROP[INDICE_DROP]=$TIMER[7]

IF (INDICE_DROP < 4) THEN ;CUANDO DEJA ARRAYS EN COLD PLATES GRANDES
   IF (INDICE_RACK == 1)THEN
      TC_CP_BIG[INDICE_DROP]=TC_DROP[INDICE_DROP]+TC_PICK_RACK1[INDICE_PICK]
   ELSE
      TC_CP_BIG[INDICE_DROP]=TC_DROP[INDICE_DROP]+TC_PICK_RACK2[INDICE_PICK]
   ENDIF
   IF (INDICE_DROP == 3) THEN ;Cuando rellena el tercer colplate acumula en array de CP big
      TC_ARRAY_CPB[INDICE_ARRAYS_CPB]=TC_CP_BIG[1]+TC_CP_BIG[2]+TC_CP_BIG[3]
      INDICE_ARRAYS_CPB=INDICE_ARRAYS_CPB+1
      IF (INDICE_ARRAYS_CPB > 18) THEN
         INDICE_ARRAYS_CPB=1
         ;Actualiza el tiempo de ciclo medio por bateria
         ;Toma el tiempo de ciclo medio por batería como la media de procesar 2 racks
         ;64 arrays y 4 cartones, eso vienen a ser unas 7 baterías y me sobra 1 array
         TC_MEDIO_CARTONES=((((TC_CARTON[1]+TC_CARTON[2]+TC_CARTON[3]+TC_CARTON[4])/1000)*63)/64)
         TC_MEDIO_BATERIA=((TC_ARRAY_CPB[1]+TC_ARRAY_CPB[2]+TC_ARRAY_CPB[3]+TC_ARRAY_CPB[4]+TC_ARRAY_CPB[5]+TC_ARRAY_CPB[6]+TC_ARRAY_CPB[7]+TC_ARRAY_CPB[8]+TC_ARRAY_CPB[9]+TC_ARRAY_CPB[10]+TC_ARRAY_CPB[11]+TC_ARRAY_CPB[12]+TC_ARRAY_CPB[13]+TC_ARRAY_CPB[14]+TC_ARRAY_CPB[15]+TC_ARRAY_CPB[16]+TC_ARRAY_CPB[17]+TC_ARRAY_CPB[18]+TC_CP_SMALL[1]+TC_CP_SMALL[2]+TC_CP_SMALL[3]+TC_CP_SMALL[4]+TC_CP_SMALL[5]+TC_CP_SMALL[6]+TC_CP_SMALL[7]+TC_CP_SMALL[8]+TC_CP_SMALL[9])/1000)
         TC_MEDIO_BATERIA=((TC_MEDIO_BATERIA+TC_MEDIO_CARTONES)/9)
      ENDIF
   ENDIF
      ENDIF
         
IF (INDICE_DROP == 4) THEN ;CUANDO DEJA ARRAYS EN COLD PLATE PEQUEÑOS
   IF (INDICE_RACK == 1)THEN
      TC_CP_SMALL[INDICE_ARRAYS_CPS]=TC_DROP[4]+TC_PICK_RACK1[INDICE_PICK]
   ELSE
      TC_CP_SMALL[INDICE_ARRAYS_CPS]=TC_DROP[4]+TC_PICK_RACK2[INDICE_PICK]
   ENDIF   
   INDICE_ARRAYS_CPS=INDICE_ARRAYS_CPS+1 
   IF (INDICE_ARRAYS_CPS > 9) THEN
      INDICE_ARRAYS_CPS=1
   ENDIF
ENDIF

;ENDFOLD

END
DEF       DropPOS1()


;FOLD PTP BATPOS14 Vel=100 % PDAT9 Tool[8]:Gripper_array Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:BATPOS14, 3:, 5:100, 7:PDAT9
$BWDSTART=FALSE
PDAT_ACT=PPDAT9
FDAT_ACT=FBATPOS14
BAS(#PTP_PARAMS,100)
PTP XBATPOS14 
;ENDFOLD
;Wait For Area / Goto Safety / Return To Home

;FOLD Fordtech.Area_Req Area Request: 3, Safety Position: 0, Return To Home: 0 ;%{PE}
Area_Req (3,0,0)
IF I_RETHP AND (0 <> 0) AND ($IN_HOME == TRUE) THEN
  GOTO PEXIT
ENDIF
;ENDFOLD


;FOLD PTP preDROPpoint_1_1 CONT Vel=100 % PDAT9 Tool[8]:Gripper_array Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:preDROPpoint_1_1, 3:C_DIS, 5:100, 7:PDAT9
$BWDSTART=FALSE
PDAT_ACT=PPDAT9
FDAT_ACT=FpreDROPpoint_1_1
BAS(#PTP_PARAMS,100)
PTP XpreDROPpoint_1_1 C_DIS
;ENDFOLD

;Pto antes de tocar TIM inclina vert
;FOLD LIN P11 Vel=2 m/s CPDAT9 Tool[8]:Gripper_array Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P11, 3:, 5:2, 7:CPDAT9
$BWDSTART=FALSE
LDAT_ACT=LCPDAT9
FDAT_ACT=FP11
BAS(#CP_PARAMS,2)
LIN XP11 
;ENDFOLD
;FOLD WAIT Time=0.3 sec;%{PE}%R 8.3.48,%MKUKATPBASIS,%CWAIT,%VWAIT,%P 3:0.3
WAIT SEC 0.3
;ENDFOLD

;FOLD LIN DROPpoint_1_1 Vel=0.0025 m/s L2 Tool[8]:Gripper_array Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:DROPpoint_1_1, 3:, 5:0.0025, 7:L2
$BWDSTART=FALSE
LDAT_ACT=LL2
FDAT_ACT=FDROPpoint_1_1
BAS(#CP_PARAMS,0.0025)
LIN XDROPpoint_1_1 
;ENDFOLD

;abrir gara
cil_bat_reposo()

;FOLD PTP preDROPpoint_1_1 CONT Vel=100 % PDAT20 Tool[8]:Gripper_array Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:preDROPpoint_1_1, 3:C_DIS, 5:100, 7:PDAT20
$BWDSTART=FALSE
PDAT_ACT=PPDAT20
FDAT_ACT=FpreDROPpoint_1_1
BAS(#PTP_PARAMS,100)
PTP XpreDROPpoint_1_1 C_DIS
;ENDFOLD
;FOLD SYN OUT 43 'Job Ready 3' State=TRUE at START Delay=0 ms;%{PE}%R 8.3.48,%MKUKATPBASIS,%COUT,%VSYNOUT,%P 2:43, 3:Job Ready 3, 5:TRUE, 7:0, 9:0, 12:0
TRIGGER WHEN DISTANCE=0 DELAY=0 DO $OUT[43]=TRUE
;ENDFOLD


;FOLD PTP P3 CONT Vel=100 % PDAT9 Tool[5] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P3, 3:C_DIS, 5:100, 7:PDAT9
$BWDSTART=FALSE
PDAT_ACT=PPDAT9
FDAT_ACT=FP3
BAS(#PTP_PARAMS,100)
PTP XP3 C_DIS
;ENDFOLD

;Release Area 1
;FOLD SYN OUT 19 'Area Release 3' State=TRUE at START Delay=0 ms;%{PE}%R 8.3.48,%MKUKATPBASIS,%COUT,%VSYNOUT,%P 2:19, 3:Area Release 3, 5:TRUE, 7:0, 9:0, 12:0
TRIGGER WHEN DISTANCE=0 DELAY=0 DO $OUT[19]=TRUE
;ENDFOLD


;FOLD PTP P4 CONT Vel=100 % PDAT9 Tool[5] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P4, 3:C_DIS, 5:100, 7:PDAT9
$BWDSTART=FALSE
PDAT_ACT=PPDAT9
FDAT_ACT=FP4
BAS(#PTP_PARAMS,100)
PTP XP4 C_DIS
;ENDFOLD

;FOLD PTP HOME Vel=100 % DEFAULT;%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HOME, 3:, 5:100, 7:DEFAULT
$BWDSTART=FALSE
PDAT_ACT=PDEFAULT
FDAT_ACT=FHOME
BAS(#PTP_PARAMS,100)
$H_POS=XHOME
PTP XHOME 
;ENDFOLD
;Jump Adress
PEXIT:



END


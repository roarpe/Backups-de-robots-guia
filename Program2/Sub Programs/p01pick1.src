&ACCESS RVO1
&REL 85
&COMMENT Pick Part
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\Program\Sub Programs
DEF P01pick1( )
;FOLD INI
  ;FOLD BASISTECH INI
BACKJUMP=FALSE
CARTJUMP=FALSE
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
;ENDFOLD (INI)
;================================================
; MODEL    : XXXX
; IE GROUP : XX
; STATION  : XXX
; ROBOT    : RX
; FUNCTION : pick Part in StXX 
;================================================

;wait point

ACT_OV=$OV_PRO
;FOLD PTP P01waitdrop Vel=100 % PDAT1 Tool[5] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P01waitdrop, 3:, 5:100, 7:PDAT1
$BWDSTART=FALSE
PDAT_ACT=PPDAT1
FDAT_ACT=FP01waitdrop
BAS(#PTP_PARAMS,100)
PTP XP01waitdrop 
;ENDFOLD


WAIT FOR ($IN[54]==TRUE) OR ($IN[1]==TRUE)

IF $in[54]==TRUE THEN 
   bombero ( )               ; PICK In Station XX
   ENDIF
;IF FALSE THEN
;FOLD TYPE INFO
   
IF (I_TYPE_INFO<100)THEN
POSBAT=I_TYPE_INFO
PISO=0
ENDIF
IF (I_TYPE_INFO>100) AND (I_TYPE_INFO<200)THEN
POSBAT=I_TYPE_INFO-100
PISO=1
ENDIF
IF (I_TYPE_INFO>200) AND (I_TYPE_INFO<300)THEN
POSBAT=I_TYPE_INFO-200
PISO=2
ENDIF

;Guarda dato para Tciclo
ALT_TC=PISO

O_TYPE_REQ=FALSE

;ENDFOLD

;Para timer durante area req
$TIMER_STOP[7]=TRUE

;Wait For Area / Goto Safety / Return To Home
;FOLD Fordtech.Area_Req Area Request: 1, Safety Position: 0, Return To Home: 0;%{PE}%MKUKATPUSER

Area_Req (1,0,0)
IF I_RETHP AND (0 <> 0) AND ($IN_HOME == TRUE) THEN
  GOTO PEXIT
ENDIF

;ENDFOLD

;ENDIF
;cils_init()

;Arranca timer despues de area req
$TIMER_STOP[7]=FALSE


;FOLD ALTUA BASE
level1=PISO   
BASE_DATA[11]=BASE_DATA[13]
BASE_DATA[11].Z=BASE_DATA[11].Z+(ALTURA1*LEVEL1)

;ENDFOLD

;Guarda pos bateria para Tciclo
POS_BAT_TC=POSBAT

SWITCH POSBAT ;posicion bateria

CASE 1
   
;POS FOTO BATERIA 1   
;FOLD PTP BATPOS1 Vel=100 % M Tool[5]:Gripper_empty Base[11];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:BATPOS1, 3:, 5:100, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=FBATPOS1
BAS(#PTP_PARAMS,100)
PTP XBATPOS1 
;ENDFOLD
WAIT SEC 0.3
   
CASE 2

;POS FOTO BATERIA 2   
;FOLD PTP BATPOS2 Vel=100 % M Tool[5]:Gripper_empty Base[11];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:BATPOS2, 3:, 5:100, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=FBATPOS2
BAS(#PTP_PARAMS,100)
PTP XBATPOS2 
;ENDFOLD
WAIT SEC 0.3

CASE 3

;POS FOTO BATERIA 3
;FOLD PTP BATPOS3 Vel=100 % M Tool[5]:Gripper_empty Base[11];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:BATPOS3, 3:, 5:100, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=FBATPOS3
BAS(#PTP_PARAMS,100)
PTP XBATPOS3 
;ENDFOLD
WAIT SEC 0.3
 
CASE 4

;POS FOTO BATERIA 4
;FOLD PTP BATPOS4 Vel=100 % M Tool[5]:Gripper_empty Base[11];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:BATPOS4, 3:, 5:100, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=FBATPOS4
BAS(#PTP_PARAMS,100)
PTP XBATPOS4 
;ENDFOLD
WAIT SEC 0.3

CASE 5

;POS FOTO BATERIA 5
;FOLD PTP BATPOS5 Vel=100 % M Tool[5]:Gripper_empty Base[11];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:BATPOS5, 3:, 5:100, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=FBATPOS5
BAS(#PTP_PARAMS,100)
PTP XBATPOS5 
;ENDFOLD
WAIT SEC 0.3

CASE 6

;POS FOTO BATERIA 6
;FOLD PTP BATPOS6 Vel=100 % M Tool[5]:Gripper_empty Base[11];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:BATPOS6, 3:, 5:100, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=FBATPOS6
BAS(#PTP_PARAMS,100)
PTP XBATPOS6 
;ENDFOLD
WAIT SEC 0.3
   
CASE 7

;POS FOTO BATERIA 7
;FOLD PTP BATPOS7 Vel=100 % M Tool[5]:Gripper_empty Base[11];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:BATPOS7, 3:, 5:100, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=FBATPOS7
BAS(#PTP_PARAMS,100)
PTP XBATPOS7 
;ENDFOLD
WAIT SEC 0.3

CASE 8

;POS FOTO BATERIA 8
;FOLD PTP BATPOS8 Vel=100 % M Tool[5]:Gripper_empty Base[11];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:BATPOS8, 3:, 5:100, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=FBATPOS8
BAS(#PTP_PARAMS,100)
PTP XBATPOS8 
;ENDFOLD
WAIT SEC 0.3
   
CASE 9

;POS FOTO BATERIA 9
;FOLD PTP BATPOS9 Vel=100 % M Tool[5]:Gripper_empty Base[11];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:BATPOS9, 3:, 5:100, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=FBATPOS9
BAS(#PTP_PARAMS,100)
PTP XBATPOS9 
;ENDFOLD
WAIT SEC 0.3

CASE 10

;POS FOTO BATERIA 10
;FOLD PTP BATPOS10 Vel=100 % M Tool[5]:Gripper_empty Base[11];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:BATPOS10, 3:, 5:100, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=FBATPOS10
BAS(#PTP_PARAMS,100)
PTP XBATPOS10 
;ENDFOLD
WAIT SEC 0.3

CASE 11

;POS FOTO BATERIA 11
;FOLD PTP BATPOS11 Vel=100 % M Tool[5]:Gripper_empty Base[11];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:BATPOS11, 3:, 5:100, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=FBATPOS11
BAS(#PTP_PARAMS,100)
PTP XBATPOS11 
;ENDFOLD
WAIT SEC 0.3
;ACT_OV=$OV_PRO
;$OV_PRO=10
CASE 12

;POS FOTO BATERIA 12
;FOLD PTP BATPOS12 Vel=100 % M Tool[5]:Gripper_empty Base[11];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:BATPOS12, 3:, 5:100, 7:M
$BWDSTART=FALSE
PDAT_ACT=PM
FDAT_ACT=FBATPOS12
BAS(#PTP_PARAMS,100)
PTP XBATPOS12 
;ENDFOLD
WAIT SEC 0.3
;ACT_OV=$OV_PRO
;$OV_PRO=10
CASE 13

;CARTON   
P01pick1_2corr()   
P01drop2()

CARTJUMP=TRUE
GOTO PEXIT

DEFAULT
;ESTO NO DEBERIA HABER OCURRIDO, KEEP CALM   
WAIT FOR FALSE
   
ENDSWITCH

$ACT_BASE=0
$ACT_TOOL=0

panpick()

$OV_PRO=ACT_OV
;fold provisional para pruebas
M_TYPE_INFO=M_TYPE_INFO+1
;endfold



;Release Area 1

;FOLD SYN OUT 17 'Area Release 1' State=TRUE at START Delay=0 ms;%{PE}%R 8.3.48,%MKUKATPBASIS,%COUT,%VSYNOUT,%P 2:17, 3:Area Release 1, 5:TRUE, 7:0, 9:0, 12:0
TRIGGER WHEN DISTANCE=0 DELAY=0 DO $OUT[17]=TRUE
;ENDFOLD
;Jump Adress
PEXIT:

;Guarda TC por cada array cogido y carton para rack1
;FOLD Guarda_TC 
;ALT_TC es 1, 2, o 3
;POS_BAT_TC va de 1 a 12 y 13 para carton
$TIMER_STOP[7]=TRUE
IF POS_BAT_TC < 13 THEN
   INDICE_PICK=POS_BAT_TC+(12*ALT_TC)
   TC_PICK_RACK1[INDICE_PICK]=$TIMER[7]
ENDIF

IF (POS_BAT_TC==13) THEN
   IF (ALT_TC==2) THEN
      TC_CARTON[1]=$TIMER[7]
   ENDIF
   IF (ALT_TC==1) THEN
      TC_CARTON[2]=$TIMER[7]
   ENDIF
ENDIF
   
;ENDFOLD

END
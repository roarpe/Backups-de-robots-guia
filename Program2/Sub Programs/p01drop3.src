&ACCESS RVP1
&REL 48
&COMMENT drop carton
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\Program\Sub Programs
DEF P01drop3( )
;FOLD INI
  ;FOLD BASISTECH INI

    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
;ENDFOLD (INI)
;================================================
; MODEL    : XXXX
; IE GROUP : XX
; STATION  : XXX
; ROBOT    : RX
; FUNCTION : pick Part in StXX
;================================================

;wait point

;FOLD PTP P3 CONT Vel=100 % PDAT8 Tool[5] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P3, 3:C_DIS, 5:100, 7:PDAT8
$BWDSTART=FALSE
PDAT_ACT=PPDAT8
FDAT_ACT=FP3
BAS(#PTP_PARAMS,100)
PTP XP3 C_DIS
;ENDFOLD

SWITCH POS_CARTON

CASE 11
RACK31()

CASE 12
RACK32()

CASE 13
RACK33()

CASE 14
RACK34()

CASE 21
RACK41()

CASE 22
RACK42()

CASE 23
RACK43()

CASE 24
RACK44()

ENDSWITCH

;FOLD OUT 241 'CIL ventosas carton BWD' State=TRUE ;%{PE}%R 8.3.48,%MKUKATPBASIS,%COUT,%VOUTX,%P 2:241, 3:CIL ventosas carton BWD, 5:TRUE, 6:
$OUT[241]=TRUE
;ENDFOLD
;FOLD OUT 242 'CIL ventosas carton FWD' State=FALSE ;%{PE}%R 8.3.48,%MKUKATPBASIS,%COUT,%VOUTX,%P 2:242, 3:CIL ventosas carton FWD, 5:FALSE, 6:
$OUT[242]=FALSE
;ENDFOLD
END

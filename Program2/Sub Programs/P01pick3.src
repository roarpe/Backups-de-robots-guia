&ACCESS RVO1
&REL 28
&COMMENT drop carton
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\Program\Sub Programs
DEF P01pick3( )
;FOLD INI
  ;FOLD BASISTECH INI

    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
;ENDFOLD (INI)
;================================================
; MODEL    : XXXX
; IE GROUP : XX
; STATION  : XXX
; ROBOT    : RX
; FUNCTION : pick Part in StXX
;================================================

;wait point

;FOLD PTP P3 CONT Vel=100 % PDAT8 Tool[5] Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P3, 3:C_DIS, 5:100, 7:PDAT8
$BWDSTART=FALSE
PDAT_ACT=PPDAT8
FDAT_ACT=FP3
BAS(#PTP_PARAMS,100)
PTP XP3 C_DIS
;ENDFOLD

;FOLD SYN OUT 241 'CIL ventosas carton BWD' State=FALSE at START Delay=0 ms;%{PE}%R 8.3.48,%MKUKATPBASIS,%COUT,%VSYNOUT,%P 2:241, 3:CIL ventosas carton BWD, 5:FALSE, 7:0, 9:0, 12:0
TRIGGER WHEN DISTANCE=0 DELAY=0 DO $OUT[241]=FALSE
;ENDFOLD
;FOLD SYN OUT 242 'CIL ventosas carton FWD' State=TRUE at START Delay=0 ms;%{PE}%R 8.3.48,%MKUKATPBASIS,%COUT,%VSYNOUT,%P 2:242, 3:CIL ventosas carton FWD, 5:TRUE, 7:0, 9:0, 12:0
TRIGGER WHEN DISTANCE=0 DELAY=0 DO $OUT[242]=TRUE
;ENDFOLD

POS_CARTON=I_TYPE_INFO
O_TYPE_REQ=FALSE
SWITCH POS_CARTON

CASE 1
CARTPOS1()

CASE 2
CARTPOS2()

CASE 3
CARTPOS3()

CASE 4
CARTPOS4()

ENDSWITCH

;FOLD Fordtech.Area_Rel Area Release: 5 ;%{PE}%MKUKATPUSER

Area_Rel (5)

;ENDFOLD
END

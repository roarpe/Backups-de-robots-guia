&ACCESS RVO
&REL 50
&COMMENT Return to Home
DEF RETURN_HOME (AREA_NR :IN,RETHME :IN )
;FOLD INI
  INT AREA_NR
  INT RETHME
  decl KrlMsg_T msg
  decl KrlMsgPar_T par[3]
  decl KrlMsgOpt_T opt
  INT nHandle
  
  IF RETHME==0 THEN
    REPEAT
    	  msg = {modul[] "Return_Home", nr 1, msg_txt[] "Return to Home path not configured !!"}

  			opt = {vl_stop true, clear_p_reset true, clear_p_SAW false, log_to_DB false}
  
  			nHandle = Set_KrlMsg(#notify, msg, par[], opt)
      HALT
    UNTIL (RETHME<9) AND (RETHME>0)
  ENDIF
  
  IF (RETHME>8) OR (RETHME<1) THEN
	    REPEAT
	    	  msg = {modul[] "Return_Home", nr 4, msg_txt[] "Return To Home Number Not Valid !!!!"}
	  
	  			opt = {vl_stop true, clear_p_reset true, clear_p_SAW false, log_to_DB false}
	  
	  			nHandle = Set_KrlMsg(#notify, msg, par[], opt)
	      HALT
	    UNTIL (RETHME<9) AND (RETHME>0)
  ENDIF  
  
  IF (AREA_NR>8) OR (AREA_NR<1) THEN
    REPEAT
    	  msg = {modul[] "Return_Home", nr 2, msg_txt[] "Area Number Not Valid !!!!"}
  
  			opt = {vl_stop true, clear_p_reset true, clear_p_SAW false, log_to_DB false}
  
  			nHandle = Set_KrlMsg(#notify, msg, par[], opt)
      HALT
    UNTIL (AREA_NR<9) AND (AREA_NR>0)
  ENDIF
  ;ENDFOLD
